{{ 'landing-cta.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign quote_href = section.settings.quote_anchor | default: '#'
  assign phone_display = section.settings.phone_label
  assign phone_tel = phone_display | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
  assign alignment = section.settings.alignment | default: 'center'
-%}

<section
  id="landing-cta-{{ section.id }}"
  class="landing-cta landing-cta--align-{{ alignment }}"
  style="
    --lcta-bg: {{ section.settings.background }};
    --lcta-fg: {{ section.settings.text_color }};
    --lcta-pad-top: {{ section.settings.padding_top }}px;
    --lcta-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="landing-cta__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="landing-cta__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="landing-cta__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="landing-cta__actions">
      <a
        class="button hover-grow landing-cta__btn"
        href="{{ quote_href }}"
        {%- if section.settings.data_cta != blank %} data-cta="{{ section.settings.data_cta | escape }}"{% endif -%}
      >
        {{ section.settings.quote_label | escape }}
      </a>

      {%- if phone_display != blank -%}
        <a
          class="button alt hover-grow landing-cta__btn landing-cta__btn--phone"
          href="tel:{{ phone_tel }}"
          aria-label="Call {{ phone_display }}"
          data-cta="phone_call"
          data-contact-method="phone"
        >
          <svg class="landing-cta__phone-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <span>{{ phone_display | escape }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('landing-cta-{{ section.id }}');
    if (!section) return;
    var btn = section.querySelector('.landing-cta__btn:not(.landing-cta__btn--phone)');
    if (!btn) return;

    function smallestContainerWithPrecedingHeading(formEl) {
      // Walk up from the form. The first ancestor that has a heading (h1-h6)
      // appearing BEFORE the form in DOM order is the block that contains the
      // form's intro copy. Scrolling to its top keeps that intro on-screen.
      var cur = formEl;
      while (cur && cur.parentElement) {
        cur = cur.parentElement;
        if (cur.tagName === 'BODY' || cur.tagName === 'HTML') break;
        var headings = cur.querySelectorAll('h1, h2, h3, h4, h5, h6');
        for (var i = 0; i < headings.length; i++) {
          var pos = headings[i].compareDocumentPosition(formEl);
          if (pos & Node.DOCUMENT_POSITION_FOLLOWING) return cur;
        }
      }
      return formEl;
    }

    btn.addEventListener('click', function (e) {
      var href = btn.getAttribute('href') || '';
      var target = null;

      if (href.length > 1 && href.charAt(0) === '#') {
        try { target = document.querySelector(href); } catch (err) {}
      }

      if (!target) {
        // Find the first form-like element that comes after this section.
        // Try real <form> elements first, then common form-app containers.
        var candidates = document.querySelectorAll(
          'form, [class*="form-builder"], [class*="formbuilder"], [data-form-id], [id^="form-"]'
        );
        for (var i = 0; i < candidates.length; i++) {
          var pos = section.compareDocumentPosition(candidates[i]);
          if (pos & Node.DOCUMENT_POSITION_FOLLOWING) { target = candidates[i]; break; }
        }
        if (target) target = smallestContainerWithPrecedingHeading(target);
      }

      if (!target) return; // No target found — let the link behave normally.

      e.preventDefault();
      var headerOffset = {{ section.settings.scroll_offset | default: 100 }};
      // scroll-margin-top lets the browser handle the offset natively, and
      // scrollIntoView re-measures during the animation — robust against
      // layout shifts caused by app blocks rendering asynchronously.
      target.style.scrollMarginTop = headerOffset + 'px';
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });

      // Re-snap once after a beat in case the app finishes rendering more
      // content (captcha, validation panel, etc.) and pushes layout down.
      setTimeout(function () {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 600);
    });
  })();
</script>

{% schema %}
{
  "name": "Landing CTAs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "Button label",
      "default": "REQUEST A QUOTE TODAY"
    },
    {
      "type": "text",
      "id": "quote_anchor",
      "label": "Link / anchor",
      "info": "Leave as # for now. Later, change to #contact-form (or whatever id the contact section gets) so the button scrolls down.",
      "default": "#"
    },
    {
      "type": "text",
      "id": "data_cta",
      "label": "Tracking ID (data-cta)",
      "info": "GTM uses this to identify the click event. Examples: speak_with_specialists, get_in_touch, request_a_quote. Leave blank to skip the attribute.",
      "default": "speak_with_specialists"
    },
    {
      "type": "header",
      "content": "Phone CTA"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone number (displayed)",
      "default": "+351 228 338 640"
    },
    {
      "type": "header",
      "content": "Colors & spacing"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Landing CTAs"
    }
  ]
}
{% endschema %}
