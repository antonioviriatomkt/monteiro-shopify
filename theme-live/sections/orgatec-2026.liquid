{%- capture chance_mosaic -%}
  {%- assign mosaic = '#c8b8a6,#e8d9c4,#f2e6d2,#d9c6a8,#c9a86a,#e0b64a,#f0c94b,#f5d76e,#e7a53a,#d97b2c,#c9542b,#b8332b,#8f2a2a,#6e1f2c,#a44a5c,#d98aa0,#e9b4c1,#b57fa6,#7a4f8c,#4c3a7a,#2e3f7a,#2f519b,#3f6fb0,#5c8fc4,#8bb6d8,#b9d3e6,#6fa9a3,#3d8a86,#2f6f6b,#255b52,#3f7a4a,#6c9a52,#9bb85f,#c9d47c,#e2e6a3,#8a8a7a,#5e6062,#3b3d3f,#232526,#151617,#d5d0c8,#bdb6ac,#9d948a,#7d746b,#5f574f,#8c7358,#a98a6b,#c7a98a' | split: ',' -%}
  <div class="o26-mosaic" aria-hidden="true">
    {%- for c in mosaic -%}<i style="background:{{ c }}"></i>{%- endfor -%}
  </div>
{%- endcapture -%}

<style>
  .o26 { --sand:#CFBFAE; --sand-ink:#2E2620; --mist:#B4C2C2; --mist-ink:#1F2A2A; --sage:#7E8B71; --taupe:#877A6D; --ink:#161616; --paper:#FFFFFF; --line:rgba(0,0,0,.12); --track:.12em; color:var(--ink); font-family:inherit; }
  .o26 *, .o26 *::before, .o26 *::after { box-sizing:border-box; }
  .o26 a { color:inherit; }
  .o26 .o26-wrap { max-width:1180px; margin:0 auto; padding:0 24px; }
  .o26 .o26-eyebrow { display:block; font-size:12px; letter-spacing:.2em; text-transform:uppercase; opacity:.7; margin:0 0 14px; }
  .o26 .o26-display { font-weight:300; text-transform:uppercase; letter-spacing:var(--track); line-height:1.05; margin:0; text-align:left; color:inherit; }
  .o26 .o26-eyebrow, .o26 p, .o26 dl, .o26 ul { text-align:left; }
  .o26 h1.o26-display { font-size:clamp(30px,4.6vw,58px); }
  .o26 h2.o26-display { font-size:clamp(26px,3.4vw,42px); }
  .o26 h3.o26-display { font-size:clamp(22px,2.6vw,32px); }
  .o26 .o26-lead { font-size:clamp(16px,1.5vw,19px); line-height:1.55; max-width:62ch; margin:20px 0 0; }
  .o26 .o26-btn { display:inline-flex; align-items:center; justify-content:center; gap:10px; padding:16px 26px; border:1px solid var(--ink); background:var(--ink); color:#fff; text-decoration:none; font-size:14px; letter-spacing:.08em; text-transform:uppercase; line-height:1.2; transition:transform .25s, background .25s, color .25s; cursor:pointer; -webkit-appearance:none; border-radius:0; font-family:inherit; }
  .o26 .o26-btn:hover { transform:translateY(-2px); }
  .o26 .o26-btn--ghost { background:transparent; color:var(--ink); }
  .o26 .o26-btn--light { background:#fff; color:var(--ink); border-color:#fff; }
  .o26 .o26-btn--ghost-light { background:transparent; color:#fff; border-color:rgba(255,255,255,.7); }
  .o26 .o26-btn small { display:block; font-size:11px; letter-spacing:.06em; text-transform:none; opacity:.75; }
  .o26 .o26-actions { display:flex; flex-wrap:wrap; gap:14px; margin-top:32px; }

  /* Event bar */
  .o26-bar { background:var(--ink); color:#fff; font-size:13px; letter-spacing:.06em; }
  .o26-bar .o26-wrap { display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:10px 28px; min-height:48px; padding-top:10px; padding-bottom:10px; }
  .o26-bar strong { font-weight:600; letter-spacing:.1em; text-transform:uppercase; }
  .o26-bar span + span::before { content:""; display:inline-block; width:1px; height:12px; background:rgba(255,255,255,.35); margin-right:28px; vertical-align:-1px; }
  @media (max-width:640px){ .o26-bar span + span::before { display:none; } .o26-bar .o26-wrap { gap:4px 16px; font-size:12px; } }

  /* Hero */
  .o26-hero { background:var(--sand); color:var(--sand-ink); overflow:hidden; }
  .o26-hero .o26-wrap { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr); gap:48px; align-items:center; min-height:560px; padding-top:72px; padding-bottom:72px; }
  .o26-hero .o26-btn { background:var(--sand-ink); border-color:var(--sand-ink); }
  .o26-hero .o26-btn--ghost { background:transparent; color:var(--sand-ink); }
  .o26-hero__media { position:relative; min-height:360px; }
  .o26-hero__media img { width:100%; height:100%; object-fit:cover; display:block; min-height:360px; }
  .o26-hero__stand { position:absolute; left:0; bottom:0; background:rgba(255,255,255,.92); color:var(--sand-ink); padding:16px 22px; font-size:13px; letter-spacing:.14em; text-transform:uppercase; }
  .o26-hero__stand b { display:block; font-size:22px; font-weight:300; letter-spacing:.1em; margin-top:2px; }
  .o26-mosaic { display:grid; grid-template-columns:repeat(8,1fr); gap:4px; width:100%; aspect-ratio:8/6; }
  .o26-mosaic i { display:block; aspect-ratio:1; }
  @media (max-width:860px){ .o26-hero .o26-wrap { grid-template-columns:1fr; min-height:0; padding-top:48px; padding-bottom:48px; } .o26-hero__media { min-height:0; } .o26-hero__media img { min-height:240px; max-height:360px; } }

  /* Facts */
  .o26-facts { border-bottom:1px solid var(--line); }
  .o26-facts .o26-wrap { display:grid; grid-template-columns:repeat(4,1fr); }
  .o26-facts div { padding:26px 20px 26px 0; }
  .o26-facts div + div { border-left:1px solid var(--line); padding-left:20px; }
  .o26-facts b { display:block; font-weight:400; font-size:20px; letter-spacing:.04em; }
  .o26-facts span { display:block; font-size:13px; opacity:.7; margin-top:4px; }
  @media (max-width:760px){ .o26-facts .o26-wrap { grid-template-columns:1fr 1fr; } .o26-facts div:nth-child(3) { border-left:0; padding-left:0; } .o26-facts div:nth-child(n+3) { border-top:1px solid var(--line); } }

  /* Collections */
  .o26-bring { padding:80px 0 40px; }
  .o26-bring .o26-lead { margin-top:16px; }
  .o26-grid { display:grid; grid-template-columns:repeat(12,1fr); gap:16px; margin-top:40px; }
  .o26-card { position:relative; display:flex; flex-direction:column; padding:30px; min-height:420px; color:#fff; overflow:hidden; }
  .o26-card--sand { background:var(--sand); color:var(--sand-ink); }
  .o26-card--mist { background:var(--mist); color:var(--mist-ink); }
  .o26-card--sage { background:var(--sage); }
  .o26-card--taupe { background:var(--taupe); }
  .o26-card--12 { grid-column:span 12; }
  .o26-card--6 { grid-column:span 6; }
  .o26-card--4 { grid-column:span 4; }
  .o26-card__sector { align-self:flex-start; font-size:11px; letter-spacing:.18em; text-transform:uppercase; padding:8px 12px; border:1px solid currentColor; opacity:.85; margin-bottom:22px; }
  .o26-card__tag { font-size:13px; letter-spacing:.14em; text-transform:uppercase; opacity:.8; margin:0 0 10px; }
  .o26-card__desc { margin:14px 0 0; max-width:48ch; line-height:1.5; font-size:15px; }
  .o26-card__chips { display:flex; flex-wrap:wrap; gap:6px; margin:18px 0 0; padding:0; list-style:none; }
  .o26-card__chips li { font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; padding:7px 9px; border:1px solid currentColor; opacity:.85; }
  .o26-card__links { margin-top:auto; padding-top:26px; display:flex; flex-wrap:wrap; gap:8px 22px; font-size:13px; letter-spacing:.08em; text-transform:uppercase; }
  .o26-card__links a { text-decoration:none; border-bottom:1px solid currentColor; padding-bottom:2px; }
  .o26-card__links a:hover { opacity:.7; }
  .o26-card__swatch { position:absolute; right:0; top:0; width:38%; max-width:260px; aspect-ratio:1; overflow:hidden; }
  .o26-card__swatch img { width:100%; height:100%; object-fit:cover; display:block; }
  .o26-card--has-swatch .o26-card__sector, .o26-card--has-swatch .o26-card__tag, .o26-card--has-swatch h3, .o26-card--has-swatch .o26-card__desc { max-width:60%; }
  .o26-card__swatches { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin:22px 0 0; }
  .o26-card__swatches a { display:block; position:relative; aspect-ratio:1; overflow:hidden; text-decoration:none; }
  .o26-card__swatches img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .4s; }
  .o26-card__swatches a:hover img { transform:scale(1.05); }
  .o26-card__swatches span { position:absolute; left:0; right:0; bottom:0; padding:6px 8px; font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; color:#fff; background:linear-gradient(transparent, rgba(0,0,0,.55)); }
  .o26-card__swatches--2x2 { grid-template-columns:1fr 1fr; margin:0; max-width:420px; margin-left:auto; align-self:center; width:100%; }
  .o26-chance { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr); gap:32px; }
  .o26-chance .o26-mosaic { max-width:420px; margin-left:auto; }
  .o26-chance__grades { display:flex; flex-wrap:wrap; gap:6px 18px; margin:22px 0 0; padding:0; list-style:none; font-size:13px; letter-spacing:.16em; text-transform:uppercase; }
  .o26-chance__grades li::before { content:"—"; opacity:.5; margin-right:8px; }
  @media (max-width:980px){ .o26-card--6, .o26-card--4 { grid-column:span 6; } .o26-chance { grid-template-columns:1fr; } .o26-chance .o26-mosaic { max-width:100%; } }
  @media (max-width:640px){ .o26-card--6, .o26-card--4 { grid-column:span 12; } .o26-card { min-height:0; padding:24px; } .o26-card--has-swatch .o26-card__sector, .o26-card--has-swatch .o26-card__tag, .o26-card--has-swatch h3, .o26-card--has-swatch .o26-card__desc { max-width:100%; } .o26-card__swatch { position:static; width:100%; max-width:100%; aspect-ratio:16/7; margin:-24px -24px 20px; width:calc(100% + 48px); } }

  /* Band */
  .o26-band { background:var(--ink); color:#fff; padding:72px 0; }
  .o26-band .o26-wrap { display:grid; grid-template-columns:minmax(0,1.3fr) auto; gap:32px; align-items:center; }
  .o26-band p { opacity:.75; max-width:56ch; margin:14px 0 0; line-height:1.55; }
  @media (max-width:860px){ .o26-band .o26-wrap { grid-template-columns:1fr; } }

  /* Meeting form */
  .o26-meeting { padding:88px 0; background:var(--paper); }
  .o26-meeting .o26-wrap { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:56px; align-items:start; }
  .o26-form { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .o26-form .o26-field--full { grid-column:span 2; }
  .o26-form label { display:block; font-size:11px; letter-spacing:.14em; text-transform:uppercase; margin-bottom:6px; opacity:.75; }
  .o26-form input, .o26-form select, .o26-form textarea { width:100%; border:1px solid var(--line); border-radius:0; background:#fff; padding:14px; font:inherit; font-size:15px; color:var(--ink); -webkit-appearance:none; }
  .o26-form input:focus, .o26-form select:focus, .o26-form textarea:focus { outline:none; border-color:var(--ink); }
  .o26-form textarea { min-height:110px; resize:vertical; }
  .o26-form .o26-field--error input { border-color:#B8332B; }
  .o26-form .o26-form__errors { grid-column:span 2; color:#B8332B; font-size:14px; }
  .o26-form .o26-form__foot { grid-column:span 2; display:flex; flex-wrap:wrap; align-items:center; gap:18px; margin-top:6px; }
  .o26-form .o26-form__foot small { font-size:12px; opacity:.6; }
  .o26-ok { border:1px solid var(--line); padding:32px; }
  .o26-ok p { margin:12px 0 0; line-height:1.55; }
  @media (max-width:860px){ .o26-meeting .o26-wrap { grid-template-columns:1fr; gap:32px; } .o26-meeting { padding:56px 0; } }
  @media (max-width:520px){ .o26-form { grid-template-columns:1fr; } .o26-form .o26-field--full, .o26-form .o26-form__errors, .o26-form .o26-form__foot { grid-column:span 1; } }

  /* Info */
  .o26-info { background:var(--mist); color:var(--mist-ink); padding:72px 0; }
  .o26-info dl { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin:32px 0 0; }
  .o26-info dt { font-size:11px; letter-spacing:.18em; text-transform:uppercase; opacity:.7; }
  .o26-info dd { margin:8px 0 0; font-size:17px; line-height:1.45; }
  .o26-info .o26-actions { margin-top:36px; }
  .o26-info .o26-btn { background:var(--mist-ink); border-color:var(--mist-ink); }
  .o26-info .o26-btn--ghost { background:transparent; color:var(--mist-ink); }
  @media (max-width:760px){ .o26-info dl { grid-template-columns:1fr; gap:18px; } }

  /* Post-fair */
  .o26-post { padding:80px 0; text-align:center; }
  .o26-post .o26-lead { margin-left:auto; margin-right:auto; }
  .o26-post .o26-actions { justify-content:center; }

  @media (prefers-reduced-motion: reduce){ .o26 .o26-btn, .o26 .o26-card__swatches img { transition:none; } }
</style>

<div class="o26" id="orgatec-2026">

  {%- comment -%} Event bar {%- endcomment -%}
  <div class="o26-bar">
    <div class="o26-wrap">
      <span><strong>ORGATEC 2026</strong></span>
      <span>{{ s_bar_dates }}</span>
      <span>{{ s_bar_venue }}</span>
      <span><strong>{{ s_hall }} · {{ stand }}</strong></span>
    </div>
  </div>

  {%- comment -%} Hero {%- endcomment -%}
  <section class="o26-hero">
    <div class="o26-wrap">
      <div>
        <span class="o26-eyebrow">{{ s_eyebrow }}</span>
        <h1 class="o26-display">{{ s_h1 }}</h1>
        <p class="o26-lead">{{ s_lead }}</p>
        <div class="o26-actions">
          <a class="o26-btn" href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="hero">{{ s_cta_samples }}</a>
          {%- if phase != 'post' and show_body -%}
            <a class="o26-btn o26-btn--ghost" href="#meeting" data-cta="orgatec_meeting_scroll" data-cta-slot="hero">{{ s_cta_meeting }}</a>
          {%- else -%}
            <a class="o26-btn o26-btn--ghost" href="{{ contact_url }}" data-cta="orgatec_contact" data-cta-slot="hero">{{ s_cta_contact }}</a>
          {%- endif -%}
        </div>
      </div>
      <div class="o26-hero__media">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600, 900, 1400', sizes: '(max-width: 860px) 100vw, 45vw', alt: section.settings.hero_image.alt | default: 'Monteiro Fabrics at ORGATEC 2026' }}
        {%- else -%}
          {{ chance_mosaic }}
        {%- endif -%}
        <div class="o26-hero__stand">{{ s_hall }}<b>{{ stand }}</b></div>
      </div>
    </div>
  </section>

  {%- if show_body -%}
  {%- comment -%} Facts {%- endcomment -%}
  <section class="o26-facts">
    <div class="o26-wrap">
      <div><b>{{ s_fact_1_k }}</b><span>{{ s_fact_1_v }}</span></div>
      <div><b>{{ s_fact_2_k }}</b><span>{{ s_fact_2_v }}</span></div>
      <div><b>{{ s_fact_3_k }}</b><span>{{ s_fact_3_v }}</span></div>
      <div><b>{{ s_fact_4_k }}</b><span>{{ s_fact_4_v }}</span></div>
    </div>
  </section>

  {%- comment -%} Collections {%- endcomment -%}
  <section class="o26-bring" id="collections">
