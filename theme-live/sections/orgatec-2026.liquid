  {%- comment -%} Samples band {%- endcomment -%}
  <section class="o26-band">
    <div class="o26-wrap">
      <div>
        {%- if phase == 'post' -%}
          <h2 class="o26-display">{{ s_post_h2 }}</h2>
          <p>{{ s_post_p }}</p>
        {%- else -%}
          <h2 class="o26-display">{{ s_band_h2 }}</h2>
          <p>{{ s_band_p }}</p>
        {%- endif -%}
      </div>
      <div>
        <a class="o26-btn o26-btn--light" href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="band">{{ s_cta_samples }}</a>
      </div>
    </div>
  </section>

  {%- comment -%} Meeting form (hidden after the fair) {%- endcomment -%}
  {%- if phase != 'post' -%}
  <section class="o26-meeting" id="meeting">
    <div class="o26-wrap">
      <div>
        <span class="o26-eyebrow">{{ s_meeting_eyebrow }}</span>
        <h2 class="o26-display">{{ s_meeting_h2 }}</h2>
        <p class="o26-lead">{{ s_meeting_p }}</p>
      </div>
      <div>
        {%- form 'contact', id: 'orgatec-meeting-form', class: 'o26-form', data-form: 'orgatec_meeting' -%}
          {%- if form.posted_successfully? -%}
            <div class="o26-ok o26-field--full" data-form-success="orgatec_meeting">
              <h3 class="o26-display">{{ s_f_ok_h }}</h3>
              <p>{{ s_f_ok_p }}</p>
              <div class="o26-actions"><a class="o26-btn" href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="form-success">{{ s_cta_samples }}</a></div>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="o26-form__errors" role="alert">{{ s_f_err }}
                <ul>{%- for field in form.errors -%}<li>{{ form.errors.translated_fields[field] | capitalize }} – {{ form.errors.messages[field] }}</li>{%- endfor -%}</ul>
              </div>
            {%- endif -%}
            <input type="hidden" name="contact[Request]" value="ORGATEC 2026 – stand meeting ({{ s_hall }}, {{ stand }})">
            <input type="hidden" name="contact[Page]" value="{{ request.path }}">
            <input type="hidden" name="contact[Locale]" value="{{ request.locale.iso_code }}">
            <input type="hidden" name="contact[utm_source]" value="" data-utm="utm_source">
            <input type="hidden" name="contact[utm_medium]" value="" data-utm="utm_medium">
            <input type="hidden" name="contact[utm_campaign]" value="" data-utm="utm_campaign">
            <input type="hidden" name="contact[utm_content]" value="" data-utm="utm_content">
            <input type="hidden" name="contact[utm_term]" value="" data-utm="utm_term">
            <input type="hidden" name="contact[gclid]" value="" data-utm="gclid">
            <div class="o26-field{% if form.errors contains 'name' %} o26-field--error{% endif %}">
              <label for="o26-name">{{ s_f_name }}</label>
              <input id="o26-name" type="text" name="contact[name]" required autocomplete="name" value="{{ form.name }}">
            </div>
            <div class="o26-field">
              <label for="o26-company">{{ s_f_company }}</label>
              <input id="o26-company" type="text" name="contact[Company]" required autocomplete="organization">
            </div>
            <div class="o26-field{% if form.errors contains 'email' %} o26-field--error{% endif %}">
              <label for="o26-email">{{ s_f_email }}</label>
              <input id="o26-email" type="email" name="contact[email]" required autocomplete="email" value="{{ form.email }}">
            </div>
            <div class="o26-field">
              <label for="o26-phone">{{ s_f_phone }}</label>
              <input id="o26-phone" type="tel" name="contact[Phone]" autocomplete="tel">
            </div>
            <div class="o26-field o26-field--full">
              <label for="o26-day">{{ s_f_day }}</label>
              <select id="o26-day" name="contact[Preferred day]">
                <option value="{{ s_f_day_any }}">{{ s_f_day_any }}</option>
                <option value="27.10.2026">{% if de %}Dienstag, 27. Oktober{% else %}Tuesday, 27 October{% endif %}</option>
                <option value="28.10.2026">{% if de %}Mittwoch, 28. Oktober{% else %}Wednesday, 28 October{% endif %}</option>
                <option value="29.10.2026">{% if de %}Donnerstag, 29. Oktober{% else %}Thursday, 29 October{% endif %}</option>
                <option value="30.10.2026">{% if de %}Freitag, 30. Oktober{% else %}Friday, 30 October{% endif %}</option>
              </select>
            </div>
            <div class="o26-field o26-field--full">
              <label for="o26-msg">{{ s_f_msg }}</label>
              <textarea id="o26-msg" name="contact[body]">{{ form.body }}</textarea>
            </div>
            <div class="o26-form__foot">
              <button type="submit" class="o26-btn" data-cta="orgatec_meeting_submit">{{ s_f_send }}</button>
