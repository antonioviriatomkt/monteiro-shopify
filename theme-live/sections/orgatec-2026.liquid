          <div class="o26-chance">
            <div>
              <p class="o26-card__tag">{{ s_chance_tag }}</p>
              <h3 class="o26-display">Chance 2.0</h3>
              <p class="o26-card__desc">{{ s_chance_desc }}</p>
              <ul class="o26-chance__grades" aria-label="{{ s_grades }}">
                <li>Classic</li><li>Mediflex</li><li>Bioblend</li><li>Crib 5</li><li>Crib 7 | B1</li><li>Outdoor</li>
              </ul>
              <ul class="o26-card__chips">{%- assign chips = s_chance_chips | split: '|' -%}{%- for c in chips -%}<li>{{ c }}</li>{%- endfor -%}</ul>
              <div class="o26-card__links">
                <a href="{{ chance_url }}" data-cta="orgatec_explore" data-collection="chance">{{ s_explore }}</a>
                <a href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="chance">{{ s_samples }}</a>
              </div>
            </div>
            <div>{{ chance_mosaic }}</div>
          </div>
        </article>

        {%- comment -%} CHANCE sub-grades {%- endcomment -%}
        <article class="o26-card o26-card--mist o26-card--4 o26-card--has-swatch">
          {%- if all_products['mediflex-collection'].featured_image -%}
            <div class="o26-card__swatch">{{ all_products['mediflex-collection'].featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'CHANCE MEDIFLEX' }}</div>
          {%- endif -%}
          <span class="o26-card__sector">{{ s_mediflex_sector }}</span>
          <h3 class="o26-display">Chance<br>Mediflex</h3>
          <p class="o26-card__desc">{{ s_mediflex_desc }}</p>
          <ul class="o26-card__chips">{%- assign chips = s_mediflex_chips | split: '|' -%}{%- for c in chips -%}<li>{{ c }}</li>{%- endfor -%}</ul>
          <div class="o26-card__links">
            <a href="{{ base }}/products/mediflex-collection" data-cta="orgatec_explore" data-collection="mediflex">{{ s_explore }}</a>
            <a href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="mediflex">{{ s_samples }}</a>
          </div>
        </article>

        <article class="o26-card o26-card--taupe o26-card--4">
          <span class="o26-card__sector">{{ s_crib_sector }}</span>
          <h3 class="o26-display">Chance<br>Crib 7 | B1</h3>
          <p class="o26-card__desc">{{ s_crib_desc }}</p>
          <ul class="o26-card__chips">{%- assign chips = s_crib_chips | split: '|' -%}{%- for c in chips -%}<li>{{ c }}</li>{%- endfor -%}</ul>
          <div class="o26-card__links">
            <a href="{{ chance_url }}" data-cta="orgatec_explore" data-collection="crib7-b1">{{ s_explore }}</a>
            <a href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="crib7">{{ s_samples }}</a>
          </div>
        </article>

        <article class="o26-card o26-card--sage o26-card--4">
          <span class="o26-card__sector">{{ s_bioblend_sector }}</span>
          <h3 class="o26-display">Chance<br>Bioblend</h3>
          <p class="o26-card__desc">{{ s_bioblend_desc }}</p>
          <ul class="o26-card__chips">{%- assign chips = s_bioblend_chips | split: '|' -%}{%- for c in chips -%}<li>{{ c }}</li>{%- endfor -%}</ul>
          <div class="o26-card__links">
            <a href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="bioblend">{{ s_samples }}</a>
          </div>
        </article>

        {%- comment -%} ELECTRA {%- endcomment -%}
        <article class="o26-card o26-card--mist o26-card--6 o26-card--has-swatch">
          {%- if all_products['electra-collection'].featured_image -%}
            <div class="o26-card__swatch">{{ all_products['electra-collection'].featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'ELECTRA' }}</div>
          {%- endif -%}
          <span class="o26-card__sector">{{ s_electra_sector }}</span>
          <p class="o26-card__tag">{{ s_electra_tag }}</p>
          <h3 class="o26-display">Electra</h3>
          <p class="o26-card__desc">{{ s_electra_desc }}</p>
          <ul class="o26-card__chips">{%- assign chips = s_electra_chips | split: '|' -%}{%- for c in chips -%}<li>{{ c }}</li>{%- endfor -%}</ul>
          <div class="o26-card__links">
            <a href="{{ base }}/products/electra-collection" data-cta="orgatec_explore" data-collection="electra">{{ s_explore }}</a>
            <a href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="electra">{{ s_samples }}</a>
          </div>
        </article>

        {%- comment -%} STRAW {%- endcomment -%}
        <article class="o26-card o26-card--taupe o26-card--6 o26-card--has-swatch">
          {%- if all_products['straw-collection'].featured_image -%}
            <div class="o26-card__swatch">{{ all_products['straw-collection'].featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'STRAW' }}</div>
          {%- endif -%}
          <p class="o26-card__tag">{{ s_straw_tag }}</p>
          <h3 class="o26-display">Straw</h3>
          <p class="o26-card__desc">{{ s_straw_desc }}</p>
          <ul class="o26-card__chips">{%- assign chips = s_straw_chips | split: '|' -%}{%- for c in chips -%}<li>{{ c }}</li>{%- endfor -%}</ul>
          <div class="o26-card__links">
            <a href="{{ base }}/products/straw-collection" data-cta="orgatec_explore" data-collection="straw">{{ s_explore }}</a>
            <a href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="straw">{{ s_samples }}</a>
          </div>
        </article>

        {%- comment -%} ORIGIN {%- endcomment -%}
        <article class="o26-card o26-card--sage o26-card--6 o26-card--has-swatch">
          {%- if all_products['origin-collection'].featured_image -%}
            <div class="o26-card__swatch">{{ all_products['origin-collection'].featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'ORIGIN' }}</div>
          {%- endif -%}
          <p class="o26-card__tag">{{ s_origin_tag }}</p>
          <h3 class="o26-display">Origin</h3>
          <p class="o26-card__desc">{{ s_origin_desc }}</p>
          <ul class="o26-card__chips">{%- assign chips = s_origin_chips | split: '|' -%}{%- for c in chips -%}<li>{{ c }}</li>{%- endfor -%}</ul>
          <div class="o26-card__links">
            <a href="{{ base }}/pages/origin-sustainable-fabrics" data-cta="orgatec_explore" data-collection="origin">{{ s_explore }}</a>
            <a href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="origin">{{ s_samples }}</a>
          </div>
        </article>

        {%- comment -%} PU OFFICE {%- endcomment -%}
        <article class="o26-card o26-card--taupe o26-card--6">
          <span class="o26-card__sector">{{ s_office_sector }}</span>
          <p class="o26-card__tag">{{ s_office_tag }}</p>
          <h3 class="o26-display">Furna · Mara<br>Portus · Elefante</h3>
          <p class="o26-card__desc">{{ s_office_desc }}</p>
          <div class="o26-card__swatches">
            {%- assign office = 'furna,mara,portus,elefante' | split: ',' -%}
            {%- for h in office -%}
              {%- assign ph = h | append: '-collection' -%}
              {%- assign prod = all_products[ph] -%}
              {%- if prod.featured_image -%}
                <a href="{{ base }}/products/{{ ph }}" data-cta="orgatec_explore" data-collection="{{ h }}">{{ prod.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: prod.title }}<span>{{ h | upcase }}</span></a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <ul class="o26-card__chips">{%- assign chips = s_office_chips | split: '|' -%}{%- for c in chips -%}<li>{{ c }}</li>{%- endfor -%}</ul>
          <div class="o26-card__links">
            <a href="{{ base }}/collections/office-fabrics-upholstery" data-cta="orgatec_explore" data-collection="office">{{ s_explore }}</a>
            <a href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="office">{{ s_samples }}</a>
          </div>
        </article>

        {%- comment -%} PVC FABRIC LOOK {%- endcomment -%}
        <article class="o26-card o26-card--sand o26-card--12">
          <div class="o26-chance">
          <div>
          <p class="o26-card__tag">{{ s_fabric_tag }}</p>
          <h3 class="o26-display">Straw · Siesta<br>Glam · Jazz</h3>
          <p class="o26-card__desc">{{ s_fabric_desc }}</p>
          <ul class="o26-card__chips">{%- assign chips = s_fabric_chips | split: '|' -%}{%- for c in chips -%}<li>{{ c }}</li>{%- endfor -%}</ul>
          <div class="o26-card__links">
            <a href="{{ samples_url }}" data-cta="orgatec_samples" data-cta-slot="fabric-look">{{ s_samples }}</a>
          </div>
          </div>
          <div class="o26-card__swatches o26-card__swatches--2x2">
            {%- assign fabric = 'straw,siesta,glam,jazz' | split: ',' -%}
            {%- for h in fabric -%}
              {%- assign ph = h | append: '-collection' -%}
              {%- assign prod = all_products[ph] -%}
              {%- if prod.featured_image -%}
                <a href="{{ base }}/products/{{ ph }}" data-cta="orgatec_explore" data-collection="{{ h }}">{{ prod.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: prod.title }}<span>{{ h | upcase }}</span></a>
