          <p>{% if og_de %}Erzählen Sie uns von Ihrem Projekt und wann Sie in Köln sind. Wir bestätigen Ihnen den Termin am Stand per E-Mail.{% else %}Tell us about your project and when you'll be in Cologne. We'll confirm a time at the stand by email.{% endif %}</p>
          <div class="og-direct">
            <b>{% if og_de %}Lieber direkt schreiben?{% else %}Prefer to write directly?{% endif %}</b>
            <a href="mailto:hello@monteirofabrics.com" data-cta="orgatec_contact">hello@monteirofabrics.com</a>
            <a href="tel:+351228338640" data-cta="orgatec_contact">+351 228 338 640</a>
          </div>
        </div>

        {% form 'contact', id: 'orgatec-meeting-form', class: 'og-form', data-form: 'orgatec_meeting' %}
          {%- if form.posted_successfully? -%}
          <div class="og-form__success" data-form-success="orgatec_meeting" style="display:block">{% if og_de %}Vielen Dank. Wir bestätigen Ihren Termin am Stand Q059 per E-Mail.{% else %}Thank you. We'll confirm your meeting at Stand Q059 by email.{% endif %}</div>
          {%- else -%}
          {%- if form.errors -%}<div class="og-form__success" style="display:block">{{ form.errors | default_errors }}</div>{%- endif -%}
          <input type="hidden" name="contact[Request]" value="ORGATEC 2026 – stand meeting">
          <input type="hidden" name="contact[Page]" value="{{ request.path }}">
          <input type="hidden" name="contact[Locale]" value="{{ request.locale.iso_code }}">
          <input type="hidden" name="contact[utm_source]" value="">
          <input type="hidden" name="contact[utm_medium]" value="">
          <input type="hidden" name="contact[utm_campaign]" value="">
          <input type="hidden" name="contact[utm_content]" value="">
          <input type="hidden" name="contact[utm_term]" value="">
          <input type="hidden" name="contact[gclid]" value="">

          <div class="og-field"><label for="og-name"><span>Name</span> <i>*</i></label><input id="og-name" name="contact[name]" type="text" required autocomplete="name" value="{{ form.name }}"></div>
          <div class="og-field"><label for="og-company"><span>{% if og_de %}Unternehmen{% else %}Company{% endif %}</span> <i>*</i></label><input id="og-company" name="contact[Company]" type="text" required autocomplete="organization" value="{{ form.Company }}"></div>
          <div class="og-field"><label for="og-email"><span>{% if og_de %}E-Mail{% else %}Email{% endif %}</span> <i>*</i></label><input id="og-email" name="contact[email]" type="email" required autocomplete="email" value="{{ form.email }}"></div>
          <div class="og-field"><label for="og-phone">{% if og_de %}Telefon{% else %}Phone{% endif %}</label><input id="og-phone" name="contact[Phone]" type="tel" autocomplete="tel" value="{{ form.Phone }}"></div>
          <div class="og-field"><label for="og-day">{% if og_de %}Wunschtag{% else %}Preferred day{% endif %}</label>
            <select id="og-day" name="contact[Preferred day]">
              <option value="">{% if og_de %}Flexibel{% else %}Flexible{% endif %}</option>
              <option value="2026-10-27">{% if og_de %}Dienstag, 27. Oktober{% else %}Tuesday 27 October{% endif %}</option>
              <option value="2026-10-28">{% if og_de %}Mittwoch, 28. Oktober{% else %}Wednesday 28 October{% endif %}</option>
              <option value="2026-10-29">{% if og_de %}Donnerstag, 29. Oktober{% else %}Thursday 29 October{% endif %}</option>
              <option value="2026-10-30">{% if og_de %}Freitag, 30. Oktober{% else %}Friday 30 October{% endif %}</option>
            </select></div>
          <div class="og-field"><label for="og-sector">{% if og_de %}Branche{% else %}Sector{% endif %}</label>
            <select id="og-sector" name="contact[Sector]">
              <option value="">{% if og_de %}Bitte wählen{% else %}Select{% endif %}</option>
              <option value="Office furniture">{% if og_de %}Büromöbel{% else %}Office furniture{% endif %}</option>
              <option value="Healthcare">Healthcare</option>
              <option value="Hospitality">{% if og_de %}Hotellerie &amp; Gastronomie{% else %}Hospitality{% endif %}</option>
              <option value="Public spaces & transport">{% if og_de %}Öffentliche Bereiche &amp; Verkehr{% else %}Public spaces &amp; transport{% endif %}</option>
              <option value="Architecture & interior design">{% if og_de %}Architektur &amp; Innenarchitektur{% else %}Architecture &amp; interior design{% endif %}</option>
              <option value="Other">{% if og_de %}Sonstiges{% else %}Other{% endif %}</option>
            </select></div>
          <div class="og-field og-field--full"><label for="og-message">{% if og_de %}Ihr Projekt{% else %}Your project{% endif %}</label><textarea id="og-message" name="contact[body]" rows="3" placeholder="{% if og_de %}Kollektionen, die Sie sehen möchten, Mengen, Zeitplan …{% else %}Collections you'd like to see, quantities, timing…{% endif %}"></textarea></div>
          <div class="og-form__actions">
            <button type="submit" class="button" data-cta="orgatec_meeting_submit">{% if og_de %}Termin anfragen{% else %}Request a meeting{% endif %}</button>
            <span class="og-form__consent">{% if og_de %}Wir verwenden Ihre Angaben ausschließlich zur Beantwortung Ihrer Anfrage.{% else %}We use your details only to respond to your request.{% endif %}</span>
          </div>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>

  {% endunless %}

  <!-- 10 · Practical -->
  <div class="og-section og-section--tight" style="padding-top:0">
    <div class="og-wrap">
      <div class="og-practical">
        <div><b>{% if og_de %}Wann{% else %}When{% endif %}</b><p>{% if og_de %}27.–30. Oktober 2026<br>09:00–18:00 Uhr{% else %}27–30 October 2026<br>09:00–18:00{% endif %}</p></div>
        <div><b>{% if og_de %}Wo{% else %}Where{% endif %}</b><p>{% if og_de %}Koelnmesse, Köln<br>Halle 10.2{% else %}Koelnmesse, Cologne<br>Hall 10.2{% endif %}</p></div>
        <div><b>Stand</b><p>Q059<br>Contract Solutions</p></div>
      </div>
      <div class="og-practical__links">
        <a class="og-arrowlink og-ics" href="#" data-cta="orgatec_calendar">{% if og_de %}Zum Kalender hinzufügen{% else %}Add to calendar{% endif %}</a>
        <a class="og-arrowlink" href="https://www.orgatec.com/orgatec-exhibitors/list-of-exhibitors/" target="_blank" rel="noopener" data-cta="orgatec_hallplan">{% if og_de %}Ausstellereintrag auf orgatec.com{% else %}Exhibitor listing on orgatec.com{% endif %}</a>
      </div>
    </div>
  </div>

  <!-- 11 · FAQ (house accordion) -->
  {% if section.settings.show_faq %}
  <div class="og-section og-alt">
    <div class="og-wrap">
      <div class="og-faq">
        <h2 class="og-h2">{% if og_de %}Gut zu wissen{% else %}Good to know{% endif %}</h2>
        <details><summary>{% if og_de %}Wie funktionieren die Gratismuster?{% else %}How do free samples work?{% endif %}</summary><div class="og-faq__a">{% if og_de %}Öffnen Sie die Kollektionsseite, wählen Sie Ihre Farben und legen Sie sie in den Warenkorb. Gehen Sie zur Kasse, geben Sie Kontakt und Lieferadresse an – wir senden Ihnen die Muster innerhalb weniger Tage. Kostenlos.{% else %}Open the collection page, choose the colours you like and add them to the cart. Go to checkout, add your contact and delivery address, and we'll send the samples within a few days. Free of charge.{% endif %}</div></details>
        <details><summary>{% if og_de %}Kann ich CHANCE 2.0 schon vor dem Launch sehen?{% else %}Can I see CHANCE 2.0 before it launches?{% endif %}</summary><div class="og-faq__a">{% if og_de %}Ja. Die komplette Palette mit 236 Farben und alle sechs Qualitäten sind am Stand. Muster von CHANCE 2.0 folgen mit dem Launch unserer neuen Website. Vereinbaren Sie einen Termin, und wir führen Sie durch die Kollektion.{% else %}Yes. The complete 236-colour palette and all six grades are on the stand. Samples of CHANCE 2.0 follow with the launch of our new website. Book a meeting and we'll walk you through the collection.{% endif %}</div></details>
        <details><summary>{% if og_de %}Wo genau ist der Stand?{% else %}Where exactly is the stand?{% endif %}</summary><div class="og-faq__a">{% if og_de %}Halle 10.2, Stand Q059, im Bereich Contract Solutions der Koelnmesse. Speichern Sie die Termine im Kalender – wir sehen uns dort.{% else %}Hall 10.2, Stand Q059, in the Contract Solutions area of Koelnmesse. Add the dates to your calendar and we'll see you there.{% endif %}</div></details>
      </div>
    </div>
  </div>
  {% endif %}

</section>

<script>
/* CHANCE 2.0 colour mosaic — decorative, CSS only (no asset needed) */
(function(){
  const m=document.querySelector(".og-mosaic"); if(!m) return;
  const cols=["#f2ede4","#e6dccb","#d9c7a7","#c9a97a","#b8864f","#8f5a2b","#c53a2e","#e0603f","#ef8f4a","#f3b64c","#e8d24a","#b7bd4a","#7fa24b","#4f8b52","#2f6f5a","#2f7d7a","#3b8fa8","#3f6fb0","#2f519b","#4a4a8c","#6f4c8c","#9a5b8f","#c76a9b","#e39ab1","#d7b7b0","#b98b7f","#8c6b62","#5e4a45","#3a3230","#1f1d1c","#4b4b52","#6f7078","#9a9ba3","#c4c5cb","#e2e2e5","#f4f4f5","#b5c9c1","#8fa9a0","#6b8a83","#d8c9a0","#aa9a6b","#7b6f47","#e7c7b4","#c99a8a","#a17567","#d3d9a8","#a7b47c","#7c8d52","#5a6b3a","#f0d9d1","#e0b8ad","#b98d84","#c8cfd8","#8f9db0","#5d6e88","#3d4d66","#efe6d0","#d6c9ad","#b3a486","#8b7c5f","#6d604a","#e8e0f0","#c8b8dc","#a691c3"];
  let i=0; for(let n=0;n<64;n++){ const el=document.createElement("i"); el.style.background=cols[n%cols.length]; m.appendChild(el); }
})();
/* Add to calendar (.ics) — measured as a click; on Shopify the download works, in a sandboxed preview it may be inert */
(function(){
  const ics=["BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//Monteiro Fabrics//ORGATEC 2026//EN","BEGIN:VEVENT","UID:orgatec-2026-monteiro-fabrics@monteirofabrics.com","DTSTAMP:20260910T090000Z","DTSTART;TZID=Europe/Berlin:20261027T090000","DTEND;TZID=Europe/Berlin:20261030T180000","SUMMARY:ORGATEC 2026 – Monteiro Fabrics\\, Hall 10.2\\, Stand Q059","LOCATION:Koelnmesse\\, Messeplatz 1\\, 50679 Köln","DESCRIPTION:Coated upholstery fabrics by Monteiro Fabrics. Hall 10.2\\, Stand Q059. https://www.monteirofabrics.com/pages/orgatec-2026","URL:https://www.monteirofabrics.com/pages/orgatec-2026","END:VEVENT","END:VCALENDAR"].join("\r\n");
  document.querySelectorAll(".og-ics").forEach(a=>{
    a.addEventListener("click",e=>{ e.preventDefault(); const b=new Blob([ics],{type:"text/calendar;charset=utf-8"}); const u=URL.createObjectURL(b); const l=document.createElement("a"); l.href=u; l.download="orgatec-2026-monteiro-fabrics.ics"; document.body.appendChild(l); l.click(); l.remove(); setTimeout(()=>URL.revokeObjectURL(u),2000); });
  });
})();
/* UTM + gclid → hidden fields (kept for the session) */
(function(){
  const keys=["utm_source","utm_medium","utm_campaign","utm_content","utm_term","gclid"]; const p=new URLSearchParams(location.search);
  keys.forEach(k=>{ let v=p.get(k); try{ if(v) sessionStorage.setItem("og_"+k,v); else v=sessionStorage.getItem("og_"+k); }catch(e){} const f=document.querySelector('input[name="contact['+k+']"]'); if(f&&v) f.value=v; });
  const pg=document.querySelector('input[name="contact[Page]"]'); if(pg) pg.value=location.pathname;
})();

/* after a native contact-form post Shopify reloads with ?contact_posted=true → bring the confirmation into view */
(function(){ if(location.search.indexOf("contact_posted=true")>-1){ var el=document.querySelector('[data-form-success="orgatec_meeting"]')||document.getElementById("meeting"); if(el){ setTimeout(function(){ el.scrollIntoView({behavior:"smooth",block:"center"}); },150); } } })();
</script>

