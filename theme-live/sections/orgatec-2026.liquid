      <span class="o26-eyebrow">{{ s_bring_eyebrow }}</span>
      <h2 class="o26-display">{{ s_bring_h2 }}</h2>
      <p class="o26-lead">{{ s_bring_lead }}</p>

      <div class="o26-grid">

        {%- comment -%} CHANCE 2.0 family {%- endcomment -%}
