{%- comment -%}
  ORGATEC 2026 landing page — v2 (10/09/2026). Self-contained: markup + scoped CSS + JS + Event JSON-LD.
  Lives on the live theme (Showcase 7.0) at templates/page.orgatec-2026.json → /pages/orgatec-2026 (DE: /de/pages/orgatec-2026).
  Design tokens = the live theme's own: Source Sans Pro · #111 text · #464654 headings/buttons · #f5f5f5 alt bg ·
  #dbdbdb rules · .button (uppercase 13px / .13em / 18px 30px / square). Uses the theme's .button class directly.
  Copy: EN default, DE when request.locale is de (formal Sie; "beschichtete Möbelstoffe", never "Kunstleder").
  CHANCE 2.0 is promoted only — no sample CTA until it launches with the new website.
  Phases (section setting): pre (default) · live (27/10) · post (31/10: form hidden, hero/band swap to "Missed ORGATEC?").
  Tracking hooks: data-cta / data-cta-slot / data-collection on every CTA · form id orgatec-meeting-form ·
  success = ?contact_posted=true + [data-form-success="orgatec_meeting"] · hidden utm_* + gclid fields.
  Generated from Clients/Monteiro-Fabrics/prototypes/orgatec-2026/index.html by build_liquid.py — edit the prototype, regenerate.
{%- endcomment -%}
{%- liquid
  assign og_de = false
  if request.locale.iso_code == 'de'
    assign og_de = true
  endif
  assign og_root = routes.root_url
  if og_root == '/'
    assign og_root = ''
  endif
  assign og_phase = section.settings.phase | default: 'pre'
  assign og_hall = section.settings.hall | default: 'Hall 10.2'
  assign og_stand = section.settings.stand | default: 'Stand Q059'
  assign og_hall_de = og_hall | replace: 'Hall', 'Halle'
  assign og_stand_de = og_stand

  if og_phase == 'live'
    if og_de
      assign og_hero_title = 'Diese Woche auf der ORGATEC – Halle 10.2, Stand Q059'
      assign og_hero_lead = '27.–30. Oktober, Koelnmesse. Besuchen Sie uns am Stand – oder bestellen Sie kostenlose Muster direkt ins Büro.'
      assign og_band_eyebrow = 'Diese Woche in Köln'
      assign og_band_title = 'Bestellen Sie Ihre Muster – oder holen Sie sie am Stand ab.'
    else
      assign og_hero_title = "We're at ORGATEC this week – Hall 10.2, Stand Q059"
      assign og_hero_lead = '27–30 October, Koelnmesse. Come and see the collections, or order free samples straight to your office.'
      assign og_band_eyebrow = 'This week in Cologne'
      assign og_band_title = 'Order your samples, or pick them up at the stand.'
    endif
  elsif og_phase == 'post'
    if og_de
      assign og_hero_title = 'ORGATEC verpasst? Bestellen Sie kostenlose Muster.'
      assign og_hero_lead = 'Vielen Dank für Ihren Besuch in Köln. Die Kollektionen vom Stand können Sie jetzt als kostenlose Muster bestellen.'
      assign og_band_eyebrow = 'Nach der Messe'
      assign og_band_title = 'Bestellen Sie die Muster, die Sie in Köln gesehen haben.'
    else
      assign og_hero_title = 'Missed ORGATEC? Order free samples.'
      assign og_hero_lead = 'Thank you for visiting us in Cologne. The collections from the stand are available as free samples now.'
      assign og_band_eyebrow = 'After the fair'
      assign og_band_title = 'Order the samples you saw in Cologne.'
    endif
  else
    if og_de
      assign og_hero_title = 'Beschichtete Möbelstoffe, live auf der ORGATEC 2026'
      assign og_hero_lead = 'Halle 10.2, Stand Q059 · 27.–30. Oktober. Bestellen Sie jetzt kostenlose Muster und erleben Sie die Kollektionen in Köln.'
      assign og_band_eyebrow = 'Vor der Messe'
      assign og_band_title = 'Bestellen Sie Ihre Muster vor Köln.'
    else
      assign og_hero_title = 'Coated upholstery fabrics, live at ORGATEC 2026'
      assign og_hero_lead = 'Hall 10.2, Stand Q059 · 27–30 October. Order free samples now and see the full collections in Cologne.'
      assign og_band_eyebrow = 'Before the fair'
      assign og_band_title = 'Order your samples before Cologne.'
    endif
  endif
-%}
<style>
/* ============================================================
   ORGATEC 2026 — section styles (scoped, house tokens)
   Tokens from the live theme: Source Sans Pro · text #111 ·
   heading/button #464654 · alt bg #f5f5f5 · rule #dbdbdb ·
   buttons uppercase 13px / .13em / 18px 30px / square
   ============================================================ */
.orgatec{font-family:"Source Sans Pro",sans-serif;color:#111;font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased}
.orgatec *,.orgatec *:before,.orgatec *:after{box-sizing:border-box}
.orgatec h1,.orgatec h2,.orgatec h3,.orgatec h4{font-family:inherit;color:inherit!important;text-align:inherit!important;margin:0;font-style:normal}
.orgatec .og-hero h1,.orgatec .og-band h2,.orgatec .og-faq .og-h2{text-align:center!important}
.orgatec p{margin:0}
.orgatec a{color:inherit}
.orgatec img{max-width:100%;display:block}
.og-wrap{max-width:1160px;margin:0 auto;padding:0 20px}
.og-section{padding:100px 0}
.og-section--tight{padding:70px 0}
.og-alt{background:#f5f5f5}
.og-eyebrow{display:block;font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#464654;margin-bottom:14px}
.og-h2{font-size:48px;font-weight:300;line-height:1.08;letter-spacing:-.01em}
.og-h3{font-size:28px;font-weight:600;line-height:1.2}
.og-lead{font-size:20px;line-height:1.5;color:#111}
.og-muted{color:#464654}
.og-rule{display:block;width:40px;height:2px;background:currentColor;margin:22px 0}
.og-rule--center{margin-left:auto;margin-right:auto}
.og-heading-row{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;margin-bottom:44px}
.og-heading-row .og-h2{max-width:720px}
.og-textlink{font-size:14px;font-weight:600;text-decoration:none;color:#111;border-bottom:1px solid #111;padding-bottom:2px;white-space:nowrap}
.og-textlink:hover{opacity:.7}
.og-arrowlink{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:#464654;text-decoration:none}
.og-arrowlink:after{content:"";width:18px;height:1px;background:currentColor;transition:width .2s}
.og-arrowlink:hover:after{width:28px}
.orgatec .button{font-family:inherit;text-decoration:none;cursor:pointer}
.orgatec .button.og-ghost{background:transparent;color:#fff;border-color:#fff}
.orgatec .button.og-ghost:hover{background:#fff;color:#464654}
.orgatec .button.og-onlight{background:#fff;color:#464654;border-color:#fff}
.orgatec .button.og-onlight:hover{background:transparent;color:#fff}
.og-btnrow{display:flex;gap:14px;flex-wrap:wrap}
.og-btnrow--center{justify-content:center}
.og-chips{display:flex;flex-wrap:wrap;gap:8px}
.og-chip{display:inline-block;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#464654;border:1px solid #dbdbdb;padding:5px 10px;line-height:1.2;background:#fff}
.og-chip--solid{background:#464654;color:#fff;border-color:#464654}
.og-placeholder{position:relative;overflow:hidden;background:#e9e7e2}
.og-placeholder:after{content:attr(data-label);position:absolute;left:10px;bottom:8px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:rgba(0,0,0,.45);font-weight:600}
.og-placeholder--dark:after{color:rgba(255,255,255,.55)}
.og-card__img img,.og-sector .og-placeholder img,.og-card__products a i img,.og-hero__media img{width:100%;height:100%;object-fit:cover;display:block}

/* event bar */
.og-eventbar{background:#464654;color:#fff}
.og-eventbar .og-wrap{display:flex;justify-content:space-between;align-items:center;gap:24px;min-height:46px}
.og-eventbar__meta{display:flex;flex-wrap:wrap;gap:0 10px;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600}
.og-eventbar__meta span+span:before{content:"·";margin-right:10px;opacity:.6}
.og-eventbar__meta strong{font-weight:600}
.og-eventbar a{font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.5);padding-bottom:1px;white-space:nowrap}
.og-eventbar a:hover{border-color:#fff}

/* hero */
.og-hero{position:relative;min-height:660px;display:flex;align-items:center;justify-content:center;text-align:center;color:#fff;background:#3b3b48;overflow:hidden}
.og-hero__media{position:absolute;inset:0;background:linear-gradient(135deg,#5b5b6d 0%,#2f2f3b 55%,#1e1e27 100%)}
.og-hero__media:after{content:attr(data-label);position:absolute;left:24px;bottom:18px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.45);font-weight:600}
.og-hero__media img{width:100%;height:100%;object-fit:cover}
.og-hero__shade{position:absolute;inset:0;background:rgba(0,0,0,.38)}
.og-hero__content{position:relative;max-width:820px;padding:120px 20px}
.og-hero .og-eyebrow{color:rgba(255,255,255,.85);margin-bottom:18px}
.og-hero h1{font-size:60px;font-weight:600;line-height:1.12;letter-spacing:-.005em;text-align:center}
.og-hero .og-rule{margin:24px auto}
.og-hero .og-lead{font-size:24px;line-height:1.5;color:#fff;max-width:680px;margin:0 auto 34px}
.og-hero__fine{margin-top:36px;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.75)}

/* proof strip */
.og-proof{border-bottom:1px solid #dbdbdb}
.og-proof__grid{display:grid;grid-template-columns:repeat(4,1fr)}
.og-proof__item{display:flex;gap:14px;align-items:flex-start;padding:30px 24px 30px 0}
.og-proof__item+.og-proof__item{border-left:1px solid #dbdbdb;padding-left:24px}
.og-proof__item svg{width:22px;height:22px;flex:none;stroke:#464654;fill:none;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;margin-top:2px}
.og-proof__item b{display:block;font-weight:600;font-size:16px;line-height:1.3}
.og-proof__item small{display:block;font-size:14px;color:#464654;margin-top:2px}

/* intro */
.og-intro .og-lead{max-width:760px}

/* CHANCE 2.0 feature */
.og-chance{display:grid;grid-template-columns:5fr 7fr;gap:60px;align-items:center}
.og-mosaic{aspect-ratio:1/1;display:grid;grid-template-columns:repeat(8,1fr);gap:3px;background:#fff;padding:3px}
.og-mosaic i{display:block}
.og-chance__title{font-size:44px;font-weight:600;line-height:1;letter-spacing:.01em}
.og-chance__claim{font-size:26px;font-weight:300;line-height:1.3;margin:14px 0 16px}
.og-chance__text{font-size:17px;color:#111;max-width:560px}
.og-chance__label{display:block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#464654;font-weight:600;margin:26px 0 10px}
.og-chance__note{font-size:14px;color:#464654;margin-top:26px;padding-left:14px;border-left:2px solid #464654;max-width:520px}
.og-chance .og-btnrow{margin-top:26px}
.og-grades{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px}
.og-grade{background:#fff;border:1px solid #dbdbdb;padding:28px 26px 30px}
.og-grade .og-eyebrow{margin-bottom:10px;font-size:11px}
.og-grade h4{font-size:20px;font-weight:600;margin-bottom:10px}
.og-grade p{font-size:15px;color:#111;margin-bottom:18px;min-height:0}
.og-grade .og-chip{background:#fff}

/* sample collections */
.og-samples__head{max-width:760px;margin-bottom:44px}
.og-samples__head .og-h3{font-size:32px;font-weight:300}
.og-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:32px 28px}
.og-card{display:flex;flex-direction:column}
.og-card--wide{grid-column:span 1}
.og-card__img{aspect-ratio:1/1;background:#e9e7e2}
.og-card__img.og-placeholder--a{background:linear-gradient(160deg,#dcd6cc,#c9c1b3)}
.og-card__img.og-placeholder--b{background:linear-gradient(160deg,#c5b8a6,#a89880)}
.og-card__img.og-placeholder--c{background:linear-gradient(160deg,#e3ded4,#cfc7b8)}
.og-card__img.og-placeholder--d{background:linear-gradient(160deg,#b9c0c6,#8f979e)}
.og-card__img.og-placeholder--e{background:linear-gradient(160deg,#d9cdbd,#b39c7f)}
.og-card__swatches{display:flex;gap:6px;align-items:center;margin:12px 0 10px}
.og-card__swatches i{width:30px;height:30px;display:block;border:1px solid rgba(0,0,0,.08)}
.og-card__sector{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#464654;font-weight:600;margin:12px 0 6px}
.og-card__title{font-size:16px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;line-height:1.3}
.og-card__claim{font-size:16px;color:#111;margin:8px 0 14px;flex:1}
.og-card .og-chips{margin-bottom:18px}
.og-card__products{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:12px 0 4px}
.og-card__products a{text-decoration:none;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#111}
.og-card__products a i{display:block;aspect-ratio:1/1;margin-bottom:8px;border:1px solid rgba(0,0,0,.08);background:#d8d2c7}
.og-card__products a span{display:block}
.og-card__products a small{display:block;font-weight:400;letter-spacing:0;text-transform:none;color:#464654;font-size:12px}
.og-card__products a:hover span{text-decoration:underline}
.og-cards--groups{grid-template-columns:repeat(2,1fr);margin-top:48px;padding-top:48px;border-top:1px solid #dbdbdb}
.og-cards--groups .og-card{display:grid;grid-template-columns:1fr;gap:0}

/* sectors */
.og-sectors{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.og-sector{position:relative;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;text-decoration:none;color:#fff;overflow:hidden}
.og-sector .og-placeholder{position:absolute;inset:0}
.og-sector:nth-child(1) .og-placeholder{background:linear-gradient(160deg,#6f7a8a,#3c4452)}
.og-sector:nth-child(2) .og-placeholder{background:linear-gradient(160deg,#7fa9a6,#3f6664)}
.og-sector:nth-child(3) .og-placeholder{background:linear-gradient(160deg,#9b8570,#4f4237)}
.og-sector:nth-child(4) .og-placeholder{background:linear-gradient(160deg,#8b8f96,#3e4147)}
.og-sector:before{content:"";position:absolute;inset:0;background:rgba(0,0,0,.28);transition:background .3s;z-index:1}
.og-sector:hover:before{background:rgba(0,0,0,.42)}
.og-sector span{position:relative;z-index:2;font-size:22px;font-weight:400;text-align:center;padding:0 16px;text-shadow:0 1px 8px rgba(0,0,0,.25)}

/* CTA band (rich-text style) */
.og-band{text-align:center}
.og-band__inner{max-width:720px;margin:0 auto}
.og-band h2{font-size:54px;font-weight:600;line-height:1.15;letter-spacing:-.01em;text-align:center}
.og-band p{font-size:17px;margin:0 auto 30px;max-width:600px}
.og-band .og-textlink{display:inline-block;margin-top:22px}

/* meeting */
.og-meeting{display:grid;grid-template-columns:5fr 7fr;gap:72px;align-items:start}
.og-meeting__copy .og-h2{margin-bottom:22px}
.og-meeting__copy p{font-size:17px;max-width:440px}
.og-direct{margin-top:36px;padding-top:26px;border-top:1px solid #dbdbdb;font-size:15px;color:#464654}
.og-direct b{display:block;color:#111;font-weight:600;margin-bottom:8px}
.og-direct a{text-decoration:none;color:#111;display:inline-block;border-bottom:1px solid #dbdbdb}
.og-direct a+a{margin-left:18px}
.og-form{display:grid;grid-template-columns:1fr 1fr;gap:26px 28px}
.og-field{display:flex;flex-direction:column}
.og-field--full{grid-column:1/-1}
.og-field label{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#464654;font-weight:600;margin-bottom:2px}
.og-field label i{font-style:normal;color:#E32C2B}
.orgatec .og-field input,.orgatec .og-field select,.orgatec .og-field textarea{font-family:inherit;font-size:16px;color:#111;background:transparent;border:0;border-bottom:1px solid #464654;border-radius:0;padding:12px 0;width:100%;outline:none;-webkit-appearance:none;appearance:none;box-shadow:none;height:auto;margin:0}
.orgatec .og-field select{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' fill='none' stroke='%23464654' stroke-width='1.5'/></svg>");background-repeat:no-repeat;background-position:right 2px center;padding-right:24px;cursor:pointer}
.orgatec .og-field textarea{min-height:96px;resize:vertical}
.orgatec .og-field input:focus,.orgatec .og-field select:focus,.orgatec .og-field textarea:focus{border-bottom-color:#111;box-shadow:0 1px 0 #111}
.orgatec .og-field input::placeholder,.orgatec .og-field textarea::placeholder{color:#8a8a8a}
.og-form__actions{grid-column:1/-1;display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:6px}
.og-form__consent{font-size:13px;color:#464654;max-width:380px}
.og-form__success{grid-column:1/-1;background:#f5f5f5;padding:24px;font-size:16px;display:none}

/* practical */
.og-practical{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;padding-top:44px;border-top:1px solid #dbdbdb}
.og-practical b{display:block;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#464654;font-weight:600;margin-bottom:10px}
.og-practical p{font-size:20px;font-weight:300;line-height:1.35}
.og-practical__links{display:flex;gap:26px;flex-wrap:wrap;margin-top:34px}

/* FAQ (house accordion) */
.og-faq{max-width:850px;margin:0 auto}
.og-faq .og-h2{text-align:center;margin-bottom:34px}
.og-faq details{border-bottom:1px solid #ddd}
.og-faq details:first-of-type{border-top:1px solid #ddd}
.og-faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:20px 0;font-size:16px;font-weight:500}
.og-faq summary::-webkit-details-marker{display:none}
.og-faq summary:after{content:"+";font-size:22px;font-weight:300;line-height:1;color:#464654;flex:none}
.og-faq details[open] summary:after{content:"–"}
.og-faq .og-faq__a{padding:0 40px 22px 0;font-size:16px;color:#111;max-width:720px}

/* responsive */
@media(max-width:1023px){
  .og-chance{grid-template-columns:1fr;gap:40px}
  .og-mosaic{max-width:420px}
  .og-grades{grid-template-columns:1fr}
  .og-cards{grid-template-columns:repeat(2,1fr)}
  .og-meeting{grid-template-columns:1fr;gap:44px}
  .og-proof__grid{grid-template-columns:repeat(2,1fr)}
  .og-proof__item:nth-child(3){border-left:0;padding-left:0}
  .og-proof__item{border-top:1px solid #dbdbdb;padding:22px 20px 22px 0}
  .og-proof__item:nth-child(-n+2){border-top:0}
  .og-sectors{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:767px){
  .og-section{padding:56px 0}
  .og-section--tight{padding:44px 0}
  .og-h2{font-size:36px}
  .og-heading-row{flex-direction:column;align-items:flex-start;gap:14px;margin-bottom:30px}
  .og-eventbar .og-wrap{flex-direction:column;align-items:flex-start;gap:6px;padding-top:12px;padding-bottom:12px}
  .og-eventbar__meta{font-size:12px;display:grid;grid-template-columns:1fr 1fr;gap:4px 14px}
  .og-eventbar__meta span+span:before{content:none;margin:0}
  .og-hero{min-height:560px}
  .og-hero__content{padding:80px 20px}
  .og-hero h1{font-size:38px}
  .og-hero .og-lead{font-size:19px}
  .og-hero .button{width:100%;text-align:center}
  .og-hero__fine{margin-top:30px}
  .og-proof__grid{grid-template-columns:1fr}
  .og-proof__item{border-left:0!important;padding-left:0!important;border-top:1px solid #dbdbdb;padding:18px 0}
  .og-proof__item:first-child{border-top:0}
  .og-chance__title{font-size:36px}
  .og-chance__claim{font-size:22px}
  .og-cards,.og-cards--groups{grid-template-columns:1fr}
  .og-samples__head .og-h3{font-size:26px}
  .og-band h2{font-size:34px}
  .og-form{grid-template-columns:1fr}
  .og-practical{grid-template-columns:1fr;gap:26px}
  .og-sector span{font-size:18px}
}
</style>

<section class="orgatec" id="orgatec-2026" data-phase="{{ og_phase }}" data-section-id="{{ section.id }}">

  <!-- 1 · Event bar -->
  <div class="og-eventbar">
    <div class="og-wrap">
      <div class="og-eventbar__meta">
        <span><strong>ORGATEC 2026</strong></span>
        <span>{% if og_de %}27.–30. Oktober{% else %}27–30 October{% endif %}</span>
        <span>{% if og_de %}Koelnmesse, Köln{% else %}Koelnmesse, Cologne{% endif %}</span>
        <span>{% if og_de %}{{ og_hall_de }} · {{ og_stand_de }}{% else %}{{ og_hall }} · {{ og_stand }}{% endif %}</span>
      </div>
      <a href="#" class="og-ics" data-cta="orgatec_calendar">{% if og_de %}Zum Kalender hinzufügen{% else %}Add to calendar{% endif %}</a>
    </div>
  </div>

  <!-- 2 · Hero -->
  <div class="og-hero">
    <div class="og-hero__media"{% unless section.settings.hero_image %} data-label="Hero image · to come from Ivana"{% endunless %}>
      {%- if section.settings.hero_image -%}
        {{ section.settings.hero_image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '800, 1200, 1600, 2200', sizes: '100vw', alt: section.settings.hero_image.alt | default: 'ORGATEC 2026 – Monteiro Fabrics' }}
      {%- endif -%}
    </div>
    <div class="og-hero__shade"></div>
    <div class="og-hero__content">
      <span class="og-eyebrow">{% if og_de %}Monteiro Fabrics auf der ORGATEC 2026{% else %}Monteiro Fabrics at ORGATEC 2026{% endif %}</span>
      <h1>{{ og_hero_title }}</h1>
      <span class="og-rule"></span>
