<script>
  (function () {
    var root = document.getElementById('orgatec-2026');
    if (!root) return;

    // 1. Carry inbound campaign parameters into the meeting form (and keep them for the session).
    var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid'];
    var params = new URLSearchParams(window.location.search);
    var store = {};
    try { store = JSON.parse(sessionStorage.getItem('o26_attr') || '{}'); } catch (e) {}
    keys.forEach(function (k) { if (params.get(k)) store[k] = params.get(k); });
    try { sessionStorage.setItem('o26_attr', JSON.stringify(store)); } catch (e) {}
    root.querySelectorAll('[data-utm]').forEach(function (el) {
      var k = el.getAttribute('data-utm');
      if (store[k]) el.value = store[k];
    });

    // 2. After a successful post, bring the confirmation into view.
    var ok = root.querySelector('[data-form-success]');
    if (ok) { ok.scrollIntoView({ block: 'center' }); }

    // 3. Add-to-calendar: build the .ics on the client, no hosted file needed.
    var ics = document.getElementById('o26-ics');
    if (ics) {
      var lines = [
        'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Monteiro Fabrics//ORGATEC 2026//EN', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH',
        'BEGIN:VEVENT',
        'UID:orgatec-2026-q059@monteirofabrics.com',
        'DTSTAMP:20260910T120000Z',
        'DTSTART:20261027T080000Z',
        'DTEND:20261030T170000Z',
        'SUMMARY:ORGATEC 2026 – Monteiro Fabrics (Hall 10.2\\, Stand Q059)',
        'LOCATION:Koelnmesse\\, Messeplatz 1\\, 50679 Köln – Hall 10.2\\, Stand Q059',
        'DESCRIPTION:Visit Monteiro Fabrics at ORGATEC 2026\\, Hall 10.2\\, Stand Q059. {{ lp_url }}',
        'URL:{{ lp_url }}',
        'END:VEVENT', 'END:VCALENDAR'
      ];
      var blob = new Blob([lines.join('\r\n')], { type: 'text/calendar;charset=utf-8' });
      ics.href = URL.createObjectURL(blob);
    }
  })();
</script>

