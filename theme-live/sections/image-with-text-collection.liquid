{{ 'text-columns-collection.css' | asset_url | stylesheet_tag }}

{% style %}
  {% if section.settings.color_scheme == "custom" %}
    .section-id-{{ section.id }} {
      background: {{ section.settings.color_bg }};
      --cust-text-color: {{ section.settings.color_text }};
    }

    {% if section.settings.button_style == 'auto' %}
      #section-id-{{ section.id }} .button:hover {
        background-color: {{ section.settings.color_text }};
        color: {{ section.settings.color_bg }};
        border-color: {{ section.settings.color_bg }};
      }
    {% endif %}
  {% endif %}
  #section-id-{{ section.id }} .feature-header {
    max-width: {{ section.settings.title_width }}em;
  }

  @media(min-width: 768px) {
    .section-id-{{ section.id }} .image-with-text__image__inner {
      {% if section.settings.media_size == "cover" %}
        transform: scale({{ section.settings.image_width | times: 0.01 }});
      {% elsif section.settings.media_size == "contain" %}
        height: auto !important;
        width: {{ section.settings.image_width }}% !important;
      {% endif %}
    }

    .section-id-{{ section.id }} .feature-header {
      {%- assign title_size_medium = section.settings.title_size | times: 0.7 -%}
      font-size: {{ title_size_medium }}px;
    }

    .section-id-{{ section.id }} .image-with-text__text {
      flex-basis: {{ section.settings.text_width }}%;
    }

    .section-id-{{ section.id }} .image-with-text__image__inner .rimage-outer-wrapper {
      background-size: {{ section.settings.media_size }};
    }
  }

  @media (min-width: 992px) {
    .section-id-{{ section.id }} .feature-header {
      font-size: {{ section.settings.title_size }}px;
    }
  }
{% endstyle %}

{% capture image_html %}
  <div class="image-with-text__image lazyload--placeholder">
    <div class="image-with-text__image__inner">
      {%- if section.settings.image == blank and section.settings.video_shopify == blank -%}
        <div class="placeholder-image">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- elsif section.settings.video_shopify != blank -%}
        {% render 'inline-video', video_shopify: section.settings.video_shopify, image: section.settings.image %}
      {%- elsif section.settings.image != blank -%}
        <div class="rimage-outer-wrapper lazyload fade-in"
            data-cc-animate="cc-zoom-out"
            data-bgset="{% render 'bgset', image: section.settings.image %}"
            data-sizes="auto"
            data-parent-fit="cover"
            style="max-width: {{ section.settings.image.width }}px; max-height: {{ section.settings.image.height }}px; background-position: {{ section.settings.image.presentation.focal_point }}">
          <div class="rimage-wrapper" style="padding-top:{{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%">
            <noscript>
              <img src="{{ section.settings.image | img_url: '1024x1024' }}" alt="{{ section.settings.image.alt | escape }}" class="rimage__image">
            </noscript>
          </div>
        </div>
      {% endif %}
    </div>
    {%- if section.settings.color_count > 0 -%}
      <div class="tc-color-badge" aria-label="{{ section.settings.color_count }} colors available">
        <span class="tc-color-badge__count">{{ section.settings.color_count }} colors</span>
      </div>
    {%- endif -%}
  </div>
{% endcapture %}

<div class="image-with-text tc-collection cf
  section-id-{{ section.id }} use-{{ section.settings.color_scheme }}-bg
  {% if section.settings.image_width < 100 and section.settings.media_size == "contain" %}section-spacing-sm{% endif %}
  image-with-text--{{ section.settings.media_size }}
" id="section-id-{{ section.id }}" data-section-type="image-with-text" data-cc-animate>

  {% if section.settings.image_position == 'left' %}{{ image_html }}{% endif %}

  <div class="image-with-text__text align-{{ section.settings.text_alignment }}">
    <div class="image-with-text__text__wrap
        {% if brightness < 190 and alpha > 0 %}inherit-colors{% endif %}
        {% if section.settings.image_width < 100 and section.settings.media_size == "contain" %}padded-block-y{% else %}padded-block{% endif %}
      ">
      {% if section.settings.subheading != blank %}
        <div class="feature-subheader" data-cc-animate="cc-fade-in-up" data-cc-animate-delay="0.1s">{{ section.settings.subheading }}</div>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="feature-header h2 align-{{ section.settings.text_alignment }}" data-cc-animate="cc-fade-in-up" data-cc-animate-delay="0.2s">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      <div class="rte align-{{ section.settings.text_alignment }}" data-cc-animate="cc-fade-in-up" data-cc-animate-delay="0.3s">{{ section.settings.text }}</div>

      {%- if section.settings.tags != blank -%}
        {%- assign tag_list = section.settings.tags | split: ',' -%}
        <ul class="tc-tags align-{{ section.settings.text_alignment }}" role="list" data-cc-animate="cc-fade-in-up" data-cc-animate-delay="0.35s">
          {%- for t in tag_list -%}
            {%- assign clean = t | strip -%}
            {%- if clean != blank -%}
              <li class="tc-tags__item">{{ clean | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {% if section.settings.button_label != blank or section.settings.button_label_2 != blank or section.settings.button_label_3 != blank %}
      <div class="button-row" data-cc-animate="cc-fade-in-up" data-cc-animate-delay="0.4s">

        {% if section.settings.button_label != blank %}
          {%- assign cta_1 = section.settings.data_cta -%}
          {% if section.settings.button_link != blank %}
            <a data-cc-animate-click class="{% if section.settings.button_style != 'auto' %}button-custom {% endif %}{% if section.settings.button_style == 'link' %}link-display {% else %}button {% if section.settings.button_style == 'secondary' %}alt{% endif %}{% endif %}" href="{{ section.settings.button_link }}"{% if cta_1 != blank %} data-cta="{{ cta_1 | escape }}"{% endif %}>{{ section.settings.button_label | escape }}</a>
          {% else %}
            <span class="{% if section.settings.button_style != 'auto' %}button-custom {% endif %}{% if section.settings.button_style == 'link' %}link-display {% else %}button {% if section.settings.button_style == 'secondary' %}alt{% endif %}{% endif %}"{% if cta_1 != blank %} data-cta="{{ cta_1 | escape }}"{% endif %}>{{ section.settings.button_label | escape }}</span>
          {% endif %}
        {% endif %}

        {% if section.settings.button_label_2 != blank %}
          {%- assign cta_2 = section.settings.data_cta_2 -%}
          {% if section.settings.button_link_2 != blank %}
            <a data-cc-animate-click class="{% if section.settings.button_style_2 != 'auto' %}button-custom {% endif %}{% if section.settings.button_style_2 == 'link' %}link-display {% else %}button {% if section.settings.button_style_2 == 'secondary' %}alt{% endif %}{% endif %}" href="{{ section.settings.button_link_2 }}"{% if cta_2 != blank %} data-cta="{{ cta_2 | escape }}"{% endif %}>{{ section.settings.button_label_2 | escape }}</a>
          {% else %}
            <span class="{% if section.settings.button_style_2 != 'auto' %}button-custom {% endif %}{% if section.settings.button_style_2 == 'link' %}link-display {% else %}button {% if section.settings.button_style_2 == 'secondary' %}alt{% endif %}{% endif %}"{% if cta_2 != blank %} data-cta="{{ cta_2 | escape }}"{% endif %}>{{ section.settings.button_label_2 | escape }}</span>
          {% endif %}
        {% endif %}

        {% if section.settings.button_label_3 != blank %}
          {%- assign href_3 = section.settings.button_link_3 | default: '#' -%}
          {%- assign cta_3 = section.settings.data_cta_3 -%}
          <a class="cm-smart-scroll {% if section.settings.button_style_3 != 'auto' %}button-custom {% endif %}{% if section.settings.button_style_3 == 'link' %}link-display {% else %}button {% if section.settings.button_style_3 == 'secondary' %}alt{% endif %}{% endif %}" href="{{ href_3 }}"{% if cta_3 != blank %} data-cta="{{ cta_3 | escape }}"{% endif %}>{{ section.settings.button_label_3 | escape }}</a>
        {% endif %}

      </div>
      {% endif %}
    </div>
  </div>

  {% if section.settings.image_position == 'right' %}{{ image_html }}{% endif %}

</div>

{% if section.settings.button_label_3 != blank %}
<script>
  (function () {
    var section = document.getElementById('section-id-{{ section.id }}');
    if (!section) return;
    var btn = section.querySelector('.cm-smart-scroll');
    if (!btn) return;

    function smallestContainerWithPrecedingHeading(formEl) {
      var cur = formEl;
      while (cur && cur.parentElement) {
        cur = cur.parentElement;
        if (cur.tagName === 'BODY' || cur.tagName === 'HTML') break;
        var headings = cur.querySelectorAll('h1, h2, h3, h4, h5, h6');
        for (var i = 0; i < headings.length; i++) {
          var pos = headings[i].compareDocumentPosition(formEl);
          if (pos & Node.DOCUMENT_POSITION_FOLLOWING) return cur;
        }
      }
      return formEl;
    }

    btn.addEventListener('click', function (e) {
      var href = btn.getAttribute('href') || '';
      var target = null;

      if (href.length > 1 && href.charAt(0) === '#') {
        try { target = document.querySelector(href); } catch (err) {}
      }

      if (!target) {
        var candidates = document.querySelectorAll(
          'form, [class*="form-builder"], [class*="formbuilder"], [data-form-id], [id^="form-"]'
        );
        for (var i = 0; i < candidates.length; i++) {
          var pos = section.compareDocumentPosition(candidates[i]);
          if (pos & Node.DOCUMENT_POSITION_FOLLOWING) { target = candidates[i]; break; }
        }
        if (target) target = smallestContainerWithPrecedingHeading(target);
      }

      if (!target) return;

      e.preventDefault();
      target.style.scrollMarginTop = '100px';
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(function () {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 600);
    });
  })();
</script>
{% endif %}

{% schema %}
  {
    "name": "Collection media",
    "class": "section-image-with-text",
    "settings": [
      { "type": "header", "content": "Text" },
      { "type": "text", "id": "subheading", "label": "Subheading" },
      { "type": "text", "id": "title", "label": "Heading", "default": "Collection name" },
      { "type": "range", "id": "title_size", "min": 16, "max": 100, "step": 2, "unit": "px", "label": "Heading text size", "default": 28 },
      { "type": "range", "id": "title_width", "min": 4, "max": 40, "step": 2, "unit": "em", "label": "Maximum heading width", "default": 12 },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this collection: what it does, who it's for, and any standards it meets.</p>" },
      { "type": "text", "id": "tags", "label": "Tags", "info": "Comma-separated, e.g. Antimicrobial, Easy-clean, Stain-resistant" },
      { "type": "text", "id": "button_label", "label": "Button", "default": "View colors" },
      { "type": "url", "id": "button_link", "label": "Button link" },
      { "type": "text", "id": "data_cta", "label": "Button tracking ID (data-cta)", "info": "Optional. GTM hook. Examples: view_collections, request_quote." },
      { "type": "text", "id": "button_label_2", "label": "Second button" },
      { "type": "url", "id": "button_link_2", "label": "Second button link" },
      { "type": "text", "id": "data_cta_2", "label": "Second button tracking ID (data-cta)", "info": "Optional. GTM hook." },
      {
        "type": "select", "id": "button_style_2", "label": "Second button style", "default": "secondary",
        "options": [
          { "label": "Button - primary",   "value": "primary" },
          { "label": "Button - secondary", "value": "secondary" },
          { "label": "Button - auto",      "value": "auto" },
          { "label": "Link",               "value": "link" }
        ]
      },
      { "type": "text", "id": "button_label_3", "label": "Third button (smart-scroll to form)" },
      {
        "type": "text", "id": "button_link_3", "label": "Third button link / anchor",
        "info": "Leave blank for smart auto-scroll to the form below. Or set #anchor-id to scroll to a specific element.",
        "default": "#"
      },
      { "type": "text", "id": "data_cta_3", "label": "Third button tracking ID (data-cta)", "info": "Optional. GTM hook. Examples: get_in_touch, speak_with_specialists." },
      {
        "type": "select", "id": "button_style_3", "label": "Third button style", "default": "primary",
        "options": [
          { "label": "Button - primary",   "value": "primary" },
          { "label": "Button - secondary", "value": "secondary" },
          { "label": "Button - auto",      "value": "auto" },
          { "label": "Link",               "value": "link" }
        ]
      },
      {
        "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left",
        "options": [
          { "label": "Left", "value": "left" },
          { "label": "Center", "value": "center" },
          { "label": "Right", "value": "right" }
        ]
      },
      { "type": "range", "id": "text_width", "min": 30, "max": 70, "step": 1, "unit": "%", "label": "Text width", "default": 50 },
      {
        "type": "select", "id": "button_style", "label": "Button style", "default": "auto",
        "options": [
          { "label": "Button - primary", "value": "primary" },
          { "label": "Button - secondary", "value": "secondary" },
          { "label": "Button - auto", "value": "auto" },
          { "label": "Link", "value": "link" }
        ]
      },
      { "type": "header", "content": "Media" },
      { "id": "image", "type": "image_picker", "label": "Image", "info": "If coupled with a video, it will show while the video is loading, or if it cannot autoplay." },
      { "id": "video_shopify", "type": "video", "label": "Video upload", "info": "Hosted by Shopify." },
      { "type": "number", "id": "color_count", "label": "Number of colors", "info": "Shown as a badge on the bottom-right of the image. Leave blank or 0 to hide." },
      { "type": "range", "id": "image_width", "min": 40, "max": 100, "step": 1, "unit": "%", "label": "Media scale", "default": 100 },
      {
        "type": "select", "id": "image_position", "label": "Media position", "default": "right",
        "options": [
          { "value": "right", "label": "Right" },
          { "value": "left",  "label": "Left" }
        ]
      },
      {
        "type": "select", "id": "media_size", "label": "Media size", "default": "cover",
        "options": [
          { "value": "cover",   "label": "Fill" },
          { "value": "contain", "label": "Natural" }
        ]
      },
      { "type": "header", "content": "Style" },
      {
        "type": "radio", "id": "color_scheme", "label": "Color scheme", "default": "standard",
        "options": [
          { "value": "standard", "label": "Standard" },
          { "value": "alt",      "label": "Alternate colors" },
          { "value": "custom",   "label": "Custom colors" }
        ]
      },
      { "type": "color", "id": "color_bg",   "label": "Custom background color" },
      { "type": "color", "id": "color_text", "label": "Custom text color" }
    ],
    "presets": [
      { "name": "Collection media", "settings": {} }
    ]
  }
{% endschema %}
