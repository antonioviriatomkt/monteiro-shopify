    "824869db-d95d-4e64-8e87-3a2785848477": {
      "type": "rich-text",
      "settings": {
        "subheading": "",
        "title": "",
        "title_size": 20,
        "title_width": 12,
        "heading_h1": false,
        "text": "<p>Internationally acclaimed interior designer <a href=\"https://www.niniandradesilva.com/en/\" target=\"_blank\" title=\"https://www.niniandradesilva.com/en/\"><strong>Nini Andrade Silva</strong></a> journeyed deep into the heart of the Amazon rainforest to create the inspiring narrative behind the new <em>Amazónia</em> collection, designed exclusively for Monteiro Fabrics. </p><p>Her design excellence has been recognized worldwide — most recently with the <a href=\"/blogs/news/savoy-palace-nini-andrade-silva\" target=\"_blank\" title=\"Savoy Palace, Nini Andrade Silva\"><strong>Savoy Palace Hotel in Madeira</strong>, which won the [World Travel Award for Europe’s Leading Luxury Hotel</a>] in 2024, a project that proudly featured Monteiro Fabrics’ coated fabrics.</p><p>Rooted in the vital essence of the Amazon, this collection is more than a showcase of exceptional design and aesthetics — it is a pledge to environmental responsibility and ecological awareness.</p>",
        "image": "shopify://shop_images/nini-andrade-amazonia-collection.png",
        "image_width": 170,
        "button_label": "",
        "button_link": "",
        "button_style": "auto",
        "text_alignment": "center",
        "enlarge_text": false,
        "full_width": true,
        "no_padding_bottom": false,
        "color_scheme": "standard",
        "color_bg": "",
        "color_text": ""
      }
    },
    "image_with_text_hA8gpn": {
      "type": "image-with-text",
      "settings": {
        "subheading": "Nini Andrade Silva",
        "title": "\"I draw inspiration from the landscape, the wind, and the land, delving into history and engaging with locals to uncover the true essence and roots of each place.\"",
        "title_size": 28,
        "title_width": 20,
        "text": "<p>Born in Funchal, Madeira, <a href=\"https://www.niniandradesilva.com/en/\" target=\"_blank\" title=\"https://www.niniandradesilva.com/en/\">Nini Andrade Silva</a> has elevated the legacy of Portuguese design onto the global stage, earning her place among the most prestigious names in international interior design. Her vision and talent have shaped iconic projects across the world, blending cultural authenticity with timeless sophistication.</p>",
        "button_label": "",
        "button_link": "",
        "text_alignment": "left",
        "text_width": 50,
        "button_style": "auto",
        "image": "shopify://shop_images/Nini-Andrade-fabrics.jpg",
        "image_width": 66,
