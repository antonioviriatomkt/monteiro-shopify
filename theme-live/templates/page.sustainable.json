        "heading_h1": false,
        "text": "<p>In Monteiro Fabrics we take responsibility for resource sustainability.</p>",
        "image_width": 230,
        "button_label": "",
        "button_link": "",
        "button_style": "auto",
        "text_alignment": "center",
