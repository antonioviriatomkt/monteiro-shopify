    "rich_text_JpbWDH": {
      "type": "rich-text",
      "name": "Rich text",
      "settings": {
        "subheading": "From Portugal to Frankfurt",
        "title": "Performance fabrics at Techtextil 26'",
        "title_size": 48,
        "title_width": 12,
        "heading_h1": false,
        "text": "<p>Monteiro Fabrics is exhibiting at Techtextil Frankfurt, 21–24 April 2026 — and this is your chance to see our high-performance coated fabrics up close. From antimicrobial healthcare upholstery and antistatic solutions to bio-based sustainable collections and flame-retardant contract fabrics, we bring over 55 years of Portuguese manufacturing expertise to every metre. All our fabrics are Made in Portugal, backed by a 10-year warranty. <strong>Visit us at Hall 11.0 · Stand A51 </strong>to explore the full range, request samples, and speak directly with our technical team.</p>",
        "image_width": 120,
        "button_label": "",
        "button_link": "",
        "button_style": "auto",
        "text_alignment": "left",
        "enlarge_text": true,
        "full_width": false,
        "no_padding_bottom": false,
        "color_scheme": "standard",
        "color_bg": "",
        "color_text": ""
      }
