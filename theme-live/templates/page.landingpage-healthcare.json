        "no_margins": false,
        "custom_liquid": "<!-- ============================================================ -->\n<!-- Healthcare LP — Download modals (Technical File + PDF)       -->\n<!-- Depends on Sender SDK already loaded sitewide in theme.liquid -->\n<!-- ============================================================ -->\n\n<!-- Mediflex — Technical File modal -->\n<div id=\"modal-tf-mediflex\" class=\"mf-modal\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-tf-mediflex-title\">\n  <div class=\"mf-modal__overlay\" data-mf-close-modal></div>\n  <div class=\"mf-modal__content\">\n    <button type=\"button\" class=\"mf-modal__close\" data-mf-close-modal aria-label=\"Close\">×</button>\n    <h3 id=\"modal-tf-mediflex-title\">Mediflex — Technical File</h3>\n    <p>Thanks for downloading the file. Please get in touch if you want a quote, additional information or if you have any questions.</p>\n    <div class=\"sender-form-field\" data-sender-form-id=\"e5Prqd\"></div>\n  </div>\n</div>\n\n<!-- Mediflex — PDF modal -->\n<div id=\"modal-pdf-mediflex\" class=\"mf-modal\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-pdf-mediflex-title\">\n  <div class=\"mf-modal__overlay\" data-mf-close-modal></div>\n  <div class=\"mf-modal__content\">\n    <button type=\"button\" class=\"mf-modal__close\" data-mf-close-modal aria-label=\"Close\">×</button>\n    <h3 id=\"modal-pdf-mediflex-title\">Mediflex — Download PDF</h3>\n    <p>Thanks for downloading the file. Please get in touch if you want a quote, additional information or if you have any questions.</p>\n    <div class=\"sender-form-field\" data-sender-form-id=\"eXDvAg\"></div>\n  </div>\n</div>\n\n<!-- Electra — Technical File modal -->\n<div id=\"modal-tf-electra\" class=\"mf-modal\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-tf-electra-title\">\n  <div class=\"mf-modal__overlay\" data-mf-close-modal></div>\n  <div class=\"mf-modal__content\">\n    <button type=\"button\" class=\"mf-modal__close\" data-mf-close-modal aria-label=\"Close\">×</button>\n    <h3 id=\"modal-tf-electra-title\">Electra — Technical File</h3>\n    <p>Thanks for downloading the file. Please get in touch if you want a quote, additional information or if you have any questions.</p>\n    <div class=\"sender-form-field\" data-sender-form-id=\"aM8KD1\"></div>\n  </div>\n</div>\n\n<!-- Electra — PDF modal -->\n<div id=\"modal-pdf-electra\" class=\"mf-modal\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-pdf-electra-title\">\n  <div class=\"mf-modal__overlay\" data-mf-close-modal></div>\n  <div class=\"mf-modal__content\">\n    <button type=\"button\" class=\"mf-modal__close\" data-mf-close-modal aria-label=\"Close\">×</button>\n    <h3 id=\"modal-pdf-electra-title\">Electra — Download PDF</h3>\n    <p>Thanks for downloading the file. Please get in touch if you want a quote, additional information or if you have any questions.</p>\n    <div class=\"sender-form-field\" data-sender-form-id=\"b2kPAz\"></div>\n  </div>\n</div>\n\n<style>\n  /* High specificity (body prefix + !important on layout-critical rules) so\n     the theme's stylesheet can't override the modal's positioning, overlay\n     or stacking context. */\n  body .mf-modal[hidden]{display:none !important}\n  body .mf-modal{position:fixed !important;top:0 !important;right:0 !important;bottom:0 !important;left:0 !important;z-index:2147483000 !important;display:flex !important;align-items:center !important;justify-content:center !important;padding:20px !important;margin:0 !important;width:auto !important;height:auto !important}\n  body .mf-modal__overlay{position:absolute !important;top:0 !important;right:0 !important;bottom:0 !important;left:0 !important;background:rgba(0,0,0,0.6) !important;cursor:pointer !important;z-index:0 !important}\n  body .mf-modal__content{position:relative !important;background:#fff !important;border-radius:8px !important;max-width:480px !important;width:100% !important;max-height:90vh !important;overflow-y:auto !important;padding:32px !important;box-shadow:0 20px 60px rgba(0,0,0,0.3) !important;z-index:1 !important}\n  body .mf-modal__close{position:absolute !important;top:12px !important;right:12px !important;background:transparent !important;border:0 !important;font-size:28px !important;line-height:1 !important;cursor:pointer !important;color:#666 !important;padding:4px 12px !important;width:auto !important;min-width:0 !important;box-shadow:none !important;z-index:2 !important}\n  body .mf-modal__close:hover{color:#000 !important}\n  body .mf-modal__content h3{margin:0 0 8px !important;font-size:20px !important;color:#202020 !important}\n  body .mf-modal__content p{margin:0 0 20px !important;color:#555 !important;font-size:14px !important}\n  body.mf-modal-open{overflow:hidden !important}\n  /* Pre-existing theme quirk: .button-custom is a <span>, so the cursor\n     defaults to text. Force pointer here for the technical-file CTAs. */\n  body .button-custom{cursor:pointer !important}\n</style>\n\n<script>\n(function(){\n  'use strict';\n\n  var rendered = {};\n\n  // -- Sender PDF redirect interceptor ----------------------------------\n  // Sender's post-submit redirect goes through window.location.{href|assign|\n  // replace}. While any of our modals is open, reroute redirects that look\n  // like PDF URLs into a new tab so the user stays on the LP.\n  function isPdfUrl(u){\n    return typeof u === 'string' && /\\.pdf($|\\?|#)/i.test(u);\n  }\n  function modalOpen(){\n    return document.body.classList.contains('mf-modal-open');\n  }\n  try {\n    var hrefDesc = Object.getOwnPropertyDescriptor(Location.prototype, 'href');\n    if (hrefDesc && hrefDesc.configurable && hrefDesc.set){\n      Object.defineProperty(Location.prototype, 'href', {\n        configurable: true,\n        enumerable: true,\n        get: hrefDesc.get,\n        set: function(value){\n          if (modalOpen() && isPdfUrl(value)){\n            window.open(value, '_blank', 'noopener,noreferrer');\n            return;\n          }\n          hrefDesc.set.call(this, value);\n        }\n      });\n    }\n  } catch (err){ /* some browsers disallow this; fall through */ }\n\n  var origAssign = Location.prototype.assign;\n  Location.prototype.assign = function(url){\n    if (modalOpen() && isPdfUrl(url)){\n      window.open(url, '_blank', 'noopener,noreferrer');\n      return;\n    }\n    return origAssign.call(this, url);\n  };\n  var origReplace = Location.prototype.replace;\n  Location.prototype.replace = function(url){\n    if (modalOpen() && isPdfUrl(url)){\n      window.open(url, '_blank', 'noopener,noreferrer');\n      return;\n    }\n    return origReplace.call(this, url);\n  };\n\n  // If Sender renders a PDF download link inside the modal (e.g., a \"Click\n  // here\" anchor on its success view), make sure it opens in a new tab too.\n  function newTabPdfLinksIn(modal){\n    var observer = new MutationObserver(function(){\n      modal.querySelectorAll('a[href*=\".pdf\"]').forEach(function(a){\n        a.setAttribute('target', '_blank');\n        a.setAttribute('rel', 'noopener noreferrer');\n      });\n    });\n    observer.observe(modal, { childList: true, subtree: true, attributes: true, attributeFilter: ['href'] });\n  }\n\n  // -- Modal lift / open / close ---------------------------------------\n  function liftModalsToBody(){\n    document.querySelectorAll('.mf-modal').forEach(function(m){\n      if (m.parentElement !== document.body) document.body.appendChild(m);\n      newTabPdfLinksIn(m);\n    });\n  }\n  function init(){\n    liftModalsToBody();\n  }\n  if (document.readyState === 'loading'){\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n\n  function renderSenderForm(formId){\n    if (rendered[formId]) return;\n    var tries = 0;\n    (function attempt(){\n      if (window.senderForms && typeof window.senderForms.render === 'function'){\n        try {\n          window.senderForms.render(formId);\n          rendered[formId] = true;\n        } catch (err){\n          console.error('senderForms.render failed for', formId, err);\n        }\n        return;\n      }\n      if (tries++ < 50) setTimeout(attempt, 100);\n    })();\n  }\n\n  function openModal(id){\n    var modal = document.getElementById('modal-' + id);\n    if (!modal) return;\n    modal.hidden = false;\n    document.body.classList.add('mf-modal-open');\n    var ph = modal.querySelector('[data-sender-form-id]');\n    if (ph) renderSenderForm(ph.getAttribute('data-sender-form-id'));\n\n    // GTM hook — fired once per modal open. id is \"tf-mediflex\" / \"pdf-electra\" / etc.\n    var parts = id.split('-'); // ['tf'|'pdf', 'mediflex'|'electra']\n    window.dataLayer = window.dataLayer || [];\n    window.dataLayer.push({\n      event: 'mf_modal_open',\n      collection: parts[1] || null,\n      asset_type: parts[0] === 'tf' ? 'technical_file' : 'catalogue',\n      source_page: 'lp_healthcare'\n    });\n  }\n\n  function closeAllModals(){\n    document.querySelectorAll('.mf-modal').forEach(function(m){ m.hidden = true; });\n    document.body.classList.remove('mf-modal-open');\n  }\n\n  // -- Click delegation ------------------------------------------------\n  document.addEventListener('click', function(e){\n    var closeTarget = e.target.closest('[data-mf-close-modal]');\n    if (closeTarget){\n      closeAllModals();\n      return;\n    }\n    var el = e.target.closest('a, button, span, [role=\"button\"]');\n    if (!el) return;\n    var text = (el.textContent || '').trim().toUpperCase();\n    var modalType = null;\n    if (text === 'DOWNLOAD TECHNICAL FILE') modalType = 'tf';\n    else if (text === 'DOWNLOAD PDF')       modalType = 'pdf';\n    if (!modalType) return;\n\n    var node = el;\n    var collection = null;\n    while (node && node !== document.body){\n      var h = node.querySelector ? node.querySelector('h1,h2,h3,h4') : null;\n      if (h){\n        var txt = (h.textContent || '').toUpperCase();\n        if (txt.indexOf('MEDIFLEX') !== -1){ collection = 'mediflex'; break; }\n        if (txt.indexOf('ELECTRA')  !== -1){ collection = 'electra';  break; }\n      }\n      node = node.parentElement;\n    }\n    if (!collection) return;\n\n    e.preventDefault();\n    e.stopPropagation();\n    el.setAttribute('data-cta', 'download_' + modalType + '_' + collection);\n    openModal(modalType + '-' + collection);\n  }, true);\n\n  document.addEventListener('keydown', function(e){\n    if ((e.key === 'Escape' || e.keyCode === 27) && document.querySelector('.mf-modal:not([hidden])')){\n      closeAllModals();\n    }\n  });\n})();\n</script>"
