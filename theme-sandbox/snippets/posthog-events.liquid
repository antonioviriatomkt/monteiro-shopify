{%- comment -%}
  PostHog custom events — Monteiro Fabrics (2026-10-09).
  Rendered in layout/theme.liquid right after posthog.init.
  Events: sample_requested · catalogue_downloaded · technical_file_requested · lead_submitted
  Also: super properties on every event, and PostHog distinct_id + entry UTMs written to the
  cart as attributes so €0 sample orders can be tied back to their source.
  Vault: WORK/Clients/Monteiro-Fabrics/projects/posthog-uso-completo.md
{%- endcomment -%}
<script>
(function () {
  if (!window.posthog) return;
  /* Always go through window.posthog at call time (never a cached reference), and never capture
     before the library has loaded: whenReady() runs now if loaded, otherwise queues the call and
     flushes it from onFeatureFlags or a short poll (15 s max). */
  function P() { return window.posthog; }
  function isReady() { var p = P(); return !!(p && p.__loaded && typeof p.capture === 'function'); }
  var queue = [], timer = null;
  function flush() {
    if (!isReady()) return false;
    queue.splice(0).forEach(function (fn) { try { fn(); } catch (e) {} });
    return true;
  }
  function whenReady(fn) {
    if (isReady()) { try { fn(); } catch (e) {} return; }
    queue.push(fn);
    if (timer) return;
    var n = 0;
    timer = setInterval(function () { if (flush() || ++n > 150) { clearInterval(timer); timer = null; } }, 100);
  }
  try { P().onFeatureFlags(flush); } catch (e) {}
  /* capture helper; opts e.g. { transport: 'sendBeacon' } for events fired as the page unloads */
  function cap(name, props, opts) { whenReady(function () { P().capture(name, props, opts); }); }

  /* Super properties: sent with every event from here on. */
  whenReady(function () {
    P().register({
      mf_locale: {{ request.locale.iso_code | json }},
      mf_country: {{ localization.country.iso_code | json }},
      mf_template: {{ template.name | json }}{% if template.suffix != blank %},
      mf_template_suffix: {{ template.suffix | json }}{% endif %}
    });
  });

  function sectorFromPath() {
    var m = location.pathname.match(/\/collections\/([^\/]+)/);
    return m ? m[1] : null;
  }
  function productCtx() {
    {%- if product -%}
    return { product_handle: {{ product.handle | json }}, product_title: {{ product.title | json }}, product_type: {{ product.type | json }} };
    {%- else -%}
    return {};
    {%- endif -%}
  }
  function findVariant(variantId) {
    var nodes = document.querySelectorAll('script[id^="cc-product-json-"]');
    for (var i = 0; i < nodes.length; i++) {
      try {
        var p = JSON.parse(nodes[i].textContent);
        for (var j = 0; j < p.variants.length; j++) {
          if (String(p.variants[j].id) === String(variantId)) return { product: p, variant: p.variants[j] };
        }
      } catch (e) {}
    }
    return null;
  }
  function fileName(href) {
    try { return decodeURIComponent(new URL(href, location.href).pathname.split('/').pop()); } catch (e) { return href; }
  }
  /* Entry source for this browser session (first page of the session wins). */
  var ENTRY_KEY = 'mf_entry_v1';
  (function rememberEntry() {
    try {
      if (sessionStorage.getItem(ENTRY_KEY)) return;
      var q = new URLSearchParams(location.search), e = {};
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid'].forEach(function (k) {
        if (q.get(k)) e[k] = q.get(k).slice(0, 200);
      });
      if (document.referrer) {
        try { var h = new URL(document.referrer).hostname; if (h !== location.hostname) e.referrer = h; } catch (x) {}
      }
      e.landing = location.pathname;
      sessionStorage.setItem(ENTRY_KEY, JSON.stringify(e));
    } catch (x) {}
  })();
  function entry() {
    try { return JSON.parse(sessionStorage.getItem(ENTRY_KEY) || '{}'); } catch (x) { return {}; }
  }
  var cartTagged = false;
  function tagCart() {
    if (cartTagged) return;
    whenReady(function () {
      if (cartTagged) return;
      cartTagged = true;
      try {
        var attrs = { ph_distinct_id: P().get_distinct_id(), ph_session_id: P().get_session_id() };
        var e = entry();
        Object.keys(e).forEach(function (k) { attrs['ph_' + k] = e[k]; });
        fetch('{{ routes.cart_update_url }}.js', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: attrs }), keepalive: true
        });
      } catch (e) {}
    });
  }

  document.addEventListener('click', function (ev) {
    var el = ev.target.closest && ev.target.closest('button[name="add"], a[href]');
    if (!el) return;

    /* Sample / physical catalogue added to cart */
    if (el.matches('button[name="add"]')) {
      var form = el.form || el.closest('form');
      var vid = form ? new FormData(form).get('id') : null;
      var hit = vid ? findVariant(vid) : null;
      var props = Object.assign({}, productCtx(), { sector: sectorFromPath(), variant_id: vid });
      if (hit) {
        props.product_handle = hit.product.handle;
        props.product_title = hit.product.title;
        props.colour = hit.variant.title;
        props.kind = /catal/i.test(hit.variant.title + ' ' + hit.product.title) ? 'physical_catalogue' : 'sample';
      }
      cap('sample_requested', props);
      tagCart();
      return;
    }

    var href = el.getAttribute('href') || '';
    /* Technical file (Sender form) */
    if (href.indexOf('stats.sender.net/forms') !== -1) {
      var fid = (href.match(/forms\/([^\/?#]+)/) || [])[1] || null;
      cap('technical_file_requested', Object.assign({}, productCtx(), { sender_form: fid, sector: sectorFromPath() }), { transport: 'sendBeacon' });
      return;
    }
    /* Catalogue PDF / Dropbox */
    if (/\.pdf(\?|#|$)|dropbox\.com/i.test(href)) {
      cap('catalogue_downloaded', Object.assign({}, productCtx(), { file: fileName(href), sector: sectorFromPath() }), { transport: 'sendBeacon' });
      return;
    }
    /* Physical catalogue via direct cart link */
    if (/\/cart\/add\?id=/.test(href)) {
      cap('sample_requested', Object.assign({}, productCtx(), { kind: 'physical_catalogue', variant_id: (href.match(/id=(\d+)/) || [])[1] }), { transport: 'sendBeacon' });
      tagCart();
    }
  }, true);

  /* Contact + newsletter forms (native Shopify contact form: POST, full page reload).
     The request must survive the unload, hence transport sendBeacon. */
  var SENT_KEY = 'mf_lead_sent', EMAIL_KEY = 'mf_lead_email';
  document.addEventListener('submit', function (ev) {
    var f = ev.target;
    if (!f || !f.matches || !f.matches('form[action*="/contact"]')) return;
    var fd = new FormData(f);
    var email = (fd.get('contact[email]') || '').trim().toLowerCase();
    var isNewsletter = (fd.get('contact[tags]') || '').indexOf('newsletter') !== -1 || f.id === 'footer_newsletter_signup';
    var props = { form: isNewsletter ? 'newsletter' : 'contact', form_id: f.id || null, page: location.pathname };
    if (email) {
      props.email_domain = email.split('@')[1] || null;
      /* identify() is not sent by beacon: remember the email so the return page can (re)identify. */
      try { sessionStorage.setItem(EMAIL_KEY, email); } catch (e) {}
    }
    if (!isReady()) return;   /* not loaded yet: the contact_posted return fallback covers it */
    if (email) P().identify(email, { email: email });
    P().capture('lead_submitted', props, { transport: 'sendBeacon' });
    try { sessionStorage.setItem(SENT_KEY, '1'); } catch (e) {}
  }, true);

  /* Return from the native POST (/pages/contact?contact_posted=true): identify, and fall back to
     capturing the lead if the submit-time beacon never ran. The flag stops refresh duplicates. */
  if (/[?&]contact_posted=true(&|$)/.test(location.search)) {
    whenReady(function () {
      var email = null, sent = false;
      try { email = sessionStorage.getItem(EMAIL_KEY); sessionStorage.removeItem(EMAIL_KEY); } catch (e) {}
      if (email) { try { P().identify(email, { email: email }); } catch (e) {} }
      try { sent = !!sessionStorage.getItem(SENT_KEY); } catch (e) {}
      if (sent) return;
      var props = {
        form: location.hash === '#footer_newsletter_signup' ? 'newsletter' : 'contact',
        form_id: location.hash ? location.hash.slice(1) : null,
        page: location.pathname, source: 'contact_posted_return'
      };
      if (email) props.email_domain = email.split('@')[1] || null;
      P().capture('lead_submitted', props);
      try { sessionStorage.setItem(SENT_KEY, '1'); } catch (e) {}
    });
  }
})();
</script>
