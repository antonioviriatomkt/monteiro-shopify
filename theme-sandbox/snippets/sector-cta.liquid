{%- comment -%}
  Sector CTA — conversion block above the product grid on the sector landing pages of the Google Ads
  sector campaigns (C1–C4). Built 2026-10-21, fix 2 of the landing-page audit:
  WORK/Clients/Monteiro-Fabrics/paid-advertising/2026-09_sector-campaigns/5-landing-pages-audit-2026-10-21.md
  Rendered by sections/main-collection.liquid when its setting `show_sector_cta` is on (off by default).
  All text comes from locales: collections.sector_cta.*
  ⚠️ 10-year warranty and stock service do NOT cover every product (António, 21/10) — they stay
  qualified "on stock-service fabrics". Never make either a general claim here.
{%- endcomment -%}
{%- liquid
  if routes.root_url == '/'
    assign contact_url = '/pages/contact'
  else
    assign contact_url = routes.root_url | append: '/pages/contact'
  endif
-%}
<style>
  .sector-cta{ --sc-rule:#dbdbdb; --sc-muted:#464654; margin: 8px 0 20px; }
  .sector-cta__box{ display:flex; flex-direction:column; align-items:center; gap:20px; max-width:1120px; margin:0 auto;
    border-top:1px solid var(--sc-rule); border-bottom:1px solid var(--sc-rule); padding:22px 0; text-align:center; }
  .sector-cta__proof{ order:1; list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; justify-content:center; gap:14px 40px; }
  .sector-cta__item{ display:flex; gap:9px; align-items:flex-start; margin:0; padding:0; min-width:0; text-align:left; }
  .sector-cta__item::before{ content:none; }
  .sector-cta__icon{ flex:none; width:20px; height:20px; margin-top:1px; stroke:var(--sc-muted); fill:none;
    stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .sector-cta__title{ display:block; font-weight:600; font-size:15px; line-height:1.3; }
  .sector-cta__note{ display:block; font-size:13px; line-height:1.3; color:var(--sc-muted); }
  .sector-cta__actions{ order:2; display:flex; justify-content:center; gap:12px; }
  .sector-cta__actions .button{ margin:0; white-space:nowrap; }
  .sector-cta__hint{ order:3; margin:-6px 0 0; font-size:14px; line-height:1.4; color:var(--sc-muted); text-align:center; scroll-margin-top:110px; }
  @media (max-width: 1023px){
    .sector-cta__box{ align-items:stretch; }
    .sector-cta__actions{ order:0; }
    .sector-cta__actions .button{ flex:1 1 0; text-align:center; }
    .sector-cta__hint{ margin-top:0; }
  }
  @media (max-width: 767px){
    .sector-cta{ margin-top:0; }
    .sector-cta__box{ gap:14px; padding:14px 0; }
    .sector-cta__proof{ display:grid; grid-template-columns:1fr 1fr; gap:10px 14px; }
    .sector-cta__title{ font-size:14px; }
    .sector-cta__note{ font-size:12px; }
    .sector-cta__actions{ gap:8px; }
    .sector-cta__actions .button{ padding-left:10px; padding-right:10px; font-size:13px; white-space:normal; }
    .sector-cta__hint{ font-size:13px; text-align:left; }
  }
</style>
<div class="sector-cta wide-container" data-sector-cta>
  <div class="sector-cta__box">
    <ul class="sector-cta__proof" role="list">
      <li class="sector-cta__item">
        <svg class="sector-cta__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
        <span><span class="sector-cta__title">{{ 'collections.sector_cta.samples' | t }}</span></span>
      </li>
      <li class="sector-cta__item">
        <svg class="sector-cta__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2.5"/></svg>
        <span><span class="sector-cta__title">{{ 'collections.sector_cta.stock' | t }}</span><span class="sector-cta__note">{{ 'collections.sector_cta.stock_note' | t }}</span></span>
      </li>
      <li class="sector-cta__item">
        <svg class="sector-cta__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="1"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/></svg>
        <span><span class="sector-cta__title">{{ 'collections.sector_cta.warranty' | t }}</span><span class="sector-cta__note">{{ 'collections.sector_cta.stock_note' | t }}</span></span>
      </li>
      <li class="sector-cta__item">
        <svg class="sector-cta__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
        <span><span class="sector-cta__title">{{ 'collections.sector_cta.iso' | t }}</span><span class="sector-cta__note">{{ 'collections.sector_cta.iso_note' | t }}</span></span>
      </li>
      <li class="sector-cta__item">
        <svg class="sector-cta__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.5-6.5-11a6.5 6.5 0 0 1 13 0c0 5.5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
        <span><span class="sector-cta__title">{{ 'collections.sector_cta.made_in' | t }}</span><span class="sector-cta__note">{{ 'collections.sector_cta.made_in_note' | t }}</span></span>
      </li>
    </ul>
    <div class="sector-cta__actions">
      <a class="button hover-grow" href="#sector-cta-samples" data-cta="sector_order_samples">{{ 'collections.sector_cta.order_samples' | t }}</a>
      <a class="button alt hover-grow" href="{{ contact_url }}" data-cta="sector_talk_specialist">{{ 'collections.sector_cta.talk_specialist' | t }}</a>
    </div>
    <p class="sector-cta__hint" id="sector-cta-samples">{{ 'collections.sector_cta.hint' | t }}</p>
  </div>
</div>
<script>
  (function () {
    /* "Order free samples" scrolls to the product grid (past the filters); the href falls back to the hint. */
    var btn = document.querySelector('[data-sector-cta] [data-cta="sector_order_samples"]');
    if (!btn) return;
    btn.addEventListener('click', function (e) {
      var grid = document.querySelector('.product-list-container .product-list') || document.querySelector('.product-list-container');
      if (!grid) return;
      e.preventDefault();
      grid.style.scrollMarginTop = '110px';
      grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>
