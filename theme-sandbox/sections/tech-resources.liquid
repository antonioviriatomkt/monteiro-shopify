{% comment %}
  Technical Hub — resource library of technical articles + white papers.
  SEO: semantic <article> cards with <h3><a> descriptive anchors, plus an
  ItemList JSON-LD enumerating every linked resource (pillar→spoke cluster).
  Blocks: resource { kind, tag, title, excerpt, meta, link, cta_label }.
{% endcomment %}

<div class="section-tech-resources" data-section-type="tech-resources"
     style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  {% assign accent = section.settings.accent %}
  {% style %}
    #tr-{{ section.id }} .tr-head { text-align: center; max-width: 720px; margin: 0 auto 48px; }
    #tr-{{ section.id }} .tr-eyebrow { letter-spacing: 0.12em; text-transform: uppercase; font-size: 13px; color: {{ accent }}; font-weight: 600; margin-bottom: 12px; }
    #tr-{{ section.id }} .tr-title { font-size: 38px; font-weight: 400; line-height: 1.15; margin: 0; }
    #tr-{{ section.id }} .tr-intro { margin-top: 16px; opacity: 0.8; font-size: 17px; line-height: 1.6; }
    #tr-{{ section.id }} .tr-intro p { margin: 0; }

    #tr-{{ section.id }} .tr-featured { display: grid; grid-template-columns: 1.1fr 1fr; gap: 0; border-radius: 0; overflow: hidden; margin-bottom: 32px; background: {{ accent }}; color: #fff; }
    #tr-{{ section.id }} .tr-featured .tr-feat-body { padding: 44px; display: flex; flex-direction: column; justify-content: center; }
    #tr-{{ section.id }} .tr-feat-kicker { letter-spacing: 0.1em; text-transform: uppercase; font-size: 12px; opacity: 0.85; margin-bottom: 14px; }
    #tr-{{ section.id }} .tr-feat-title { font-size: 28px; line-height: 1.2; margin: 0 0 14px; font-weight: 500; text-align: left; }
    #tr-{{ section.id }} .tr-feat-title a { color: #fff; text-decoration: none; }
    #tr-{{ section.id }} .tr-feat-excerpt { font-size: 16px; line-height: 1.6; opacity: 0.9; margin: 0 0 26px; }
    #tr-{{ section.id }} .tr-feat-cta { align-self: flex-start; display: inline-block; padding: 14px 28px; background: #fff; color: {{ accent }}; text-decoration: none; font-weight: 600; letter-spacing: 0.02em; border-radius: 0; transition: opacity .2s; }
    #tr-{{ section.id }} .tr-feat-cta:hover { opacity: 0.85; }
    #tr-{{ section.id }} .tr-feat-side { background: rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center; padding: 32px; }
    #tr-{{ section.id }} .tr-feat-meta { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8; border: 1px solid rgba(255,255,255,0.35); border-radius: 0; padding: 10px 18px; }

    #tr-{{ section.id }} .tr-grid { display: grid; grid-template-columns: repeat({{ section.settings.columns }}, 1fr); gap: 24px; }
    #tr-{{ section.id }} .tr-card { display: flex; flex-direction: column; background: {{ section.settings.card_bg }}; border: 1px solid {{ section.settings.line_color }}; border-radius: 0; padding: 28px; transition: transform .2s, box-shadow .2s; }
    #tr-{{ section.id }} .tr-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.07); }
    #tr-{{ section.id }} .tr-tag { display: inline-block; align-self: flex-start; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; color: {{ accent }}; background: {{ accent | append: '14' }}; border-radius: 0; padding: 5px 12px; margin-bottom: 16px; }
    #tr-{{ section.id }} .tr-card h3 { font-size: 20px; line-height: 1.3; font-weight: 500; margin: 0 0 10px; text-align: left; }
    #tr-{{ section.id }} .tr-card h3 a { color: inherit; text-decoration: none; }
    #tr-{{ section.id }} .tr-card h3 a:hover { color: {{ accent }}; }
    #tr-{{ section.id }} .tr-card p { font-size: 15px; line-height: 1.6; opacity: 0.8; margin: 0 0 20px; }
    #tr-{{ section.id }} .tr-card-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }
    #tr-{{ section.id }} .tr-read { font-weight: 600; font-size: 15px; color: {{ accent }}; text-decoration: none; }
    #tr-{{ section.id }} .tr-read:hover { text-decoration: underline; }
    #tr-{{ section.id }} .tr-meta { font-size: 13px; opacity: 0.6; }

    #tr-{{ section.id }} .tr-all { text-align: center; margin-top: 40px; }
    #tr-{{ section.id }} .tr-all a { display: inline-block; padding: 15px 32px; border: 1px solid {{ section.settings.text_color }}; color: {{ section.settings.text_color }}; text-decoration: none; letter-spacing: 0.03em; transition: background-color .25s, color .25s; }
    #tr-{{ section.id }} .tr-all a:hover { background: {{ section.settings.text_color }}; color: {{ section.settings.bg_color }}; }

    @media (max-width: 900px) { #tr-{{ section.id }} .tr-grid { grid-template-columns: 1fr 1fr; } #tr-{{ section.id }} .tr-featured { grid-template-columns: 1fr; } #tr-{{ section.id }} .tr-feat-side { order: -1; min-height: 120px; } }
    @media (max-width: 600px) { #tr-{{ section.id }} .tr-grid { grid-template-columns: 1fr; } #tr-{{ section.id }} .tr-title { font-size: 30px; } #tr-{{ section.id }} .tr-featured .tr-feat-body { padding: 32px; } }
  {% endstyle %}

  <div id="tr-{{ section.id }}" class="wide-container half-gutter section-spacing">
    {% if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.intro != blank %}
      <div class="tr-head" data-cc-animate>
        {% if section.settings.eyebrow != blank %}<div class="tr-eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
        {% if section.settings.title != blank %}<h2 class="tr-title">{{ section.settings.title | escape }}</h2>{% endif %}
        {% if section.settings.intro != blank %}<div class="tr-intro">{{ section.settings.intro }}</div>{% endif %}
      </div>
    {% endif %}

    {%- comment -%} Featured white papers first {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.kind == 'white-paper' -%}
        <article class="tr-featured" {{ block.shopify_attributes }} data-cc-animate>
          <div class="tr-feat-body">
            <div class="tr-feat-kicker">{{ block.settings.tag | default: 'White paper' | escape }}</div>
            <h3 class="tr-feat-title">{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>{% else %}{{ block.settings.title | escape }}{% endif %}</h3>
            {% if block.settings.excerpt != blank %}<p class="tr-feat-excerpt">{{ block.settings.excerpt | escape }}</p>{% endif %}
            {% if block.settings.link != blank %}<a class="tr-feat-cta" href="{{ block.settings.link }}">{{ block.settings.cta_label | default: 'Download the guide' | escape }}</a>{% endif %}
          </div>
          <div class="tr-feat-side">
            {% if block.settings.meta != blank %}<span class="tr-feat-meta">{{ block.settings.meta | escape }}</span>{% endif %}
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Article / guide grid {%- endcomment -%}
    <div class="tr-grid">
      {%- for block in section.blocks -%}
        {%- unless block.settings.kind == 'white-paper' -%}
          <article class="tr-card" {{ block.shopify_attributes }} data-cc-animate="cc-fade-in-up" data-cc-animate-delay="{{ forloop.index0 | times: 0.06 | append: 's' }}">
            {% if block.settings.tag != blank %}<span class="tr-tag">{{ block.settings.tag | escape }}</span>{% endif %}
            <h3>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>{% else %}{{ block.settings.title | escape }}{% endif %}</h3>
            {% if block.settings.excerpt != blank %}<p>{{ block.settings.excerpt | escape }}</p>{% endif %}
            <div class="tr-card-foot">
              {% if block.settings.link != blank %}<a class="tr-read" href="{{ block.settings.link }}">{{ block.settings.cta_label | default: 'Read article' | escape }} →</a>{% else %}<span class="tr-read" style="opacity:0.5">{{ block.settings.cta_label | default: 'Read article' | escape }}</span>{% endif %}
              {% if block.settings.meta != blank %}<span class="tr-meta">{{ block.settings.meta | escape }}</span>{% endif %}
            </div>
          </article>
        {%- endunless -%}
      {%- endfor -%}
    </div>

    {% if section.settings.all_label != blank and section.settings.all_link != blank %}
      <div class="tr-all" data-cc-animate>
        <a href="{{ section.settings.all_link }}">{{ section.settings.all_label | escape }}</a>
      </div>
    {% endif %}
  </div>
</div>

{%- comment -%} ItemList structured data for the resource hub {%- endcomment -%}
{%- if section.settings.emit_itemlist -%}
  {%- assign pos = 0 -%}
  {%- capture itemlist_items -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.link != blank and block.settings.title != blank -%}
        {%- assign pos = pos | plus: 1 -%}
        {%- assign u = block.settings.link -%}
        {%- unless u contains '://' -%}{%- assign u = shop.url | append: u -%}{%- endunless -%}
        {%- if pos > 1 -%},{%- endif -%}
        {"@type":"ListItem","position":{{ pos }},"name":{{ block.settings.title | json }},"url":{{ u | json }}}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if pos > 0 -%}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"ItemList","name":{{ section.settings.list_name | default: 'Technical Hub' | json }},"itemListElement":[{{ itemlist_items }}]}
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
  {
    "name": "Technical resources",
    "class": "section-tech-resources-wrap",
    "max_blocks": 9,
    "settings": [
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Technical Hub" },
      { "type": "text", "id": "title", "label": "Heading", "default": "Technical resources" },
      { "type": "richtext", "id": "intro", "label": "Intro text" },
      { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Article cards per row", "default": 3 },
      { "type": "header", "content": "Browse all" },
      { "type": "text", "id": "all_label", "label": "Browse-all label", "default": "Browse all technical articles" },
      { "type": "url", "id": "all_link", "label": "Browse-all link" },
      { "type": "header", "content": "Colours" },
      { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
      { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
      { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FAFAF8" },
      { "type": "color", "id": "line_color", "label": "Card border", "default": "#E6E6E2" },
      { "type": "color", "id": "accent", "label": "Accent", "default": "#2F519B" },
      { "type": "header", "content": "SEO" },
      { "type": "checkbox", "id": "emit_itemlist", "label": "Emit ItemList structured data", "default": true },
      { "type": "text", "id": "list_name", "label": "ItemList name", "default": "Monteiro Technical Hub" }
    ],
    "blocks": [
      {
        "type": "resource",
        "name": "Resource",
        "settings": [
          {
            "type": "select",
            "id": "kind",
            "label": "Type",
            "default": "article",
            "options": [
              { "value": "white-paper", "label": "White paper (featured)" },
              { "value": "guide", "label": "Guide" },
              { "value": "article", "label": "Article" }
            ]
          },
          { "type": "text", "id": "tag", "label": "Category tag", "default": "Fabric guidance" },
          { "type": "text", "id": "title", "label": "Title" },
          { "type": "textarea", "id": "excerpt", "label": "Excerpt" },
          { "type": "text", "id": "meta", "label": "Meta (read time / format)", "default": "5 min read" },
          { "type": "url", "id": "link", "label": "Link" },
          { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Read article" }
        ]
      }
    ],
    "presets": [
      { "name": "Technical resources", "blocks": [ { "type": "resource" }, { "type": "resource" }, { "type": "resource" } ] }
    ]
  }
{% endschema %}
