{% comment %} Ads LP — FAQ (2026-10-29). Native <details>; no FAQ JSON-LD (ads pages are noindex). {% endcomment %}
{{ 'ads-lp.css' | asset_url | stylesheet_tag }}

<section class="ads-lp ads-lp-faq ads-lp__section">
  <div class="ads-lp__wrap">
    {% if section.settings.eyebrow != blank %}<div class="ads-lp__eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
    <h2 class="ads-lp__h2">{{ section.settings.heading | escape }}</h2>
    <div class="ads-lp-faq__list">
      {% for block in section.blocks %}
        <details class="ads-lp-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="ads-lp-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ads LP — FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions from trade buyers" }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ] }
  ],
  "presets": [ { "name": "Ads LP — FAQ" } ]
}
{% endschema %}
