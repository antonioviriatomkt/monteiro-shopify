{% comment %}
  Ads LP — collection cards (2026-10-29). Image + name + up to three facts per card (facts typed
  from the KB, never pulled from product data). "Add to request" ticks the matching chip in the
  request form (sections/ads-lp-request.liquid) — no link out, no cart.
{% endcomment %}
{{ 'ads-lp.css' | asset_url | stylesheet_tag }}

<section class="ads-lp ads-lp-cols ads-lp__section{% if section.settings.background == 'soft' %} ads-lp__section--soft{% endif %}">
  <div class="ads-lp__wrap">
    {% if section.settings.eyebrow != blank %}<div class="ads-lp__eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
    {% if section.settings.heading != blank %}<h2 class="ads-lp__h2">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.intro != blank %}<div class="ads-lp__intro">{{ section.settings.intro }}</div>{% endif %}

    <ul class="ads-lp-cols__grid">
      {% for block in section.blocks %}
        {%- assign p = all_products[block.settings.product] -%}
        {%- assign name = block.settings.title | default: p.title -%}
        {%- assign key = block.settings.request_value | default: name -%}
        <li class="ads-lp-cols__card" {{ block.shopify_attributes }}>
          <div class="ads-lp-cols__img">
            {%- assign img = block.settings.image | default: p.featured_image -%}
            {% if img != blank %}
              {{ img | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 100vw, 33vw', widths: '400, 600, 800', alt: name }}
            {% endif %}
          </div>
          <div class="ads-lp-cols__body">
            <h3 class="ads-lp-cols__name">{{ name | escape }}</h3>
            <ul class="ads-lp-cols__facts">
              {% if block.settings.fact_1 != blank %}<li>{{ block.settings.fact_1 | escape }}</li>{% endif %}
              {% if block.settings.fact_2 != blank %}<li>{{ block.settings.fact_2 | escape }}</li>{% endif %}
              {% if block.settings.fact_3 != blank %}<li>{{ block.settings.fact_3 | escape }}</li>{% endif %}
            </ul>
            <button type="button" class="ads-lp__btn ads-lp__btn--ghost ads-lp-cols__add" aria-pressed="false"
                    data-ads-lp-add="{{ key | escape }}"
                    data-label-on="{{ section.settings.added_label | escape }}">{{ section.settings.add_label | escape }}</button>
          </div>
        </li>
      {% endfor %}
    </ul>
    {% if section.settings.note != blank %}<p class="ads-lp-cols__note">{{ section.settings.note | escape }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Ads LP — collections",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "default": "white",
      "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Light grey" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "add_label", "label": "Button label", "default": "Add to sample request" },
    { "type": "text", "id": "added_label", "label": "Button label when added", "default": "Added to request ✓" },
    { "type": "text", "id": "note", "label": "Footnote" }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [
      { "type": "product", "id": "product", "label": "Product (image + name)" },
      { "type": "image_picker", "id": "image", "label": "Image (overrides the product image)" },
      { "type": "text", "id": "title", "label": "Name (overrides the product title)" },
      { "type": "text", "id": "fact_1", "label": "Fact 1 (KB only)" },
      { "type": "text", "id": "fact_2", "label": "Fact 2 (KB only)" },
      { "type": "text", "id": "fact_3", "label": "Fact 3 (KB only)" },
      { "type": "text", "id": "request_value", "label": "Form value", "info": "Must match a line in the request form's collection list. Defaults to the name." }
    ] }
  ],
  "presets": [ { "name": "Ads LP — collections" } ]
}
{% endschema %}
