{{ 'official-resellers.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign resellers = shop.metaobjects.reseller.values
-%}

<section
  class="official-resellers"
  style="
    --or-bg: {{ section.settings.background }};
    --or-fg: {{ section.settings.text_color }};
    --or-muted: {{ section.settings.muted_color }};
    --or-card-bg: {{ section.settings.card_background }};
    --or-card-border: {{ section.settings.card_border }};
    --or-pad-top: {{ section.settings.padding_top }}px;
    --or-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="official-resellers__inner">
    {%- if resellers.size > 0 -%}
      <ul class="official-resellers__grid" role="list">
        {%- for r in resellers -%}
          <li class="official-resellers__item">
            <a
              class="reseller-card"
              {% if r.website.value != blank %}href="{{ r.website.value }}" target="_blank" rel="noopener noreferrer"{% endif %}
            >
              <div class="reseller-card__logo">
                {%- if r.logo.value -%}
                  {{ r.logo.value | image_url: width: 480 | image_tag:
                       loading: 'lazy',
                       alt: r.name.value,
                       widths: '180,280,480',
                       sizes: '(max-width: 600px) 40vw, (max-width: 1000px) 28vw, 220px'
                  }}
                {%- endif -%}
              </div>
              <h3 class="reseller-card__name">{{ r.name.value }}</h3>
              {%- if r.country.value != blank -%}
                <p class="reseller-card__country">{{ r.country.value }}</p>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="official-resellers__empty">
        No resellers yet. Add entries under <em>Content → Metaobjects → Resellers</em>.
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Official Resellers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text (country)",
      "default": "#6B6B6B"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#E5E5E5"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Official Resellers"
    }
  ]
}
{% endschema %}
