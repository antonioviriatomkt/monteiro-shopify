{% comment %}
  Contact block — two-column direct-contact layout: B2B qualifying form (left)
  + a concise "reach us directly" column (right). Native Shopify {% form 'contact' %};
  custom fields (Company, Phone, Country, Sector) are emailed as contact[...].
{% endcomment %}

{%- comment -%}
  Business-email rule + double-send guard (2026-11-23, audit E-01/F-04). Strings per locale,
  since the rest of the form has no locale file. Personal (free-mail) addresses are blocked in
  the browser before the native POST, the beacon and PostHog's lead_submitted.
{%- endcomment -%}
{%- assign cb_lang = request.locale.iso_code | slice: 0, 2 -%}
{%- case cb_lang -%}
  {%- when 'pt' -%}
    {%- assign cb_t_hint = 'Use o email da sua empresa. Não são aceites endereços pessoais (Gmail, Hotmail, Yahoo…).' -%}
    {%- assign cb_t_err = 'Indique o email da sua empresa. Este formulário não aceita endereços de email pessoais.' -%}
    {%- assign cb_t_sending = 'A enviar…' -%}
  {%- when 'fr' -%}
    {%- assign cb_t_hint = 'Utilisez votre adresse e-mail professionnelle. Les adresses personnelles (Gmail, Hotmail, Yahoo…) ne sont pas acceptées.' -%}
    {%- assign cb_t_err = 'Veuillez saisir votre adresse e-mail professionnelle. Ce formulaire n’accepte pas les adresses personnelles.' -%}
    {%- assign cb_t_sending = 'Envoi…' -%}
  {%- when 'de' -%}
    {%- assign cb_t_hint = 'Bitte verwenden Sie Ihre geschäftliche E-Mail-Adresse. Private Adressen (Gmail, Hotmail, Yahoo…) werden nicht akzeptiert.' -%}
    {%- assign cb_t_err = 'Bitte geben Sie Ihre geschäftliche E-Mail-Adresse ein. Private E-Mail-Adressen sind in diesem Formular nicht möglich.' -%}
    {%- assign cb_t_sending = 'Wird gesendet…' -%}
  {%- when 'es' -%}
    {%- assign cb_t_hint = 'Utilice el correo electrónico de su empresa. No se aceptan direcciones personales (Gmail, Hotmail, Yahoo…).' -%}
    {%- assign cb_t_err = 'Introduzca el correo electrónico de su empresa. Este formulario no admite direcciones personales.' -%}
    {%- assign cb_t_sending = 'Enviando…' -%}
  {%- when 'it' -%}
    {%- assign cb_t_hint = 'Utilizzi l’indirizzo e-mail aziendale. Gli indirizzi personali (Gmail, Hotmail, Yahoo…) non sono accettati.' -%}
    {%- assign cb_t_err = 'Inserisca l’indirizzo e-mail aziendale. Questo modulo non accetta indirizzi e-mail personali.' -%}
    {%- assign cb_t_sending = 'Invio in corso…' -%}
  {%- else -%}
    {%- assign cb_t_hint = 'Please use your company email address. Personal addresses (Gmail, Hotmail, Yahoo…) are not accepted.' -%}
    {%- assign cb_t_err = 'Please enter your company email address. Personal email addresses can’t be used with this form.' -%}
    {%- assign cb_t_sending = 'Sending…' -%}
{%- endcase -%}

<div class="section-contact-block" data-section-type="contact-block"
     style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  {% assign accent = section.settings.accent %}
  {% style %}
    #cb-{{ section.id }} .cb-head { text-align: center; max-width: 640px; margin: 0 auto 44px; }
    #cb-{{ section.id }} .cb-eyebrow { letter-spacing: 0.12em; text-transform: uppercase; font-size: 13px; font-weight: 600; color: {{ accent }}; margin-bottom: 12px; }
    #cb-{{ section.id }} .cb-title { font-size: 38px; font-weight: 400; line-height: 1.15; margin: 0; }
    #cb-{{ section.id }} .cb-intro { margin-top: 14px; font-size: 17px; line-height: 1.6; opacity: 0.82; }
    #cb-{{ section.id }} .cb-intro p { margin: 0; }

    #cb-{{ section.id }} .cb-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 48px; align-items: start; max-width: 1060px; margin: 0 auto; }
    #cb-{{ section.id }} .cb-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    #cb-{{ section.id }} .cb-field { margin-bottom: 18px; }
    #cb-{{ section.id }} .cb-field label { display: block; font-size: 13px; font-weight: 600; letter-spacing: 0.02em; margin-bottom: 7px; }
    #cb-{{ section.id }} .cb-field .req { color: {{ accent }}; }
    #cb-{{ section.id }} .cb-field input,
    #cb-{{ section.id }} .cb-field select,
    #cb-{{ section.id }} .cb-field textarea {
      display: block; width: 100%; padding: 13px 15px; font-size: 15px; font-family: inherit;
      background: {{ section.settings.field_bg }}; color: {{ section.settings.text_color }};
      border: 1px solid {{ section.settings.line_color }}; border-radius: 0; box-sizing: border-box;
      transition: border-color .2s, box-shadow .2s; }
    #cb-{{ section.id }} .cb-field textarea { min-height: 140px; resize: vertical; }
    #cb-{{ section.id }} .cb-field input:focus,
    #cb-{{ section.id }} .cb-field select:focus,
    #cb-{{ section.id }} .cb-field textarea:focus {
      outline: none; border-color: {{ accent }}; box-shadow: 0 0 0 2px {{ accent | append: '22' }}; }
    #cb-{{ section.id }} .cb-submit {
      display: inline-block; padding: 15px 38px; font-size: 15px; font-weight: 600; letter-spacing: 0.03em;
      background: {{ accent }}; color: #fff; border: 0; border-radius: 0; cursor: pointer; transition: opacity .2s; }
    #cb-{{ section.id }} .cb-submit:hover { opacity: 0.9; }
    #cb-{{ section.id }} .cb-submit[disabled] { opacity: 0.6; cursor: wait; }
    #cb-{{ section.id }} .cb-hint { margin: 7px 0 0; font-size: 13px; line-height: 1.45; opacity: 0.75; }
    #cb-{{ section.id }} .cb-email-err { margin: 7px 0 0; font-size: 13px; line-height: 1.45; color: #c0392b; font-weight: 600; }
    #cb-{{ section.id }} .cb-field input.cb-invalid { border-color: #c0392b; }

    #cb-{{ section.id }} .cb-side { border-left: 3px solid {{ accent }}; padding-left: 24px; }
    #cb-{{ section.id }} .cb-side-title { font-size: 15px; font-weight: 600; letter-spacing: 0.02em; margin: 0 0 18px; }
    #cb-{{ section.id }} .cb-side-item { margin-bottom: 20px; }
    #cb-{{ section.id }} .cb-side-item .cb-lbl { text-transform: uppercase; letter-spacing: 0.1em; font-size: 11px; font-weight: 600; opacity: 0.6; margin-bottom: 4px; }
    #cb-{{ section.id }} .cb-side-item a { color: {{ accent }}; text-decoration: none; font-size: 16px; }
    #cb-{{ section.id }} .cb-side-item a:hover { text-decoration: underline; }
    #cb-{{ section.id }} .cb-side-note { font-size: 14px; line-height: 1.6; opacity: 0.75; margin-top: 8px; }

    #cb-{{ section.id }} .cb-success { padding: 24px; border: 1px solid {{ accent }}; background: {{ accent | append: '11' }}; font-size: 16px; }
    #cb-{{ section.id }} .cb-errors { margin-bottom: 20px; padding: 14px 18px; border: 1px solid #c0392b; color: #c0392b; font-size: 14px; }
    #cb-{{ section.id }} .cb-errors ul { margin: 8px 0 0; padding-left: 18px; }

    @media (max-width: 820px) {
      #cb-{{ section.id }} .cb-grid { grid-template-columns: 1fr; gap: 40px; }
      #cb-{{ section.id }} .cb-side { border-left: 0; border-top: 3px solid {{ accent }}; padding-left: 0; padding-top: 24px; }
    }
    @media (max-width: 520px) {
      #cb-{{ section.id }} .cb-row { grid-template-columns: 1fr; }
      #cb-{{ section.id }} .cb-title { font-size: 30px; }
    }
  {% endstyle %}

  <div id="cb-{{ section.id }}" class="wide-container half-gutter section-spacing">
    {% if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.intro != blank %}
      <div class="cb-head" data-cc-animate>
        {% if section.settings.eyebrow != blank %}<div class="cb-eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
        {% if section.settings.title != blank %}<h2 class="cb-title">{{ section.settings.title | escape }}</h2>{% endif %}
        {% if section.settings.intro != blank %}<div class="cb-intro">{{ section.settings.intro }}</div>{% endif %}
      </div>
    {% endif %}

    <div class="cb-grid">
      <div class="cb-form" data-cc-animate>
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div class="cb-success">{{ section.settings.success_message | default: 'Thanks — your message has been sent. Our team will be in touch shortly.' }}</div>
          {% else %}
            {% if form.errors %}
              <div class="cb-errors">
                <strong>{{ 'contact.form.post_error' | t }}</strong>
                <ul>
                  {% for field in form.errors %}
                    <li>{{ field | replace: 'body', 'Message' | capitalize }}: {{ form.errors.messages[field] }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <div class="cb-row">
              <div class="cb-field">
                <label for="cb-name">Name <span class="req">*</span></label>
                <input type="text" id="cb-name" name="contact[name]" required value="{{ form.name }}">
              </div>
              <div class="cb-field">
                <label for="cb-company">Company</label>
                <input type="text" id="cb-company" name="contact[Company]" value="{{ form.Company }}">
              </div>
            </div>

            <div class="cb-row">
              <div class="cb-field">
                <label for="cb-email">Email <span class="req">*</span></label>
                <input type="email" id="cb-email" name="contact[email]" required autocomplete="email"
                       aria-describedby="cb-email-hint-{{ section.id }} cb-email-err-{{ section.id }}" value="{{ form.email }}">
                <p class="cb-hint" id="cb-email-hint-{{ section.id }}">{{ cb_t_hint }}</p>
                <p class="cb-email-err" id="cb-email-err-{{ section.id }}" role="alert" hidden>{{ cb_t_err }}</p>
              </div>
              <div class="cb-field">
                <label for="cb-phone">Phone</label>
                <input type="tel" id="cb-phone" name="contact[Phone]" value="{{ form.Phone }}">
              </div>
            </div>

            <div class="cb-row">
              <div class="cb-field">
                <label for="cb-country">Country</label>
                <input type="text" id="cb-country" name="contact[Country]" value="{{ form.Country }}">
              </div>
              <div class="cb-field">
                <label for="cb-sector">{{ section.settings.sector_label | default: 'Sector / application' | escape }}</label>
                <select id="cb-sector" name="contact[Sector]" class="original-selector">
                  <option value="">Select…</option>
                  {% assign sectors = section.settings.sector_options | newline_to_br | split: '<br />' %}
                  {% for s in sectors %}
                    {% assign opt = s | strip_newlines | strip %}
                    {% if opt != blank %}<option value="{{ opt | escape }}">{{ opt | escape }}</option>{% endif %}
                  {% endfor %}
                </select>
              </div>
            </div>

            {%- comment -%} Optional "I need…" select (ads LPs, 2026-10-29). Hidden when need_options is blank. {%- endcomment -%}
            {%- if section.settings.need_options != blank -%}
              <div class="cb-field">
                <label for="cb-need">{{ section.settings.need_label | default: 'I need' | escape }} <span class="req">*</span></label>
                <select id="cb-need" name="contact[Need]" class="original-selector" required>
                  <option value="">Select…</option>
                  {% assign needs = section.settings.need_options | newline_to_br | split: '<br />' %}
                  {% for n in needs %}
                    {% assign opt = n | strip_newlines | strip %}
                    {% if opt != blank %}<option value="{{ opt | escape }}">{{ opt | escape }}</option>{% endif %}
                  {% endfor %}
                </select>
              </div>
            {%- endif -%}

            <div class="cb-field">
              <label for="cb-message">{{ section.settings.message_label | default: 'Message' | escape }} <span class="req">*</span></label>
              <textarea id="cb-message" name="contact[body]" required>{{ form.body }}</textarea>
            </div>

            {%- comment -%} Honeypot for the Sender copy (not a contact[] field, so Shopify ignores it). {%- endcomment -%}
            <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;">
              <label for="cb-website">Website</label>
              <input type="text" id="cb-website" name="cb_website" tabindex="-1" autocomplete="off" value="">
            </div>

            <button type="submit" class="cb-submit">{{ section.settings.submit_label | default: 'Send' | escape }}</button>
          {% endif %}
        {% endform %}
      </div>

      <aside class="cb-side" data-cc-animate>
        {% if section.settings.side_title != blank %}<div class="cb-side-title">{{ section.settings.side_title | escape }}</div>{% endif %}
        {% if section.settings.email != blank %}
          <div class="cb-side-item"><div class="cb-lbl">Email</div><a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a></div>
        {% endif %}
        {% if section.settings.phone != blank %}
          <div class="cb-side-item"><div class="cb-lbl">Phone</div><a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">{{ section.settings.phone | escape }}</a></div>
        {% endif %}
        {% if section.settings.hours != blank %}
          <div class="cb-side-item"><div class="cb-lbl">Hours</div><span>{{ section.settings.hours | escape }}</span></div>
        {% endif %}
        {% if section.settings.side_note != blank %}<div class="cb-side-note">{{ section.settings.side_note }}</div>{% endif %}
      </aside>
    </div>
  </div>
</div>

{%- comment -%}
  Lead copy to Sender (2026-10-02). The native contact form only emails the store, so each
  valid submission is also beaconed to the Cloudflare Worker `contact-to-sender`, which adds
  the person to Sender group enzoW5 (what the Leads report reads). Fire-and-forget: the
  native submit is never delayed or blocked. Source: APP/workers/contact-to-sender/.
{%- endcomment -%}
{%- assign cb_endpoint = section.settings.lead_endpoint | default: 'https://contact-to-sender.antoniodias.workers.dev' -%}
{%- comment -%}
  Guard (2026-11-23). Runs at window/capture, i.e. before posthog-events.liquid (document/capture)
  and the beacon below (form/bubble), so a blocked or repeated submit reaches neither:
  - personal email → stop, show the inline error, focus the field;
  - first valid submit → button disabled + «Sending…»; later user submits (clicks, Enter) are cancelled,
    script re-submits (Shopify's hCaptcha) are let through.
  Reset on bfcache return (Back button) and after 10 s in case the POST never navigated.
{%- endcomment -%}
<script>
  (function () {
    var root = document.getElementById('cb-{{ section.id }}');
    var form = root && root.querySelector('form');
    if (!form) return;
    var input = form.elements['contact[email]'];
    var err = document.getElementById('cb-email-err-{{ section.id }}');
    var btn = form.querySelector('.cb-submit');
    var label = btn ? btn.textContent : '';
    /* Free-mail providers: whole families (any TLD) + exact consumer domains. Exact names only, so
       corporate domains of the same companies (orange.com, vodafone.com, att.com…) still pass. */
    var FREE_FAMILY = /^(gmail|googlemail|hotmail|outlook|live|windowslive|yahoo|ymail|aol|icloud|gmx|yandex|protonmail|proton)\.[a-z.]+$/;
    var FREE_EXACT = "me.com mac.com msn.com rocketmail.com aim.com web.de t-online.de freenet.de arcor.de mail.com email.com inbox.com mail.ru inbox.ru list.ru bk.ru rambler.ru ya.ru pm.me tutanota.com tutamail.com tuta.io zohomail.com zohomail.eu hushmail.com fastmail.com mailbox.org posteo.de posteo.net sapo.pt netcabo.pt clix.pt iol.pt vodafone.pt meo.pt free.fr orange.fr wanadoo.fr laposte.net sfr.fr neuf.fr bbox.fr libero.it virgilio.it tiscali.it alice.it tin.it email.it seznam.cz centrum.cz email.cz wp.pl o2.pl interia.pl onet.pl op.pl naver.com daum.net hanmail.net nate.com qq.com 163.com 126.com yeah.net sina.com sina.cn sohu.com foxmail.com 139.com rediffmail.com btinternet.com sky.com talktalk.net blueyonder.co.uk ntlworld.com virginmedia.com comcast.net verizon.net att.net sbcglobal.net bellsouth.net cox.net charter.net earthlink.net shaw.ca rogers.com sympatico.ca bigpond.com optusnet.com.au telus.net terra.com.br uol.com.br bol.com.br ig.com.br abv.bg ukr.net i.ua telenet.be skynet.be hetnet.nl ziggo.nl kpnmail.nl planet.nl bluewin.ch aon.at chello.at numericable.fr sunrise.ch terra.es terra.com telefonica.net".split(' ');
    function isPersonal(v) {
      var d = (v || '').trim().toLowerCase().split('@')[1] || '';
      return !!d && (FREE_FAMILY.test(d) || FREE_EXACT.indexOf(d) !== -1);
    }
    function show(on) {
      if (err) err.hidden = !on;
      if (input) input.classList.toggle('cb-invalid', on);
      if (input) input.setAttribute('aria-invalid', on ? 'true' : 'false');
    }
    if (input) {
      input.addEventListener('blur', function () { if (input.value) show(isPersonal(input.value)); });
      input.addEventListener('input', function () { if (err && !err.hidden && !isPersonal(input.value)) show(false); });
    }
    function reset() {
      form.removeAttribute('data-cb-sending'); form.removeAttribute('data-cb-beaconed'); form.removeAttribute('data-cb-captured');
      if (btn) { btn.disabled = false; btn.textContent = label; btn.removeAttribute('aria-busy'); }
    }
    window.addEventListener('submit', function (ev) {
      if (ev.target !== form) return;
      if (input && isPersonal(input.value)) {
        ev.preventDefault(); ev.stopImmediatePropagation();
        show(true); input.focus();
        return;
      }
      if (form.getAttribute('data-cb-sending')) {
        /* Only user-made repeats are cancelled; a script re-submit (Shopify's hCaptcha) passes. */
        if (ev.isTrusted) { ev.preventDefault(); ev.stopImmediatePropagation(); }
        return;
      }
      show(false);
      form.setAttribute('data-cb-sending', '1');
      if (btn) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); btn.textContent = {{ cb_t_sending | json }}; }
      setTimeout(reset, 10000);
    }, true);
    window.addEventListener('pageshow', function (ev) { if (ev.persisted) reset(); });
  })();
</script>
<script>
  (function () {
    var root = document.getElementById('cb-{{ section.id }}');
    var form = root && root.querySelector('form');
    if (!form || !navigator.sendBeacon) return;
    var url = {{ cb_endpoint | json }};
    form.addEventListener('submit', function () {
      if (form.getAttribute('data-cb-beaconed')) return;   /* one copy per send (hCaptcha re-submits) */
      form.setAttribute('data-cb-beaconed', '1');
      try {
        var v = function (n) { var el = form.elements[n]; return el ? el.value : ''; };
        var data = {
          name: v('contact[name]'), company: v('contact[Company]'), email: v('contact[email]'),
          phone: v('contact[Phone]'), country: v('contact[Country]'), sector: v('contact[Sector]'),
          message: (v('contact[Need]') ? 'Need: ' + v('contact[Need]') + '\n\n' : '') + v('contact[body]'), website: v('cb_website'), page: location.pathname,
          kind: 'contact_form', locale: {{ request.locale.iso_code | json }}
        };
        /* Attribution (2026-10-23): same PostHog id + session-entry data the cart attributes carry,
           so the Worker can store first touch without a PostHog lookup. */
        try { if (window.posthog && window.posthog.get_distinct_id) { data.ph_distinct_id = window.posthog.get_distinct_id(); data.ph_session_id = window.posthog.get_session_id(); } } catch (e) {}
        try {
          var entry = JSON.parse(sessionStorage.getItem('mf_entry_v1') || '{}');
          Object.keys(entry).forEach(function (k) { data['ph_' + k] = entry[k]; });
        } catch (e) {}
        navigator.sendBeacon(url, new Blob([JSON.stringify(data)], { type: 'text/plain' }));
      } catch (e) {}
    });
  })();
</script>

{% schema %}
  {
    "name": "Contact block",
    "class": "section-contact-block-wrap",
    "settings": [
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
      { "type": "text", "id": "title", "label": "Heading", "default": "Get in touch" },
      { "type": "richtext", "id": "intro", "label": "Intro" },
      { "type": "header", "content": "Form" },
      { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send message" },
      { "type": "text", "id": "sector_label", "label": "Sector field label", "default": "Sector / application" },
      { "type": "textarea", "id": "sector_options", "label": "Sector / application options (one per line)", "default": "Healthcare & medical\nHospitality\nPublic spaces\nPublic transport\nMarine\nAutomotive\nRetail\nFitness\nOther" },
      { "type": "text", "id": "need_label", "label": "'I need' field label", "default": "I need" },
      { "type": "textarea", "id": "need_options", "label": "'I need' options (one per line)", "info": "Leave blank to hide the field (default)." },
      { "type": "text", "id": "message_label", "label": "Message field label", "default": "Message" },
      { "type": "text", "id": "lead_endpoint", "label": "Lead copy endpoint (Sender Worker)", "info": "Leave blank to use the default Worker. Each submission is stored in Supabase (signals_lead_events) and copied to Sender group enzoW5." },
      { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — your message has been sent. Our team will be in touch shortly." },
      { "type": "header", "content": "Reach us directly" },
      { "type": "text", "id": "side_title", "label": "Side title", "default": "Prefer to reach us directly?" },
      { "type": "text", "id": "email", "label": "Email", "default": "info@monteirofabrics.com" },
      { "type": "text", "id": "phone", "label": "Phone", "default": "+351 228 338 640" },
      { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Fri, 9:00–18:00 (WET)" },
      { "type": "richtext", "id": "side_note", "label": "Side note" },
      { "type": "header", "content": "Colours" },
      { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
      { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
      { "type": "color", "id": "field_bg", "label": "Field background", "default": "#FAFAF8" },
      { "type": "color", "id": "line_color", "label": "Field border", "default": "#D9D9D4" },
      { "type": "color", "id": "accent", "label": "Accent", "default": "#2F519B" }
    ],
    "presets": [ { "name": "Contact block" } ]
  }
{% endschema %}
