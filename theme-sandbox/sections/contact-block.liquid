{% comment %}
  Contact block — two-column direct-contact layout: B2B qualifying form (left)
  + a concise "reach us directly" column (right). Native Shopify {% form 'contact' %};
  custom fields (Company, Phone, Country, Sector) are emailed as contact[...].
{% endcomment %}

<div class="section-contact-block" data-section-type="contact-block"
     style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  {% assign accent = section.settings.accent %}
  {% style %}
    #cb-{{ section.id }} .cb-head { text-align: center; max-width: 640px; margin: 0 auto 44px; }
    #cb-{{ section.id }} .cb-eyebrow { letter-spacing: 0.12em; text-transform: uppercase; font-size: 13px; font-weight: 600; color: {{ accent }}; margin-bottom: 12px; }
    #cb-{{ section.id }} .cb-title { font-size: 38px; font-weight: 400; line-height: 1.15; margin: 0; }
    #cb-{{ section.id }} .cb-intro { margin-top: 14px; font-size: 17px; line-height: 1.6; opacity: 0.82; }
    #cb-{{ section.id }} .cb-intro p { margin: 0; }

    #cb-{{ section.id }} .cb-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 48px; align-items: start; max-width: 1060px; margin: 0 auto; }
    #cb-{{ section.id }} .cb-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    #cb-{{ section.id }} .cb-field { margin-bottom: 18px; }
    #cb-{{ section.id }} .cb-field label { display: block; font-size: 13px; font-weight: 600; letter-spacing: 0.02em; margin-bottom: 7px; }
    #cb-{{ section.id }} .cb-field .req { color: {{ accent }}; }
    #cb-{{ section.id }} .cb-field input,
    #cb-{{ section.id }} .cb-field select,
    #cb-{{ section.id }} .cb-field textarea {
      display: block; width: 100%; padding: 13px 15px; font-size: 15px; font-family: inherit;
      background: {{ section.settings.field_bg }}; color: {{ section.settings.text_color }};
      border: 1px solid {{ section.settings.line_color }}; border-radius: 0; box-sizing: border-box;
      transition: border-color .2s, box-shadow .2s; }
    #cb-{{ section.id }} .cb-field textarea { min-height: 140px; resize: vertical; }
    #cb-{{ section.id }} .cb-field input:focus,
    #cb-{{ section.id }} .cb-field select:focus,
    #cb-{{ section.id }} .cb-field textarea:focus {
      outline: none; border-color: {{ accent }}; box-shadow: 0 0 0 2px {{ accent | append: '22' }}; }
    #cb-{{ section.id }} .cb-submit {
      display: inline-block; padding: 15px 38px; font-size: 15px; font-weight: 600; letter-spacing: 0.03em;
      background: {{ accent }}; color: #fff; border: 0; border-radius: 0; cursor: pointer; transition: opacity .2s; }
    #cb-{{ section.id }} .cb-submit:hover { opacity: 0.9; }

    #cb-{{ section.id }} .cb-side { border-left: 3px solid {{ accent }}; padding-left: 24px; }
    #cb-{{ section.id }} .cb-side-title { font-size: 15px; font-weight: 600; letter-spacing: 0.02em; margin: 0 0 18px; }
    #cb-{{ section.id }} .cb-side-item { margin-bottom: 20px; }
    #cb-{{ section.id }} .cb-side-item .cb-lbl { text-transform: uppercase; letter-spacing: 0.1em; font-size: 11px; font-weight: 600; opacity: 0.6; margin-bottom: 4px; }
    #cb-{{ section.id }} .cb-side-item a { color: {{ accent }}; text-decoration: none; font-size: 16px; }
    #cb-{{ section.id }} .cb-side-item a:hover { text-decoration: underline; }
    #cb-{{ section.id }} .cb-side-note { font-size: 14px; line-height: 1.6; opacity: 0.75; margin-top: 8px; }

    #cb-{{ section.id }} .cb-success { padding: 24px; border: 1px solid {{ accent }}; background: {{ accent | append: '11' }}; font-size: 16px; }
    #cb-{{ section.id }} .cb-errors { margin-bottom: 20px; padding: 14px 18px; border: 1px solid #c0392b; color: #c0392b; font-size: 14px; }
    #cb-{{ section.id }} .cb-errors ul { margin: 8px 0 0; padding-left: 18px; }

    @media (max-width: 820px) {
      #cb-{{ section.id }} .cb-grid { grid-template-columns: 1fr; gap: 40px; }
      #cb-{{ section.id }} .cb-side { border-left: 0; border-top: 3px solid {{ accent }}; padding-left: 0; padding-top: 24px; }
    }
    @media (max-width: 520px) {
      #cb-{{ section.id }} .cb-row { grid-template-columns: 1fr; }
      #cb-{{ section.id }} .cb-title { font-size: 30px; }
    }
  {% endstyle %}

  <div id="cb-{{ section.id }}" class="wide-container half-gutter section-spacing">
    {% if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.intro != blank %}
      <div class="cb-head" data-cc-animate>
        {% if section.settings.eyebrow != blank %}<div class="cb-eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
        {% if section.settings.title != blank %}<h2 class="cb-title">{{ section.settings.title | escape }}</h2>{% endif %}
        {% if section.settings.intro != blank %}<div class="cb-intro">{{ section.settings.intro }}</div>{% endif %}
      </div>
    {% endif %}

    <div class="cb-grid">
      <div class="cb-form" data-cc-animate>
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div class="cb-success">{{ section.settings.success_message | default: 'Thanks — your message has been sent. Our team will be in touch shortly.' }}</div>
          {% else %}
            {% if form.errors %}
              <div class="cb-errors">
                <strong>{{ 'contact.form.post_error' | t }}</strong>
                <ul>
                  {% for field in form.errors %}
                    <li>{{ field | replace: 'body', 'Message' | capitalize }}: {{ form.errors.messages[field] }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <div class="cb-row">
              <div class="cb-field">
                <label for="cb-name">Name <span class="req">*</span></label>
                <input type="text" id="cb-name" name="contact[name]" required value="{{ form.name }}">
              </div>
              <div class="cb-field">
                <label for="cb-company">Company</label>
                <input type="text" id="cb-company" name="contact[Company]" value="{{ form.Company }}">
              </div>
            </div>

            <div class="cb-row">
              <div class="cb-field">
                <label for="cb-email">Email <span class="req">*</span></label>
                <input type="email" id="cb-email" name="contact[email]" required value="{{ form.email }}">
              </div>
              <div class="cb-field">
                <label for="cb-phone">Phone</label>
                <input type="tel" id="cb-phone" name="contact[Phone]" value="{{ form.Phone }}">
              </div>
            </div>

            <div class="cb-row">
              <div class="cb-field">
                <label for="cb-country">Country</label>
                <input type="text" id="cb-country" name="contact[Country]" value="{{ form.Country }}">
              </div>
              <div class="cb-field">
                <label for="cb-sector">Sector / application</label>
                <select id="cb-sector" name="contact[Sector]" class="original-selector">
                  <option value="">Select…</option>
                  {% assign sectors = section.settings.sector_options | newline_to_br | split: '<br />' %}
                  {% for s in sectors %}
                    {% assign opt = s | strip_newlines | strip %}
                    {% if opt != blank %}<option value="{{ opt | escape }}">{{ opt | escape }}</option>{% endif %}
                  {% endfor %}
                </select>
              </div>
            </div>

            <div class="cb-field">
              <label for="cb-message">Message <span class="req">*</span></label>
              <textarea id="cb-message" name="contact[body]" required>{{ form.body }}</textarea>
            </div>

            <button type="submit" class="cb-submit">{{ section.settings.submit_label | default: 'Send' | escape }}</button>
          {% endif %}
        {% endform %}
      </div>

      <aside class="cb-side" data-cc-animate>
        {% if section.settings.side_title != blank %}<div class="cb-side-title">{{ section.settings.side_title | escape }}</div>{% endif %}
        {% if section.settings.email != blank %}
          <div class="cb-side-item"><div class="cb-lbl">Email</div><a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a></div>
        {% endif %}
        {% if section.settings.phone != blank %}
          <div class="cb-side-item"><div class="cb-lbl">Phone</div><a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">{{ section.settings.phone | escape }}</a></div>
        {% endif %}
        {% if section.settings.hours != blank %}
          <div class="cb-side-item"><div class="cb-lbl">Hours</div><span>{{ section.settings.hours | escape }}</span></div>
        {% endif %}
        {% if section.settings.side_note != blank %}<div class="cb-side-note">{{ section.settings.side_note }}</div>{% endif %}
      </aside>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Contact block",
    "class": "section-contact-block-wrap",
    "settings": [
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
      { "type": "text", "id": "title", "label": "Heading", "default": "Get in touch" },
      { "type": "richtext", "id": "intro", "label": "Intro" },
      { "type": "header", "content": "Form" },
      { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send message" },
      { "type": "textarea", "id": "sector_options", "label": "Sector / application options (one per line)", "default": "Healthcare & medical\nHospitality\nPublic spaces\nPublic transport\nMarine\nAutomotive\nRetail\nFitness\nOther" },
      { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — your message has been sent. Our team will be in touch shortly." },
      { "type": "header", "content": "Reach us directly" },
      { "type": "text", "id": "side_title", "label": "Side title", "default": "Prefer to reach us directly?" },
      { "type": "text", "id": "email", "label": "Email", "default": "info@monteirofabrics.com" },
      { "type": "text", "id": "phone", "label": "Phone", "default": "+351 228 338 640" },
      { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Fri, 9:00–18:00 (WET)" },
      { "type": "richtext", "id": "side_note", "label": "Side note" },
      { "type": "header", "content": "Colours" },
      { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
      { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
      { "type": "color", "id": "field_bg", "label": "Field background", "default": "#FAFAF8" },
      { "type": "color", "id": "line_color", "label": "Field border", "default": "#D9D9D4" },
      { "type": "color", "id": "accent", "label": "Accent", "default": "#2F519B" }
    ],
    "presets": [ { "name": "Contact block" } ]
  }
{% endschema %}
