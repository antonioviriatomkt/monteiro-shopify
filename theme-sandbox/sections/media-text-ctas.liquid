{%- comment -%}
  Media with text + two CTAs — image (theme placeholder when empty) beside eyebrow, heading, text, an
  optional checklist (blocks) and two buttons (primary + secondary). House tokens of Showcase 7.0.
  Built 10/09/2026 for the ORGATEC 2026 page (certifications / technical information); reusable.
{%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  #mtc-{{ sid }}{ --mt-text:#111; --mt-muted:#464654; --mt-rule:#dbdbdb; --mt-alt:#f5f5f5; color:var(--mt-text); padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; {% if section.settings.alternate_bg_color %}background:var(--mt-alt);{% endif %} }
  #mtc-{{ sid }} .mt-grid{ display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center; }
  #mtc-{{ sid }} .mt-grid--media-right .mt-media{ order:2; }
  #mtc-{{ sid }} .mt-media{ position:relative; aspect-ratio:{{ section.settings.media_ratio }}; background:#e9e7e2; overflow:hidden; }
  #mtc-{{ sid }} .mt-media img{ width:100%; height:100%; object-fit:cover; display:block; }
  #mtc-{{ sid }} .mt-media .placeholder-svg{ width:100%; height:100%; display:block; fill:#c4c4c4; background:#e9e7e2; }
  #mtc-{{ sid }} .mt-eyebrow{ display:block; font-size:12px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:var(--mt-muted); margin-bottom:14px; }
  #mtc-{{ sid }} .mt-title{ font-size:{{ section.settings.title_size }}px; font-weight:600; line-height:1.15; letter-spacing:-.01em; margin:0 0 18px; text-align:left; color:var(--mt-text); max-width:14em; }
  #mtc-{{ sid }} .mt-text{ font-size:16px; line-height:1.55; color:var(--mt-text); max-width:520px; }
  #mtc-{{ sid }} .mt-text p{ margin:0 0 12px; }
  #mtc-{{ sid }} .mt-list{ list-style:none; margin:22px 0 0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:10px 24px; }
  #mtc-{{ sid }} .mt-list li{ display:flex; gap:10px; align-items:flex-start; font-size:15px; line-height:1.4; color:var(--mt-text); }
  #mtc-{{ sid }} .mt-list li:before{ content:""; flex:none; width:14px; height:14px; margin-top:4px; border:1px solid var(--mt-muted); background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 14 14'><path d='M3 7.2l2.6 2.6L11 4.4' fill='none' stroke='%23464654' stroke-width='1.4' stroke-linecap='round' stroke-linejoin='round'/></svg>") center/10px no-repeat; }
  #mtc-{{ sid }} .mt-list li small{ display:block; font-size:13px; color:var(--mt-muted); }
  #mtc-{{ sid }} .mt-actions{ display:flex; gap:14px; flex-wrap:wrap; margin-top:30px; }
  #mtc-{{ sid }} .mt-actions .button{ padding:16px 26px; }
  #mtc-{{ sid }} .mt-actions .button.alt{ background:{% if section.settings.alternate_bg_color %}var(--mt-alt){% else %}#fff{% endif %}; }
  @media (max-width:1023px){ #mtc-{{ sid }} .mt-grid{ gap:36px; } }
  @media (max-width:767px){
    #mtc-{{ sid }} .mt-grid{ grid-template-columns:1fr; gap:24px; }
    #mtc-{{ sid }} .mt-grid--media-right .mt-media{ order:0; }
    #mtc-{{ sid }} .mt-title{ font-size:28px; max-width:none; }
    #mtc-{{ sid }} .mt-list{ grid-template-columns:1fr; }
    #mtc-{{ sid }} .mt-actions .button{ width:100%; text-align:center; }
  }
</style>

<div id="mtc-{{ sid }}" class="media-text-ctas" data-section-id="{{ sid }}">
  <div class="container container--large">
    <div class="mt-grid mt-grid--media-{{ section.settings.image_position }}">
      <div class="mt-media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 1024px) 560px, 100vw', alt: section.settings.image.alt | default: section.settings.title }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="mt-body">
        {%- if section.settings.eyebrow != blank -%}<span class="mt-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2 class="mt-title">{{ section.settings.title | escape }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="mt-text">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="mt-list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}{%- if block.settings.detail != blank -%}<small>{{ block.settings.detail | escape }}</small>{%- endif -%}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
          <div class="mt-actions">
            {%- if section.settings.btn1_label != blank -%}
              <a class="button" href="{{ section.settings.btn1_link | default: '#' }}" data-cta="{{ section.settings.btn1_cta | default: 'mtc_primary' | escape }}">{{ section.settings.btn1_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.btn2_label != blank -%}
              <a class="button alt" href="{{ section.settings.btn2_link | default: '#' }}" data-cta="{{ section.settings.btn2_cta | default: 'mtc_secondary' | escape }}">{{ section.settings.btn2_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Media with text + 2 CTAs",
  "tag": "section",
  "class": "section-media-text-ctas",
  "max_blocks": 10,
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Certifications" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Certified where it counts." },
    { "type": "range", "id": "title_size", "label": "Heading size", "min": 24, "max": 48, "step": 2, "default": 34, "unit": "px" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "See the collections" },
    { "type": "text", "id": "btn1_link", "label": "Primary link (URL or #anchor)" },
    { "type": "text", "id": "btn1_cta", "label": "Primary tracking ID (data-cta)", "default": "mtc_collections" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "Contact us" },
    { "type": "text", "id": "btn2_link", "label": "Secondary link (URL or #anchor)" },
    { "type": "text", "id": "btn2_cta", "label": "Secondary tracking ID (data-cta)", "default": "mtc_contact" },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Empty = placeholder." },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "right", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "media_ratio", "label": "Image ratio", "default": "4/3", "options": [ { "value": "1/1", "label": "Square" }, { "value": "4/3", "label": "4:3" }, { "value": "3/4", "label": "Portrait 3:4" }, { "value": "16/9", "label": "16:9" } ] },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "alternate_bg_color", "label": "Use alternate section color", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 10, "default": 70, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 10, "default": 70, "unit": "px" }
  ],
  "blocks": [
    { "type": "item", "name": "List item", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "ISO 9001 & ISO 14001" },
      { "type": "text", "id": "detail", "label": "Detail (optional)" }
    ] }
  ],
  "presets": [ { "name": "Media with text + 2 CTAs", "blocks": [ { "type": "item" }, { "type": "item", "settings": { "label": "10-year warranty" } } ] } ]
}
{% endschema %}
