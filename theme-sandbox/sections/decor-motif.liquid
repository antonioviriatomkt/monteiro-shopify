{% comment %}
  Decorative motif — drops a transparent PNG (e.g. an animal cut-out) into the
  page flow and lets it peek in from the edge of the page. The section takes no
  vertical height, so the image floats as decoration over the sections above /
  below. For "left"/"right" it anchors to the true viewport edge and bleeds off
  it by the "Edge bleed" amount — the off-screen part is clipped (overflow-x:
  clip) so it reads as emerging from the side and never adds a sideways
  scrollbar, at any width. pointer-events are off; purely decorative.

  NOTE: the theme forces every .shopify-section to overflow:hidden and every
  [data-cc-animate] to opacity:0 — so this section overrides its own wrapper's
  overflow and the image carries NO data-cc-animate (or it would stay invisible).
{% endcomment %}

{%- assign mw = section.settings.max_width -%}
{%- assign op = section.settings.opacity | divided_by: 100.0 -%}
{%- assign mobile_w = mw | times: section.settings.mobile_scale | divided_by: 100 -%}
{%- assign mobile_bleed = section.settings.bleed | times: section.settings.mobile_scale | divided_by: 100 -%}
{%- if section.settings.layer == 'behind' -%}{%- assign zi = '-1' -%}{%- else -%}{%- assign zi = '6' -%}{%- endif -%}

{%- capture extra -%}
  {%- if section.settings.rotate != 0 %} rotate({{ section.settings.rotate }}deg){%- endif -%}
  {%- if section.settings.flip_h %} scaleX(-1){%- endif -%}
{%- endcapture -%}
{%- assign extra = extra | strip -%}

<div class="decor-motif" aria-hidden="true">
  {% style %}
    /* Override the theme's overflow:hidden on this section's wrapper: clip horizontally
       (so the bleed never causes a scrollbar) but allow vertical bleed across sections. */
    #shopify-section-{{ section.id }} { overflow-x: clip !important; overflow-y: visible !important; position: relative; z-index: {{ zi }}; }
    #dm-{{ section.id }} { position: relative; width: 100%; height: 0; pointer-events: none; }
    #dm-{{ section.id }} .dm-img { position: absolute; width: {{ mw }}px; opacity: {{ op }}; transform-origin: center; }
    {%- case section.settings.align -%}
      {%- when 'left' -%}
        #dm-{{ section.id }} .dm-img { left: 0; transform: translateX(-{{ section.settings.bleed }}px) translateY({{ section.settings.offset_y }}px) {{ extra }}; }
      {%- when 'right' -%}
        #dm-{{ section.id }} .dm-img { right: 0; transform: translateX({{ section.settings.bleed }}px) translateY({{ section.settings.offset_y }}px) {{ extra }}; }
      {%- when 'center' -%}
        #dm-{{ section.id }} .dm-img { left: calc(50% + {{ section.settings.offset_x }}px); transform: translateX(-50%) translateY({{ section.settings.offset_y }}px) {{ extra }}; }
    {%- endcase -%}
    @media (max-width: 749px) {
      {%- if section.settings.hide_mobile -%}
        #shopify-section-{{ section.id }} { display: none; }
      {%- else -%}
        #dm-{{ section.id }} .dm-img { width: {{ mobile_w }}px; }
        {%- case section.settings.align -%}
          {%- when 'left' -%}#dm-{{ section.id }} .dm-img { transform: translateX(-{{ mobile_bleed }}px) translateY({{ section.settings.offset_y | divided_by: 2 }}px) {{ extra }}; }
          {%- when 'right' -%}#dm-{{ section.id }} .dm-img { transform: translateX({{ mobile_bleed }}px) translateY({{ section.settings.offset_y | divided_by: 2 }}px) {{ extra }}; }
          {%- when 'center' -%}#dm-{{ section.id }} .dm-img { transform: translateX(-50%) translateY({{ section.settings.offset_y | divided_by: 2 }}px) {{ extra }}; }
        {%- endcase -%}
      {%- endif -%}
    }
  {% endstyle %}

  <div id="dm-{{ section.id }}">
    {% if section.settings.image %}
      <img class="dm-img" src="{{ section.settings.image | image_url: width: 1400 }}" alt="" loading="lazy">
    {% endif %}
  </div>
</div>

{% schema %}
  {
    "name": "Decorative motif",
    "class": "section-decor-motif",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image (transparent PNG)" },
      { "type": "paragraph", "content": "Peeks in from the page edge with no height of its own. Use 'Left' or 'Right' so it emerges from the side; 'Edge bleed' sets how far it hangs off-screen." },
      { "type": "select", "id": "layer", "label": "Layer", "default": "front",
        "options": [ { "value": "front", "label": "In front (overlay)" }, { "value": "behind", "label": "Behind" } ] },
      { "type": "range", "id": "max_width", "min": 200, "max": 1400, "step": 20, "unit": "px", "label": "Width", "default": 700 },
      { "type": "select", "id": "align", "label": "Emerge from", "default": "right",
        "options": [ { "value": "left", "label": "Left edge" }, { "value": "center", "label": "Center (no bleed)" }, { "value": "right", "label": "Right edge" } ] },
      { "type": "range", "id": "bleed", "min": 0, "max": 700, "step": 10, "unit": "px", "label": "Edge bleed (off-screen)", "default": 150 },
      { "type": "range", "id": "offset_x", "min": -400, "max": 400, "step": 10, "unit": "px", "label": "Horizontal nudge (center only)", "default": 0 },
      { "type": "range", "id": "offset_y", "min": -500, "max": 500, "step": 10, "unit": "px", "label": "Vertical nudge (− pulls up)", "default": -120 },
      { "type": "range", "id": "opacity", "min": 5, "max": 100, "step": 5, "unit": "%", "label": "Opacity", "default": 100 },
      { "type": "range", "id": "rotate", "min": -45, "max": 45, "step": 1, "unit": "°", "label": "Rotate", "default": 0 },
      { "type": "checkbox", "id": "flip_h", "label": "Flip horizontally", "default": false },
      { "type": "header", "content": "Mobile" },
      { "type": "checkbox", "id": "hide_mobile", "label": "Hide on mobile", "default": true },
      { "type": "range", "id": "mobile_scale", "min": 30, "max": 100, "step": 5, "unit": "%", "label": "Mobile size (of width)", "default": 55 }
    ],
    "presets": [ { "name": "Decorative motif" } ]
  }
{% endschema %}
