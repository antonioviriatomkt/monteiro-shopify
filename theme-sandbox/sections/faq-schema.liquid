{% comment %}
  FAQ + structured data — an accessible <details> FAQ that doubles as
  machine-readable schema.org markup. The visible Q&A and the JSON-LD are
  generated from the SAME blocks, so they can never drift apart (a Google
  requirement for FAQ markup). Optionally also emits BreadcrumbList and a
  CollectionPage or WebPage node (referencing the sitewide #website / #organization
  nodes by @id), turning a sector / collection page into a fully
  AI- and search-extractable answer source. Reusable on any page.
{% endcomment %}

{%- assign faqs = section.blocks | where: "type", "faq" -%}

<div class="section-faq-schema" data-section-type="faq-schema" data-cc-animate
     style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  {% style %}
    #fq-{{ section.id }} .fq-head { max-width: 760px; margin: 0 auto 40px; text-align: center; }
    #fq-{{ section.id }} .fq-eyebrow { letter-spacing: 0.14em; text-transform: uppercase; font-size: 13px; opacity: 0.7; margin-bottom: 12px; }
    #fq-{{ section.id }} .fq-title { font-size: 30px; font-weight: 400; line-height: 1.25; margin: 0; color: {{ section.settings.text_color }}; }
    #fq-{{ section.id }} .fq-intro { margin-top: 16px; line-height: 1.6; opacity: 0.92; }
    #fq-{{ section.id }} .fq-intro p { margin: 0; }
    #fq-{{ section.id }} .fq-list { max-width: 820px; margin: 0 auto; }
    #fq-{{ section.id }} .fq-item { border-top: 1px solid {{ section.settings.line_color }}; }
    #fq-{{ section.id }} .fq-item:last-child { border-bottom: 1px solid {{ section.settings.line_color }}; }
    #fq-{{ section.id }} .fq-q { cursor: pointer; list-style: none; padding: 22px 44px 22px 0; position: relative; font-size: 19px; line-height: 1.4; font-weight: 400; }
    #fq-{{ section.id }} .fq-q::-webkit-details-marker { display: none; }
    #fq-{{ section.id }} .fq-q::after { content: "+"; position: absolute; right: 6px; top: 50%; transform: translateY(-50%); font-size: 24px; line-height: 1; opacity: 0.6; transition: transform .25s ease; }
    #fq-{{ section.id }} .fq-item[open] .fq-q::after { content: "\2013"; }
    #fq-{{ section.id }} .fq-a { padding: 0 44px 24px 0; line-height: 1.65; opacity: 0.9; }
    #fq-{{ section.id }} .fq-a p { margin: 0 0 12px; }
    #fq-{{ section.id }} .fq-a p:last-child { margin-bottom: 0; }
    @media (max-width: 749px) {
      #fq-{{ section.id }} .fq-title { font-size: 24px; }
      #fq-{{ section.id }} .fq-q { font-size: 17px; }
    }
  {% endstyle %}

  <div id="fq-{{ section.id }}" class="wide-container half-gutter section-spacing">
    {% if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.intro != blank %}
      <div class="fq-head" data-cc-animate>
        {% if section.settings.eyebrow != blank %}<div class="fq-eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
        {% if section.settings.title != blank %}<h2 class="fq-title">{{ section.settings.title | escape }}</h2>{% endif %}
        {% if section.settings.intro != blank %}<div class="fq-intro rte">{{ section.settings.intro }}</div>{% endif %}
      </div>
    {% endif %}

    <div class="fq-list" data-cc-animate>
      {% for block in faqs %}
        <details class="fq-item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="fq-q">{{ block.settings.question | escape }}</summary>
          <div class="fq-a rte">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{%- liquid
  assign fq_page_node = section.settings.page_node | default: 'CollectionPage'
  assign fq_node_type = ''
  if fq_page_node == 'WebPage'
    assign fq_node_type = 'WebPage'
  elsif fq_page_node == 'CollectionPage' and section.settings.emit_collectionpage and section.settings.cp_name != blank
    assign fq_node_type = 'CollectionPage'
  endif
  assign fq_url = section.settings.cp_url | default: canonical_url
  assign fq_webpage_id = canonical_url | append: '#webpage'
  assign fq_breadcrumb_id = canonical_url | append: '#breadcrumb'
  assign fq_faq_id = canonical_url | append: '#faq'
  assign fq_site_id = shop.url | append: '/#website'
  assign fq_org_id = shop.url | append: '/#organization'
  assign fq_main_entity_id = ''
  assign fq_main_entity = section.settings.webpage_main_entity | strip
  if fq_main_entity != blank
    if fq_main_entity contains '://'
      assign fq_main_entity_id = fq_main_entity
    else
      assign fq_main_entity_id = fq_main_entity | split: '#' | last | prepend: '#' | prepend: canonical_url
    endif
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {%- if section.settings.emit_breadcrumb -%}
    {
      "@type": "BreadcrumbList",
      "@id": {{ fq_breadcrumb_id | json }},
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ section.settings.crumb_home | default: "Home" | json }}, "item": {{ section.settings.crumb_home_url | default: "https://www.monteirofabrics.com/" | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ section.settings.crumb_current | json }}, "item": {{ canonical_url | json }} }
      ]
    },
    {%- endif -%}
    {%- if fq_node_type != blank -%}
    {
      "@type": {{ fq_node_type | json }},
      "@id": {{ fq_webpage_id | json }},
      "url": {{ fq_url | json }},
      "name": {{ section.settings.cp_name | default: page_title | json }},
      {%- if section.settings.webpage_headline != blank -%}
      "headline": {{ section.settings.webpage_headline | json }},
      {%- endif -%}
      {%- if section.settings.cp_description != blank -%}
      "description": {{ section.settings.cp_description | strip_html | strip_newlines | json }},
      {%- endif -%}
      "inLanguage": {{ request.locale.iso_code | json }},
      "isPartOf": { "@id": {{ fq_site_id | json }} },
      "publisher": { "@id": {{ fq_org_id | json }} }
      {%- if section.settings.emit_breadcrumb -%},
      "breadcrumb": { "@id": {{ fq_breadcrumb_id | json }} }
      {%- endif -%}
      {%- if fq_main_entity_id != blank -%},
      "mainEntity": { "@id": {{ fq_main_entity_id | json }} }
      {%- endif %}
    },
    {%- endif -%}
    {
      "@type": "FAQPage",
      "@id": {{ fq_faq_id | json }},
      {%- if fq_node_type != blank -%}
      "isPartOf": { "@id": {{ fq_webpage_id | json }} },
      {%- endif -%}
      "mainEntity": [
        {%- for block in faqs -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | replace: '</p>', '</p> ' | replace: '<br>', ' ' | strip_html | strip_newlines | strip | json }} }
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  ]
}
</script>

{% schema %}
  {
    "name": "FAQ + schema",
    "class": "section-faq-schema",
    "max_blocks": 14,
    "settings": [
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "text", "id": "title", "label": "Heading", "default": "Frequently asked questions" },
      { "type": "richtext", "id": "intro", "label": "Intro text" },
      { "type": "checkbox", "id": "open_first", "label": "Open first item by default", "default": true },
      { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#FAFAF8" },
      { "type": "color", "id": "text_color", "label": "Text colour", "default": "#111111" },
      { "type": "color", "id": "line_color", "label": "Divider colour", "default": "#E0E0DC" },
      { "type": "header", "content": "Structured data (SEO / AI)" },
      { "type": "paragraph", "content": "The visible questions above are emitted as FAQPage schema automatically. The options below add page-level markup." },
      { "type": "checkbox", "id": "emit_breadcrumb", "label": "Emit BreadcrumbList schema", "default": true },
      { "type": "text", "id": "crumb_home", "label": "Breadcrumb — home label", "default": "Home" },
      { "type": "url", "id": "crumb_home_url", "label": "Breadcrumb — home URL" },
      { "type": "text", "id": "crumb_current", "label": "Breadcrumb — current page label", "default": "Healthcare Upholstery Fabrics" },
      {
        "type": "select", "id": "page_node", "label": "Page node type",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "CollectionPage", "label": "CollectionPage (lists products)" },
          { "value": "WebPage", "label": "WebPage" }
        ],
        "default": "CollectionPage",
        "info": "CollectionPage is emitted only while 'Emit CollectionPage schema' is ticked and a page name is set. WebPage is always emitted."
      },
      { "type": "checkbox", "id": "emit_collectionpage", "label": "Emit CollectionPage schema", "default": true },
      { "type": "text", "id": "cp_name", "label": "Page name", "default": "Healthcare Upholstery Fabrics" },
      { "type": "text", "id": "webpage_headline", "label": "Page headline (optional)" },
      { "type": "textarea", "id": "cp_description", "label": "Page description (for schema)" },
      { "type": "url", "id": "cp_url", "label": "Canonical page URL", "info": "Leave blank to use this page's own URL in each language." },
      { "type": "text", "id": "webpage_main_entity", "label": "Main entity @id (optional)", "info": "e.g. #sectors, resolved against this page's URL. Must match an @id emitted on the page (e.g. Grade cards list ID)." }
    ],
    "blocks": [
      {
        "type": "faq",
        "name": "Question",
        "settings": [
          { "type": "text", "id": "question", "label": "Question", "default": "Question?" },
          { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer.</p>" }
        ]
      }
    ],
    "presets": [
      {
        "name": "FAQ + schema",
        "blocks": [ { "type": "faq" }, { "type": "faq" }, { "type": "faq" } ]
      }
    ]
  }
{% endschema %}
