{% comment %}
  Fabric anatomy — an editorial "exploded cross-section" that turns a technical
  layer construction into a visual centrepiece. Each block is one material layer,
  drawn as an angled slab (with a faked thickness edge) beside its label and
  descriptor. Reusable for any engineered/coated fabric. Layers animate in.
{% endcomment %}

<div class="section-anatomy" data-section-type="fabric-anatomy" data-cc-animate
     style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  {% style %}
    #an-{{ section.id }} .an-head { text-align: center; max-width: 720px; margin: 0 auto 56px; }
    #an-{{ section.id }} .an-eyebrow { letter-spacing: 0.16em; text-transform: uppercase; font-size: 13px; opacity: 0.7; margin-bottom: 12px; }
    #an-{{ section.id }} .an-title { font-size: 34px; font-weight: 400; line-height: 1.2; margin: 0; color: {{ section.settings.text_color }}; }
    #an-{{ section.id }} .an-body { margin-top: 16px; line-height: 1.6; opacity: 0.9; }
    #an-{{ section.id }} .an-body p { margin: 0; }
    #an-{{ section.id }} .an-stack { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px; }
    #an-{{ section.id }} .an-layer { display: grid; grid-template-columns: 300px 1fr; gap: 44px; align-items: center; }
    #an-{{ section.id }} .an-slab { position: relative; height: 60px; border-radius: 5px; transform: skewX(-22deg); box-shadow: 0 16px 28px rgba(0,0,0,0.12); }
    #an-{{ section.id }} .an-slab::after { content: ""; position: absolute; left: 0; right: 0; bottom: -10px; height: 11px; border-radius: 0 0 5px 5px; background: var(--edge); }
    #an-{{ section.id }} .an-num { display: inline-block; letter-spacing: 0.14em; font-size: 12px; opacity: 0.55; margin-bottom: 6px; }
    #an-{{ section.id }} .an-name { font-size: 20px; line-height: 1.25; margin: 0 0 6px; }
    #an-{{ section.id }} .an-desc { font-size: 15px; line-height: 1.5; opacity: 0.8; margin: 0; }
    @media (max-width: 749px) {
      #an-{{ section.id }} .an-title { font-size: 26px; }
      #an-{{ section.id }} .an-layer { grid-template-columns: 1fr; gap: 16px; }
      #an-{{ section.id }} .an-slab { height: 46px; max-width: 240px; }
    }
  {% endstyle %}

  <div id="an-{{ section.id }}" class="wide-container half-gutter section-spacing">
    {% if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.body != blank %}
      <div class="an-head" data-cc-animate>
        {% if section.settings.eyebrow != blank %}<div class="an-eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
        {% if section.settings.title != blank %}<h2 class="an-title">{{ section.settings.title | escape }}</h2>{% endif %}
        {% if section.settings.body != blank %}<div class="an-body rte">{{ section.settings.body }}</div>{% endif %}
      </div>
    {% endif %}

    <div class="an-stack">
      {% for block in section.blocks %}
        {%- assign c = block.settings.color -%}
        <div class="an-layer" {{ block.shopify_attributes }} data-cc-animate="cc-fade-in-up" data-cc-animate-delay="{{ forloop.index0 | times: 0.1 | append: 's' }}">
          <div class="an-slab" style="--edge: color-mix(in srgb, {{ c }} 62%, #000000); background: linear-gradient(180deg, color-mix(in srgb, {{ c }} 72%, #ffffff), {{ c }});"></div>
          <div class="an-cap">
            <span class="an-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {% if block.settings.name != blank %}<h3 class="an-name">{{ block.settings.name | escape }}</h3>{% endif %}
            {% if block.settings.desc != blank %}<p class="an-desc">{{ block.settings.desc | escape }}</p>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Fabric anatomy",
    "class": "section-anatomy-wrap",
    "max_blocks": 6,
    "settings": [
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Engineered in layers" },
      { "type": "text", "id": "title", "label": "Heading", "default": "The anatomy of MEDIFLEX" },
      { "type": "richtext", "id": "body", "label": "Intro text" },
      { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#F6F7F9" },
      { "type": "color", "id": "text_color", "label": "Text colour", "default": "#111111" }
    ],
    "blocks": [
      {
        "type": "layer",
        "name": "Layer",
        "settings": [
          { "type": "text", "id": "name", "label": "Layer name", "default": "Finishing layer" },
          { "type": "textarea", "id": "desc", "label": "Descriptor", "default": "Antimicrobial, easy-clean surface." },
          { "type": "color", "id": "color", "label": "Layer colour", "default": "#3E6BB0" }
        ]
      }
    ],
    "presets": [
      {
        "name": "Fabric anatomy",
        "blocks": [
          { "type": "layer", "settings": { "name": "Finishing layer", "desc": "Antimicrobial, easy-clean surface — bleach & alcohol safe.", "color": "#5E86C9" } },
          { "type": "layer", "settings": { "name": "Multilayer PVC coating", "desc": "Resists bodily fluids, lotions and stains.", "color": "#3E5C99" } },
          { "type": "layer", "settings": { "name": "Polyamide base", "desc": "Bi-elastic backing — flexes to any shape.", "color": "#2F4470" } }
        ]
      }
    ]
  }
{% endschema %}
