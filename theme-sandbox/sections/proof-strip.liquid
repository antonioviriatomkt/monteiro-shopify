{%- comment -%}
  Proof strip — one row of short credentials (icon · title · one line), house tokens of Showcase 7.0.
  Built 10/09/2026 for the ORGATEC 2026 page; reusable on any template. Items stay in one row on desktop
  (up to 6), two per row on tablet, stacked on mobile.
{%- endcomment -%}
{%- assign count = section.blocks.size -%}
<style>
  #proof-strip-{{ section.id }}{
    --ps-bg: {% if section.settings.alternate_bg_color %}#f5f5f5{% else %}#fff{% endif %};
    --ps-rule: #dbdbdb; --ps-text: #111; --ps-muted: #464654;
    background: var(--ps-bg); color: var(--ps-text);
    border-top: 1px solid var(--ps-rule); border-bottom: 1px solid var(--ps-rule);
    padding: {{ section.settings.padding }}px 0;
  }
  #proof-strip-{{ section.id }} .proof-strip__grid{ display:grid; grid-template-columns: repeat({{ count }}, minmax(0,1fr)); }
  #proof-strip-{{ section.id }} .proof-strip__item{ display:flex; gap:14px; align-items:flex-start; padding: 6px 24px 6px 0; min-width:0; }
  #proof-strip-{{ section.id }} .proof-strip__item + .proof-strip__item{ border-left:1px solid var(--ps-rule); padding-left:24px; }
  #proof-strip-{{ section.id }} .proof-strip__icon{ flex:none; width:22px; height:22px; margin-top:2px; stroke: var(--ps-muted); fill:none; stroke-width:1.4; stroke-linecap:round; stroke-linejoin:round; }
  #proof-strip-{{ section.id }} .proof-strip__title{ display:block; font-weight:600; font-size:16px; line-height:1.3; margin:0; text-align:left; color:var(--ps-text); }
  #proof-strip-{{ section.id }} .proof-strip__text{ display:block; font-size:14px; line-height:1.4; color: var(--ps-muted); margin:3px 0 0; }
  #proof-strip-{{ section.id }} .proof-strip__text p{ margin:0; }
  #proof-strip-{{ section.id }}.proof-strip--center .proof-strip__item{ flex-direction:column; align-items:center; text-align:center; gap:10px; }
  #proof-strip-{{ section.id }}.proof-strip--center .proof-strip__title{ text-align:center; }
  @media (max-width: 1023px){
    #proof-strip-{{ section.id }} .proof-strip__grid{ grid-template-columns: repeat(2, minmax(0,1fr)); row-gap: 8px; }
    #proof-strip-{{ section.id }} .proof-strip__item:nth-child(2n+1){ border-left:0; padding-left:0; }
    #proof-strip-{{ section.id }} .proof-strip__item:nth-child(n+3){ border-top:1px solid var(--ps-rule); padding-top:16px; }
  }
  @media (max-width: 767px){
    #proof-strip-{{ section.id }} .proof-strip__grid{ grid-template-columns: 1fr; row-gap:0; }
    #proof-strip-{{ section.id }} .proof-strip__item{ border-left:0 !important; padding-left:0 !important; padding-top:14px; padding-bottom:14px; }
    #proof-strip-{{ section.id }} .proof-strip__item + .proof-strip__item{ border-top:1px solid var(--ps-rule); }
  }
</style>

<div id="proof-strip-{{ section.id }}" class="proof-strip {% if section.settings.alignment == 'center' %}proof-strip--center{% endif %}" data-section-id="{{ section.id }}">
  <div class="container container--large">
    <div class="proof-strip__grid">
      {%- for block in section.blocks -%}
        <div class="proof-strip__item" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'award' -%}<svg class="proof-strip__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="5.5"/><path d="M8.5 13.5 7 21l5-2.5 5 2.5-1.5-7.5"/></svg>
            {%- when 'map_pin' -%}<svg class="proof-strip__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.5-6.5-11a6.5 6.5 0 0 1 13 0c0 5.5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
            {%- when 'shield' -%}<svg class="proof-strip__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
            {%- when 'calendar' -%}<svg class="proof-strip__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="1"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/></svg>
            {%- when 'leaf' -%}<svg class="proof-strip__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19c3-4 6-7 10-9"/></svg>
            {%- when 'check' -%}<svg class="proof-strip__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>
            {%- when 'star' -%}<svg class="proof-strip__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z"/></svg>
            {%- when 'truck' -%}<svg class="proof-strip__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
          {%- endcase -%}
          <div>
            {%- if block.settings.title != blank -%}<strong class="proof-strip__title">{{ block.settings.title | escape }}</strong>{%- endif -%}
            {%- if block.settings.text != blank -%}<span class="proof-strip__text">{{ block.settings.text }}</span>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Proof strip",
  "tag": "section",
  "class": "section-proof-strip",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "alignment", "label": "Item alignment", "default": "left",
      "options": [ { "value": "left", "label": "Icon beside text" }, { "value": "center", "label": "Icon above text, centred" } ] },
    { "type": "checkbox", "id": "alternate_bg_color", "label": "Use alternate section color", "default": false },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 60, "step": 4, "default": 24, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "award", "label": "Award" },
            { "value": "map_pin", "label": "Map pin" },
            { "value": "shield", "label": "Shield / certified" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "check", "label": "Check" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Truck" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Made in Portugal" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One short line.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "Proof strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "award", "title": "Coated fabrics since 1967", "text": "<p>Family-owned manufacturer, fourth generation.</p>" } },
        { "type": "item", "settings": { "icon": "map_pin", "title": "Made in Portugal", "text": "<p>Own facilities, European-only supplier base.</p>" } },
        { "type": "item", "settings": { "icon": "shield", "title": "ISO 9001 & ISO 14001", "text": "<p>Certified quality and environmental management.</p>" } },
        { "type": "item", "settings": { "icon": "calendar", "title": "10-year warranty", "text": "<p>The longest on the market, on stock-service materials.</p>" } }
      ] }
  ]
}
{% endschema %}
