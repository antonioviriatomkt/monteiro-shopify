{% comment %} Ads LP — closing CTA band (2026-10-29). Button jumps to #request and pre-selects "I need…". {% endcomment %}
{{ 'ads-lp.css' | asset_url | stylesheet_tag }}

<section class="ads-lp ads-lp-cta ads-lp__section ads-lp__section--dark">
  <div class="ads-lp__wrap">
    <div class="ads-lp-cta__inner">
      <h2 class="ads-lp__h2">{{ section.settings.heading | escape }}</h2>
      <div class="ads-lp__btns">
        <a class="ads-lp__btn" href="#request" data-ads-lp-need="{{ section.settings.need | escape }}" data-ads-lp-cta="final">{{ section.settings.button_label | escape }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ads LP — closing CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to the people who make the fabric." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request free samples" },
    { "type": "text", "id": "need", "label": "Pre-selects 'I need…'", "default": "Free samples" }
  ],
  "presets": [ { "name": "Ads LP — closing CTA" } ]
}
{% endschema %}
