{% comment %}
  Process timeline — an editorial "our process / journey" layout. A central
  connecting spine with numbered nodes; step cards alternate left/right on
  desktop and stack into a single column on mobile. Each step takes an optional
  circular image + a short caption. Built to replace flat numbered-circle grids
  with something more dynamic and on-brand.
{% endcomment %}

{%- assign accent = section.settings.accent_color -%}
{%- assign text_color = section.settings.text_color -%}

<div class="section-timeline" data-section-type="process-timeline" data-cc-animate
     style="background: {{ section.settings.bg_color }}; color: {{ text_color }};">
  {% style %}
    #tl-{{ section.id }} .tl-head { text-align: center; max-width: 720px; margin: 0 auto 56px; }
    #tl-{{ section.id }} .tl-eyebrow { letter-spacing: 0.1em; text-transform: uppercase; font-size: 13px; opacity: 0.7; margin-bottom: 12px; }
    #tl-{{ section.id }} .tl-title { font-size: 34px; font-weight: 400; line-height: 1.2; margin: 0; color: {{ text_color }}; }
    #tl-{{ section.id }} .tl { position: relative; max-width: 900px; margin: 0 auto; }
    #tl-{{ section.id }} .tl::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; background: {{ accent }}; opacity: 0.25; transform: translateX(-50%); }
    #tl-{{ section.id }} .tl-step { position: relative; display: grid; grid-template-columns: 1fr 88px 1fr; align-items: center; margin-bottom: 40px; }
    #tl-{{ section.id }} .tl-step:last-child { margin-bottom: 0; }
    #tl-{{ section.id }} .tl-node { grid-column: 2; justify-self: center; width: 52px; height: 52px; border-radius: 50%; background: {{ accent }}; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 500; z-index: 1; box-shadow: 0 0 0 6px {{ section.settings.bg_color }}; }
    #tl-{{ section.id }} .tl-card { display: flex; flex-direction: column; gap: 14px; }
    #tl-{{ section.id }} .tl-step.left .tl-card { grid-column: 1; align-items: flex-end; text-align: right; }
    #tl-{{ section.id }} .tl-step.right .tl-card { grid-column: 3; align-items: flex-start; text-align: left; }
    #tl-{{ section.id }} .tl-thumb { width: 132px; height: 132px; border-radius: 50%; object-fit: cover; display: block; }
    #tl-{{ section.id }} .tl-caption { font-size: 17px; line-height: 1.45; max-width: 280px; margin: 0; }
    @media (max-width: 749px) {
      #tl-{{ section.id }} .tl-title { font-size: 26px; }
      #tl-{{ section.id }} .tl::before { left: 26px; }
      #tl-{{ section.id }} .tl-step { grid-template-columns: 52px 1fr; gap: 18px; align-items: flex-start; margin-bottom: 32px; }
      #tl-{{ section.id }} .tl-node { grid-column: 1; width: 52px; }
      #tl-{{ section.id }} .tl-step.left .tl-card,
      #tl-{{ section.id }} .tl-step.right .tl-card { grid-column: 2; align-items: flex-start; text-align: left; }
      #tl-{{ section.id }} .tl-thumb { width: 96px; height: 96px; }
    }
  {% endstyle %}

  <div id="tl-{{ section.id }}" class="wide-container half-gutter section-spacing">
    {% if section.settings.eyebrow != blank or section.settings.title != blank %}
      <div class="tl-head" data-cc-animate>
        {% if section.settings.eyebrow != blank %}<div class="tl-eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
        {% if section.settings.title != blank %}<h2 class="tl-title">{{ section.settings.title | escape }}</h2>{% endif %}
      </div>
    {% endif %}

    <div class="tl">
      {% for block in section.blocks %}
        {%- assign side_mod = forloop.index0 | modulo: 2 -%}
        {%- if side_mod == 0 -%}{%- assign side = 'left' -%}{%- else -%}{%- assign side = 'right' -%}{%- endif -%}
        <div class="tl-step {{ side }}" {{ block.shopify_attributes }} data-cc-animate="cc-fade-in-up" data-cc-animate-delay="{{ forloop.index0 | times: 0.06 | append: 's' }}">
          <div class="tl-node">{{ forloop.index }}</div>
          <div class="tl-card">
            {% if block.settings.image %}
              <img class="tl-thumb" src="{{ block.settings.image | image_url: width: 320 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="132" height="132">
            {% endif %}
            {% if block.settings.title != blank %}<p class="tl-caption">{{ block.settings.title }}</p>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Process timeline",
    "class": "section-timeline-wrap",
    "max_blocks": 12,
    "settings": [
      {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow",
        "default": "From chestnut to fabric"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "How Peel is made"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Accent (spine + nodes)",
        "default": "#2F519B"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text colour",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background colour",
        "default": "#FFFFFF"
      }
    ],
    "blocks": [
      {
        "type": "step",
        "name": "Step",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Caption"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Process timeline",
        "blocks": [
          { "type": "step" },
          { "type": "step" },
          { "type": "step" },
          { "type": "step" }
        ]
      }
    ]
  }
{% endschema %}
