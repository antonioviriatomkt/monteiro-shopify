{% comment %}
  Ads LP — hero (2026-10-29). H1 + text + two CTAs that jump to the request form (#request) and
  pre-select "I need…" via data-ads-lp-need, image on the right, proof strip underneath.
  Family: sections/ads-lp-*.liquid + assets/ads-lp.css, used only by templates/page.ads-lp-*.json.
{% endcomment %}
{{ 'ads-lp.css' | asset_url | stylesheet_tag }}

<section class="ads-lp ads-lp-hero" id="ads-lp-hero-{{ section.id }}">
  <div class="ads-lp__wrap">
    <div class="ads-lp-hero__grid">
      <div>
        {% if section.settings.eyebrow != blank %}<div class="ads-lp__eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
        <h1 class="ads-lp-hero__title">{{ section.settings.heading | escape }}</h1>
        {% if section.settings.text != blank %}<div class="ads-lp-hero__text">{{ section.settings.text }}</div>{% endif %}
        <div class="ads-lp__btns">
          {% if section.settings.primary_label != blank %}
            <a class="ads-lp__btn" href="#request" data-ads-lp-need="{{ section.settings.primary_need | escape }}" data-ads-lp-cta="hero_primary">{{ section.settings.primary_label | escape }}</a>
          {% endif %}
          {% if section.settings.secondary_label != blank %}
            <a class="ads-lp__btn ads-lp__btn--ghost" href="#request" data-ads-lp-need="{{ section.settings.secondary_need | escape }}" data-ads-lp-cta="hero_secondary">{{ section.settings.secondary_label | escape }}</a>
          {% endif %}
        </div>
      </div>
      {% if section.settings.image != blank %}
        <div class="ads-lp-hero__media">
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 760px) 100vw, 50vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
        </div>
      {% elsif section.settings.placeholder != blank %}
        <div class="ads-lp-hero__media ads-lp-hero__media--empty"><span>{{ section.settings.placeholder | escape }}</span></div>
      {% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="ads-lp-proof">
      <div class="ads-lp__wrap">
        <ul class="ads-lp-proof__list">
          {% for block in section.blocks %}
            <li class="ads-lp-proof__item" {{ block.shopify_attributes }}>
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9.5l4 4L15 5" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {% endfor %}
        </ul>
        {% if section.settings.footnote != blank %}<p class="ads-lp-proof__note">{{ section.settings.footnote | escape }}</p>{% endif %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Ads LP — hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "H1 (main keyword)", "default": "Upholstery fabric manufacturer" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder", "label": "Text shown when there is no image" },
    { "type": "header", "content": "Buttons (both jump to the request form)" },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Request free samples" },
    { "type": "text", "id": "primary_need", "label": "Primary — pre-selects 'I need…'", "default": "Free samples" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Talk to a specialist" },
    { "type": "text", "id": "secondary_need", "label": "Secondary — pre-selects 'I need…'", "default": "To talk to a specialist" },
    { "type": "text", "id": "footnote", "label": "Proof strip footnote" }
  ],
  "blocks": [
    { "type": "proof", "name": "Proof point", "limit": 6, "settings": [ { "type": "text", "id": "text", "label": "Text" } ] }
  ],
  "presets": [ { "name": "Ads LP — hero" } ]
}
{% endschema %}
