    "1633681707d0a1c902": {
      "type": "accordions",
      "blocks": {
        "accordion_qytQpM": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Can I request fabric samples?",
            "text": "<p>Yes. You can request up to 10 different samples in a single order, free of charge, using your company email account. Just browse the collection product pages and add the samples you'd like to your cart.</p>",
            "open": false
          }
        },
        "accordion_TgTbHE": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "How do I ask for a physical catalogue?",
            "text": "<p>Physical catalogues can be ordered straight from each collection's product page. Scroll past the colour variants to find the catalogue option, add it to your cart, and complete checkout — we'll ship it to you.</p>",
            "open": false
          }
        },
        "accordion_rCryNi": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Are samples available for all collections?",
            "text": "<p>Yes — samples are available for every collection in our range, so you can check colour, texture, and quality before placing an order.</p>",
            "open": false
          }
        },
        "1633681707d0a1c902-0": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Is there a limit to the number of samples I can request?",
            "text": "<p>Yes. You can request up to 10 individual samples per order. If you're working on a larger project and need more, contact our team <a href=\"https://www.monteirofabrics.com/pages/contact\" target=\"_blank\" title=\"https://www.monteirofabrics.com/pages/contact\">here</a> and we'll be happy to help.</p>",
            "open": false
          }
        },
        "1633681707d0a1c902-1": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "How long does sample delivery take?",
            "text": "<p>Delivery times depend on the item: stock-service samples typically arrive within 2–5 days, while tailormade articles can take up to 4–5 weeks.</p>",
            "open": false
          }
        },
        "1633681707d0a1c902-2": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Can I request samples for a specific project or mood board?",
            "text": "<p>Absolutely. Browse our collection product pages to choose samples yourself, or contact our specialists <a href=\"https://www.monteirofabrics.com/pages/contact\" target=\"_blank\" title=\"https://www.monteirofabrics.com/pages/contact\">here</a> — share your project or mood board and we'll recommend fabrics to match.</p>",
            "open": false
          }
        }
