      "blocks": {
        "16336816691fb51b7b-0": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "How can I place an order?",
            "text": "<p>To place an order, simply get in touch with our sales team <a href=\"https://www.monteirofabrics.com/pages/contact\" target=\"_blank\" title=\"https://www.monteirofabrics.com/pages/contact\">here</a>. Let us know the fabric references, colours, and quantities you need, and we'll guide you through the rest — from quotation to delivery.</p>",
            "open": false
          }
        },
        "16336816691fb51b7b-2": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Can I order directly online?",
            "text": "<p>Orders aren't placed directly through the website — they're handled personally by our sales team <a href=\"https://www.monteirofabrics.com/pages/contact\" target=\"_blank\" title=\"https://www.monteirofabrics.com/pages/contact\">here</a>, so you get the right fabric, quantity, and lead time for your project. You can, however, order samples online and download catalogues and technical files for every collection.</p>",
            "open": false
          }
        },
        "16336816691fb51b7b-1": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Can I request a proforma invoice?",
            "text": "<p>Yes — we can issue a proforma invoice on request. Just let our sales team know when you enquire and we'll prepare one for you.</p>",
            "open": false
          }
        },
        "accordion_QTidCM": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Is there a minimum order quantity?",
            "text": "<p>Yes. The minimum order is one roll for stock-service items, and 300 linear metres for tailormade articles.</p>",
            "open": false
          }
        }
      },
      "block_order": [
