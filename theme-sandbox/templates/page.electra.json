      "settings": {
        "subheading": "Engineered for static-sensitive clinical environments",
        "title": "The only healthcare fabric that is permanently antistatic",
        "title_size": 40,
        "title_width": 34,
        "heading_h1": false,
        "text": "<p>Discover the <strong>Electra collection</strong> from Monteiro Fabrics, a groundbreaking antistatic healthcare upholstery line that blends cutting-edge safety with heartfelt design for healthcare heroes. Feel the quiet confidence of spaces where every detail protects—patients, staff, and equipment alike.</p>",
        "image_width": 120,
        "button_label": "DOWNLOAD CATALOGUE",
