      "blocks": {
        "faq_0": {
          "type": "qa",
          "settings": {
            "question": "Are you a manufacturer or a distributor?",
            "answer": "<p>Manufacturer. We have been making coated upholstery fabrics in Porto, Portugal, since 1967.</p>"
          }
        },
        "faq_1": {
          "type": "qa",
          "settings": {
            "question": "How do you sell?",
            "answer": "<p>By the roll, to trade buyers only. Stock-service fabrics are available from a single roll, and CHANCE Classic is ready to ship from stock in 48 hours.</p>"
          }
        },
        "faq_2": {
          "type": "qa",
          "settings": {
            "question": "Which certifications do your fabrics have?",
            "answer": "<p>Certification depends on the collection: EN 1021, BS 5852 Crib 5, IMO 2010 FTP Code Part 8 and others. Each collection lists its standards, and we send the test reports on request.</p>"
          }
        },
        "faq_3": {
          "type": "qa",
          "settings": {
            "question": "Are samples really free?",
            "answer": "<p>Yes — samples of every collection are free.</p>"
          }
        },
        "faq_4": {
          "type": "qa",
          "settings": {
            "question": "Can you match a colour or develop a fabric for our project?",
            "answer": "<p>Yes. We offer colour matching and tailor-made development.</p>"
          }
        }
      },
