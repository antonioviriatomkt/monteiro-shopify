    "edc35c5e-389f-4cb2-80ce-0189359e589b": {
      "type": "rich-text",
      "settings": {
        "subheading": "",
        "title": "Monteiro Fabrics proudly represents Portugal and showcases Coated Fabrics with 65% BIO-based material in Cologne, Germany!",
        "title_size": 36,
        "title_width": 40,
        "heading_h1": false,
        "text": "<p>Gisela Ferreira, our R&D and Technical Manager, was a speaker at the 15th edition of <a href=\"https://www.ami-events.com/event/2fd605e8-2f69-47a4-bb2e-448b9682ee7f/summary\" title=\"https://www.ami-events.com/event/2fd605e8-2f69-47a4-bb2e-448b9682ee7f/summary\">PVC Formulation</a>, which took place from September 12 to 14, 2023, in Germany.</p>",
        "image": "shopify://shop_images/logo-png-1-monteiro-fabrics.jpg",
        "image_width": 120,
        "button_label": "",
        "button_link": "",
        "button_style": "auto",
        "text_alignment": "center",
        "enlarge_text": true,
        "full_width": false,
