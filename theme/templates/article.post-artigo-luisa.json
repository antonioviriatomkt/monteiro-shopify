        "title_size": 36,
        "title_width": 40,
        "heading_h1": false,
        "text": "<p>Imagine If Every Hotel Chose PEEL</p>",
        "image": "shopify://shop_images/logo-png-1-monteiro-fabrics.jpg",
        "image_width": 120,
        "button_label": "",
        "button_link": "",
        "button_style": "auto",
