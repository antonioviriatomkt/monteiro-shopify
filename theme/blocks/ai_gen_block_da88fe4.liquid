{% doc %}
  @prompt
    Um CTA para convidar visitantes a subscrevem à newsletter, Contém um erro: "Liquid error (temp/ai_gen_block_9c0ffd2 line 142): Invalid form type "atlbfme5ennzhwktosaigenblock9c0ffd2enb66g", must be one of ["product", "storefront_password", "contact", "customer_login", "create_customer", "recover_customer_password", "reset_customer_password", "guest_login", "currency", "activate_customer_password", "customer_address", "new_comment", "customer", "localization", "cart"]"
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-newsletter-cta-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-newsletter-cta__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-newsletter-cta__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-weight: 600;
  }

  .ai-newsletter-cta__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: 1.5;
  }

  .ai-newsletter-cta__form-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.text_alignment }};
  }

  .ai-newsletter-cta__form-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.form_width }}px;
  }

  .ai-newsletter-cta__field-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.field_gap }}px;
    flex-direction: {{ block.settings.layout }};
  }

  .ai-newsletter-cta__input-{{ ai_gen_id }} {
    flex-grow: 1;
    padding: {{ block.settings.input_padding }}px {{ block.settings.input_padding | times: 1.5 }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
    font-size: {{ block.settings.input_font_size }}px;
  }

  .ai-newsletter-cta__input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
    opacity: 0.7;
  }

  .ai-newsletter-cta__input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-newsletter-cta__button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 2 }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    white-space: nowrap;
    {% if block.settings.layout == 'column' %}
      width: 100%;
    {% endif %}
  }

  .ai-newsletter-cta__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-newsletter-cta__message-{{ ai_gen_id }} {
    margin-top: {{ block.settings.field_gap }}px;
    font-size: {{ block.settings.text_size | minus: 2 }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-newsletter-cta__success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
  }

  .ai-newsletter-cta__error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-newsletter-cta__field-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-newsletter-cta__button-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-newsletter-cta__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-newsletter-cta__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<newsletter-cta-{{ ai_gen_id }}
  class="ai-newsletter-cta-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-newsletter-cta__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-newsletter-cta__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="ai-newsletter-cta__text-{{ ai_gen_id }}">
        {{ block.settings.text }}
      </div>
    {% endif %}

    <div class="ai-newsletter-cta__form-wrapper-{{ ai_gen_id }}">
      {% form 'customer' %}
        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter"
        >
        <div class="ai-newsletter-cta__field-wrapper-{{ ai_gen_id }}">
          <input
            type="email"
            name="contact[email]"
            class="ai-newsletter-cta__input-{{ ai_gen_id }}"
            value="{{ form.email }}"
            placeholder="{{ block.settings.email_placeholder }}"
            aria-label="{{ block.settings.email_placeholder }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-newsletter-cta-error-{{ ai_gen_id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="ai-newsletter-cta-success-{{ ai_gen_id }}"
            {% endif %}
            required
          >
          <button
            type="submit"
            class="ai-newsletter-cta__button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </button>
        </div>

        <div class="ai-newsletter-cta__message-{{ ai_gen_id }}">
          {% if form.errors %}
            <div
              id="ai-newsletter-cta-error-{{ ai_gen_id }}"
              class="ai-newsletter-cta__error-{{ ai_gen_id }}"
            >
              {{ form.errors.messages.email }}
            </div>
          {% elsif form.posted_successfully? %}
            <div
              id="ai-newsletter-cta-success-{{ ai_gen_id }}"
              class="ai-newsletter-cta__success-{{ ai_gen_id }}"
            >
              {{ block.settings.success_message }}
            </div>
          {% endif %}
        </div>
      {% endform %}
    </div>
  </div>
</newsletter-cta-{{ ai_gen_id }}>

<script>
  (function() {
    class NewsletterCta{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        if (form) {
          form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const emailInput = this.querySelector('.ai-newsletter-cta__input-{{ ai_gen_id }}');
        if (emailInput && !emailInput.value.trim()) {
          event.preventDefault();
          emailInput.focus();
        }
      }
    }

    customElements.define('newsletter-cta-{{ ai_gen_id }}', NewsletterCta{{ ai_gen_id }});
  })();
</script>

