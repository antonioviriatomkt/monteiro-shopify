{%- comment -%}
  JSON-LD for the blog listing page: Blog + an ItemList of the visible
  articles + a BreadcrumbList. Emitted from sections/main-blog.
  June 2026 redesign.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": {{ shop.url | append: blog.url | append: '#blog' | json }},
      "url": {{ shop.url | append: blog.url | json }},
      "name": {{ blog.title | json }},
      "description": {{ page_description | default: blog.title | json }},
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}
      },
      "blogPost": [
        {%- for article in blog.articles limit: 12 -%}
        {
          "@type": "BlogPosting",
          "headline": {{ article.title | json }},
          "url": {{ shop.url | append: article.url | json }},
          {%- if article.image -%}
          "image": {{ article.image | img_url: '1024x' | prepend: "https:" | json }},
          {%- endif -%}
          {%- if article.excerpt_or_content != blank -%}
          "description": {{ article.excerpt_or_content | strip_html | truncate: 200 | json }},
          {%- endif -%}
          "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
          "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
          "author": {
            "@type": "Organization",
            "name": {{ shop.name | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": {{ shop.url | append: blog.url | json }}
        }
      ]
    }
  ]
}
</script>
