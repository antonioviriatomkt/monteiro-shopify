{%- liquid
  assign columns = 4

  if columns == 2
    assign article_class = 'column half'
  elsif columns == 3
    assign article_class = 'column third'
  else
    assign article_class = 'column quarter'
  endif

  assign show_blog_filters = false
  if blog.all_tags.size > 0 and section.settings.blog_show_filter
    assign show_blog_filters = true
  endif

  assign excerpt_mode = section.settings.blog_excerpt | default: 'below'

  comment
    Card thumbnail crop. Defaults to the global Theme settings > Blog "Image shape",
    but can be overridden per blog here. Only takes effect in the Grid layout.
  endcomment
  assign card_shape = section.settings.card_image_shape
  if card_shape == blank or card_shape == 'theme_default'
    assign card_shape = settings.blog_image_shape
  endif

  assign is_filtered = false
  if current_tags.size > 0
    assign is_filtered = true
  endif
-%}

<div data-section-type="blog-template" class="{% if section.settings.blog_show_title == false %}sm:pt-medium pb-medium{% else %}py-medium{% endif %}">
  {% if section.settings.blog_show_title %}
    <div class="central align-center">
      <h1 class="feature-header" data-cc-animate>
        <span>
          {{ blog.title }}

          {% if show_blog_filters == false and section.settings.blog_show_rss_link %}
            <a class="rsslink {% if section.settings.blog_show_filter == false or blog.all_tags.size == 0 %}no-filter{% endif %}"
               href="{{ blog.url }}.atom" title="{{ blog.title | escape }} RSS" aria-label="{{ blog.title | escape }} RSS">
              {% render 'svg-rss' %}
            </a>
          {% endif %}
          </span>
      </h1>
    </div>
  {% endif %}

  {% if section.settings.intro_text != blank %}
    <div class="central align-center blog-intro rte" data-cc-animate data-cc-animate-delay="0.1s">
      {{ section.settings.intro_text }}
    </div>
  {% endif %}

  {% paginate blog.articles by section.settings.blog_posts_per_page %}
    <div class="wide-container half-gutter">
      {% if show_blog_filters %}
        <nav class="blog-chips" aria-label="{{ 'blogs.filtering.filter' | t | escape }}" data-cc-animate data-cc-animate-delay="0.2s">
          <a class="blog-chip {% unless is_filtered %}is-active{% endunless %}" href="{{ blog.url }}">{{ 'blogs.filtering.all' | t }}</a>
          {% for tag in blog.all_tags %}
            <a class="blog-chip {% if current_tags contains tag %}is-active{% endif %}"
               href="{{ blog.url }}/tagged/{{ tag | handle }}"
               {% if current_tags contains tag %}aria-current="true"{% endif %}>{{ tag | capitalize }}</a>
          {% endfor %}
          {% if section.settings.blog_show_rss_link %}
            <a class="rsslink blog-chip blog-chip--rss" href="{{ blog.url }}.atom" title="{{ blog.title | escape }} RSS" aria-label="{{ blog.title | escape }} RSS">
              {% render 'svg-rss' %}
            </a>
          {% endif %}
        </nav>
      {% endif %}

      <div class="product-list-container">
        <div class="cc-articles product-list grid--uniform{% if section.settings.blog_posts_per_row_mobile == '2' %} mob-two-col{% endif %} product-list--{{ section.settings.blog_layout }}{% if section.settings.featured_first and is_filtered == false and paginate.current_page == 1 %} has-featured{% endif %}">
          {% for article in blog.articles %}
            {%- liquid
              assign is_featured = false
              if section.settings.featured_first and is_filtered == false and paginate.current_page == 1 and forloop.first
                assign is_featured = true
              endif
            -%}
            <div class="{{ article_class }} article-column{% if is_featured %} article-column--featured{% endif %}">
              {% render 'article-block',
                  article: article,
                  show_date: settings.blog_show_date,
                  show_author: settings.blog_show_author,
                  image_shape: card_shape,
                  blog_excerpt: excerpt_mode,
                  show_category: section.settings.show_category,
                  show_readtime: section.settings.show_readtime,
                  index: forloop.index0
              %}
            </div>
          {% else %}
            <p class="align-centre"><em>{{ 'blogs.general.no_matches' | t }}</em></p>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="pagination central content" data-cc-animate>
            {% comment %}
            When paginating blog articles, a previous article is actually a newer article, not an older one,
            because blog articles are shown and paginated in a reversed chronological order.
            The word 'previous' can be confusing, hence we'll change it.
            {% endcomment %}
            {% assign older_articles = 'blogs.pagination.older_articles' | t %}
            {% assign newer_articles = 'blogs.pagination.newer_articles' | t %}
            {{ paginate | default_pagination | replace: 'Previous', newer_articles | replace: 'Next', older_articles }}
          </div>
        {% endif %}
      </div>
    </div>
  {% endpaginate %}
</div>

{% render 'structured-data-blog', blog: blog %}


{% schema %}
  {
    "name": "Blog pages",
    "settings": [
      {
        "type": "select",
        "id": "blog_layout",
        "label": "Layout",
        "options": [
          {
            "value": "collage",
            "label": "Collage"
          },
          {
            "value": "rows",
            "label": "Grid"
          }
        ],
        "default": "collage",
        "info": "Collage applies to larger screens only"
      },
      {
        "type": "select",
        "id": "card_image_shape",
        "label": "Card image shape",
        "info": "Applies in the Grid layout. 'Theme default' uses Theme settings > Blog > Image shape.",
        "options": [
          { "value": "theme_default", "label": "Theme default" },
          { "value": "natural", "label": "Natural" },
          { "value": "landscape", "label": "Landscape (3:2)" },
          { "value": "square", "label": "Square (1:1)" },
          { "value": "portrait", "label": "Portrait (2:3)" },
          { "value": "portrait_tall", "label": "Portrait (4:5)" }
        ],
        "default": "theme_default"
      },
      {
        "type": "select",
        "id": "blog_excerpt",
        "label": "Card excerpt",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "below", "label": "Below title" },
          { "value": "hover", "label": "On hover (overlay)" }
        ],
        "default": "below"
      },
      {
        "type": "checkbox",
        "id": "show_category",
        "label": "Show category pill",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_readtime",
        "label": "Show read time",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "featured_first",
        "label": "Feature the latest post",
        "info": "Shows the newest article as a large card on page 1 (unfiltered).",
        "default": true
      },
      {
        "type": "richtext",
        "id": "intro_text",
        "label": "Intro text",
        "info": "Optional sentence shown under the page title."
      },
      {
        "type": "range",
        "id": "blog_posts_per_page",
        "label": "Posts per page",
        "min": 6,
        "max": 24,
        "step": 1,
        "default": 12
      },
      {
        "type": "select",
        "id": "blog_posts_per_row_mobile",
        "label": "Posts per row on mobile",
        "options": [
          {
            "value": "1",
            "label": "1"
          },
          {
            "value": "2",
            "label": "2"
          }
        ],
        "default": "2"
      },
      {
        "type": "checkbox",
        "id": "blog_show_title",
        "label": "Show page title",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "blog_show_filter",
        "label": "Show tag filter",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "blog_show_rss_link",
        "label": "Show RSS link",
        "default": false
      }
    ]
  }
{% endschema %}
