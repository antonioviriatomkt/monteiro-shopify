{% comment %}
  Value props — a centred row of differentiator "stat + caption" items.
  Reusable: used on the homepage for the key differentiators bar AND for the
  certifications strip. Matches the base theme (wide-container, section-spacing,
  feature-subheader, .h2). Accent colour defaults to the Monteiro red.
{% endcomment %}

<div class="wide-container half-gutter section-spacing {% if section.settings.alternate_bg_color %}use-alt-bg{% endif %}" data-section-type="value-props" data-cc-animate>
  {% style %}
    #vp-{{ section.id }} .vp-head { text-align: center; margin-bottom: 36px; }
    #vp-{{ section.id }} .vp-head .feature-subheader { color: {{ section.settings.accent_color }}; }
    #vp-{{ section.id }} .vp-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px 16px; }
    #vp-{{ section.id }} .vp-item { flex: 1 1 150px; max-width: 220px; text-align: center; }
    #vp-{{ section.id }} .vp-value { font-size: 34px; line-height: 1.1; font-weight: 400; color: {{ section.settings.accent_color }}; }
    #vp-{{ section.id }} .vp-caption { margin-top: 8px; font-size: 14px; line-height: 1.4; letter-spacing: 0.02em; }
    #vp-{{ section.id }} .vp-item.has-divider { border-left: 1px solid rgba(0,0,0,0.10); }
    @media (max-width: 767px) {
      #vp-{{ section.id }} .vp-head { text-align: left; }
      #vp-{{ section.id }} .vp-row { justify-content: flex-start; }
      #vp-{{ section.id }} .vp-item { flex-basis: 40%; text-align: left; }
      #vp-{{ section.id }} .vp-item.has-divider { border-left: 0; }
      #vp-{{ section.id }} .vp-value { font-size: 26px; }
    }
  {% endstyle %}

  <div id="vp-{{ section.id }}">
    {% if section.settings.subheading != blank or section.settings.title != blank %}
      <div class="vp-head" data-cc-animate>
        {% if section.settings.subheading != blank %}
          <div class="feature-subheader">{{ section.settings.subheading | escape }}</div>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="h2">{{ section.settings.title | escape }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="vp-row">
      {% for block in section.blocks %}
        <div class="vp-item {% unless forloop.first %}{% if section.settings.show_dividers %}has-divider{% endif %}{% endunless %}"
             {{ block.shopify_attributes }}
             data-cc-animate="cc-fade-in-up"
             data-cc-animate-delay="{{ forloop.index0 | times: 0.08 | append: 's' }}">
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" style="text-decoration:none;color:inherit;display:block;">{% endif %}
            <div class="vp-value">{{ block.settings.value | escape }}</div>
            <div class="vp-caption">{{ block.settings.caption | escape }}</div>
          {% if block.settings.link != blank %}</a>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Value props",
    "class": "section-value-props",
    "max_blocks": 6,
    "settings": [
      {
        "type": "text",
        "id": "subheading",
        "label": "Eyebrow",
        "default": "Why specifiers choose Monteiro"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Accent colour",
        "default": "#111111"
      },
      {
        "type": "checkbox",
        "id": "show_dividers",
        "label": "Show dividers between items",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "alternate_bg_color",
        "label": "Use alternate section color",
        "default": false
      }
    ],
    "blocks": [
      {
        "type": "item",
        "name": "Value",
        "settings": [
          {
            "type": "text",
            "id": "value",
            "label": "Value (large)",
            "default": "10-year"
          },
          {
            "type": "text",
            "id": "caption",
            "label": "Caption",
            "default": "warranty — longest on the market"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link (optional)"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Value props",
        "blocks": [
          { "type": "item" },
          { "type": "item" },
          { "type": "item" },
          { "type": "item" }
        ]
      }
    ]
  }
{% endschema %}
