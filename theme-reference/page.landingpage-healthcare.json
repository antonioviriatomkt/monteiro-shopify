    "custom_liquid_NUPpwP": {
      "type": "custom-liquid",
      "name": "Custom Liquid/HTML",
      "settings": {
        "no_margins": false,
        "custom_liquid": "<!-- Mediflex modal -->\n<div id=\"modal-tf-mediflex\" class=\"mf-modal\" hidden role=\"dialog\" aria-labelledby=\"modal-tf-mediflex-title\">\n  <div class=\"mf-modal__overlay\" data-mf-close-modal></div>\n  <div class=\"mf-modal__content\">\n    <button type=\"button\" class=\"mf-modal__close\" data-mf-close-modal aria-label=\"Close\">×</button>\n    <h3 id=\"modal-tf-mediflex-title\">Mediflex — Technical File</h3>\n    <p>Enter your details and we'll send the PDF to your inbox.</p>\n    <div class=\"sender-form-field\" data-sender-form-id=\"eXDvAg\"></div>\n  </div>\n</div>\n\n<!-- Electra modal -->\n<div id=\"modal-tf-electra\" class=\"mf-modal\" hidden role=\"dialog\" aria-labelledby=\"modal-tf-electra-title\">\n  <div class=\"mf-modal__overlay\" data-mf-close-modal></div>\n  <div class=\"mf-modal__content\">\n    <button type=\"button\" class=\"mf-modal__close\" data-mf-close-modal aria-label=\"Close\">×</button>\n    <h3 id=\"modal-tf-electra-title\">Electra — Technical File</h3>\n    <p>Enter your details and we'll send the PDF to your inbox.</p>\n    <div class=\"sender-form-field\" data-sender-form-id=b2kPAz></div>\n  </div>\n</div>\n\n<!-- Modal styling -->\n<style>\n  .mf-modal[hidden]{display:none}\n  .mf-modal{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px}\n  .mf-modal__overlay{position:absolute;inset:0;background:rgba(0,0,0,0.6);cursor:pointer}\n  .mf-modal__content{position:relative;background:#fff;border-radius:8px;max-width:480px;width:100%;max-height:90vh;overflow-y:auto;padding:32px;box-shadow:0 20px 60px rgba(0,0,0,0.3)}\n  .mf-modal__close{position:absolute;top:12px;right:12px;background:transparent;border:0;font-size:28px;line-height:1;cursor:pointer;color:#666;padding:4px 12px}\n  .mf-modal__close:hover{color:#000}\n  .mf-modal__content h3{margin:0 0 8px;font-size:20px}\n  .mf-modal__content p{margin:0 0 20px;color:#555;font-size:14px}\n  body.mf-modal-open{overflow:hidden}\n</style>\n\n<!-- Controller: intercepts existing \"DOWNLOAD TECHNICAL FILE\" buttons, routes by section heading -->\n<script>\n(function(){\n  function init(){\n    var ctas = Array.from(document.querySelectorAll('a, button, .button-custom, [role=\"button\"]')).filter(function(el){\n      return el.textContent.trim().toUpperCase() === 'DOWNLOAD TECHNICAL FILE';\n    });\n\n    ctas.forEach(function(btn){\n      // Find the nearest ancestor that contains a heading naming the collection\n      var node = btn;\n      var collection = null;\n      while (node && node !== document.body){\n        var heading = node.querySelector && node.querySelector('h1,h2,h3,h4');\n        if (heading){\n          var txt = heading.textContent.toUpperCase();\n          if (txt.indexOf('MEDIFLEX') !== -1){ collection = 'mediflex'; break; }\n          if (txt.indexOf('ELECTRA') !== -1){ collection = 'electra'; break; }\n        }\n        node = node.parentElement;\n      }\n      if (!collection) return; // safeguard\n\n      // Mark the button for GTM + intercept the click\n      btn.setAttribute('data-cta', 'download_tf_' + collection);\n      btn.setAttribute('data-mf-open-modal', 'tf-' + collection);\n\n      btn.addEventListener('click', function(e){\n        e.preventDefault();\n        var modal = document.getElementById('modal-tf-' + collection);\n        if (modal){\n          modal.hidden = false;\n          document.body.classList.add('mf-modal-open');\n        }\n      });\n    });\n\n    // Generic close handlers (overlay or × button)\n    document.addEventListener('click', function(e){\n      var closer = e.target.closest('[data-mf-close-modal]');\n      if (closer){\n        var modal = closer.closest('.mf-modal');\n        if (modal){\n          modal.hidden = true;\n          document.body.classList.remove('mf-modal-open');\n        }\n      }\n    });\n\n    // ESC key closes\n    document.addEventListener('keydown', function(e){\n      if (e.key === 'Escape'){\n        document.querySelectorAll('.mf-modal:not([hidden])').forEach(function(m){ m.hidden = true; });\n        document.body.classList.remove('mf-modal-open');\n      }\n    });\n  }\n\n  if (document.readyState === 'loading'){\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n</script>"
      }
    }
